<     use frames.{frame-origin};
< 
<     // FrameKindLabel (log_recall.rs:44-91): 30 variants, `#[non_exhaustive]`.
<     // Deliberately NOT `frames.frame-kind` (17 routed kinds): recall reads the
<     // audit log, whose label set is wider. A WIT enum is closed, so a new label
<     // is a type change for every importer — Q5 measures what that costs.
<     enum frame-kind-label {
<         task-assign,
<         task-complete,
<         decision-dispatch,
<         epistemic-halt,
<         telemetry-event,
<         consent-request,
<         retract,
<         capability-invocation,
<         sandbox-block,
<         inference-call,
<         decision,
<         distillate,
<         budget-warning,
<         budget-exceeded,
<         hot-swap-aborted,
<         task-stalled,
<         silent-failure-suspect,
<         spirit-revoked,
<         mcp-invocation,
<         spirit-admitted,
<         registry-yank,
<         cli-subprocess-output,
<         consent-rupture,
<         rate-limited,
<         gateway-inbound,
<         gateway-outbound,
<         spirit-imported,
<         cli-wrapper-shape-mismatch,
<         governance-event,
<         cost-attribution,
<     }
< 
<     // LogRecallCursor (log_recall.rs:175-180).
<     record recall-cursor {
<         last-timestamp-ns: u64,
<         last-frame-id: list<u8>,        // [u8; 16]
<     }
< 
<     // LogRecallFilter (log_recall.rs:14-38); `limit` is clamped host-side to
<     // LogRecallFilter::MAX_LIMIT = 1024 (:95, :98-115).
<     record recall-filter {
<         kind: option<frame-kind-label>,
<         since-ns: option<u64>,
<         until-ns: option<u64>,
<         limit: u32,
<         cursor: option<recall-cursor>,
<         intent-filter: option<string>,
<     }
< 
<     // LogRecallEntry (log_recall.rs:213-226) — no payload; `fetch` for that.
<     record recall-entry {
<         frame-id: list<u8>,             // [u8; 16]
<         timestamp-ns: u64,
<         kind: frame-kind-label,
<         intent: string,
<         peer-spirit-pid: u32,
<         payload-available: bool,
<     }
< 
<     // LogRecallPage (log_recall.rs:193-198).
<     record recall-page {
<         entries: list<recall-entry>,
<         next-cursor: option<recall-cursor>,
<     }
< 
<     // LogFetchResponse (log_recall.rs:250-265).
<     record fetch-response {
<         frame-id: list<u8>,             // [u8; 16]
<         timestamp-ns: u64,
<         kind: frame-kind-label,
<         intent: string,
<         payload-redacted: list<u8>,
<         capability-token: option<list<u8>>,   // [u8; 32]
<         origin: frame-origin,
<     }
< 
<     // LogRecallError (log_recall.rs:332-358), hand-mapped host-side (the
