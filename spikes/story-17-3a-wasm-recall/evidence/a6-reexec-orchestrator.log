<         frame-not-found(list<u8>),
<         storage(string),
<         invalid-cursor(string),
<         limit-exceeded(u32),
<         cross-wall-denied(string),
<     }
< 
<     recall: func(filter: recall-filter) -> result<recall-page, recall-error>;
<     fetch: func(frame-id: list<u8>) -> result<fetch-response, recall-error>;
