{
  "name": "@local/example-spirit-ts",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "^22.20 || ^24.12 || >=25"
  },
  "scripts": {
    "guest-types": "jco guest-types wit --world-name spirit --out-dir src/bindings --strict",
    "build": "npm run guest-types && tsc",
    "componentize": "componentize-js dist/index.js --wit wit --world-name spirit --disable http fetch-event -o dist/spirit.wasm",
    "test": "vitest run"
  },
  "devDependencies": {
    "@bytecodealliance/componentize-js": "0.23.0",
    "@bytecodealliance/jco": "1.35.0",
    "@bytecodealliance/preview2-shim": "0.25.0",
    "typescript": "5.9.3",
    "vitest": "1.6.1"
  }
}
