{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maos.dev/schemas/nfr-onb-1-cohort.schema.json",
  "title": "NFR-Onb-1 Cohort Manifest",
  "description": "A stratified N=12 cohort manifest for the 30-Minute First Spirit Validation Gate. Validated mechanically by maos_eval::onboarding_gate_corpus::validate_stratification. Participant ids are opaque (never real names).",
  "type": "object",
  "additionalProperties": false,
  "required": ["cohort_id", "participants"],
  "properties": {
    "cohort_id": { "type": "string", "minLength": 1 },
    "participants": {
      "type": "array",
      "items": { "$ref": "#/$defs/participant" }
    }
  },
  "$defs": {
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "no_prior_maos_contribution",
        "never_wrote_rust_spirit",
        "never_wrote_rust",
        "non_english_native",
        "offline_only"
      ],
      "properties": {
        "participant_id": {
          "type": "string",
          "pattern": "^P[0-9]{2,}$",
          "description": "Opaque participant id, e.g. P00. Never a real name."
        },
        "no_prior_maos_contribution": { "type": "boolean", "description": "Stratum 1 (floor >=4): screener Q1 = No." },
        "never_wrote_rust_spirit": { "type": "boolean", "description": "Stratum 2 (floor >=3): screener Q2 = No." },
        "never_wrote_rust": { "type": "boolean", "description": "Stratum 3 (floor >=2): screener Q3 = No." },
        "non_english_native": { "type": "boolean", "description": "Stratum 4 (floor >=2): screener Q4 = No." },
        "native_language": { "type": "string", "description": "The participant's native language (informational; for post-hoc analysis and bias auditing). Not consumed by the gate computation." },
        "offline_only": { "type": "boolean", "description": "Stratum 5 (floor >=1): screener Q5 = Yes." }
      }
    }
  }
}
