+    let secs = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs()
+        + 15 * 60;
+    // Format as HH:MM (UTC) for the stub render.
+    let hours = (secs / 3600) % 24;
+    let minutes = (secs % 3600) / 60;
+    format!("{hours:02}:{minutes:02} UTC")
+}
