+        .into_iter()
+        .filter(|(_, state)| matches!(state, HaltState::PendingResolution))
+        .map(|(id, _)| id)
+        .collect();
+    if carried.is_empty() {
+        return Ok(SwapVerdict::SafeDrained { drained_count: 0 });
     }
-
-    // 5. Fall through to migration check
-    let remaining = registry.pending_halt_ids();
