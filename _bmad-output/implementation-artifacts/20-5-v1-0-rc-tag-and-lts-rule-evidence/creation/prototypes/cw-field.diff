 #[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize, Default)]
@@ -4493,6 +4502,33 @@
 }
 
 impl CliWrapperConfig {
+    /// Story 20-5 — read `manifest_schema_version` from a `[cli_wrapper]`
+    /// table and check it against the supported window BEFORE the strict parse.
+    /// Absent means 1 (every pre-20-5 Worker manifest); a non-integer is refused.
+    pub fn check_schema_version(
+        section: &toml::Value,
+    ) -> Result<u32, maos_domain::cli_wrapper::CliWrapperAdmissionError> {
+        use maos_spirit_abi::{
+            MAX_SUPPORTED_CLI_WRAPPER_SCHEMA_VERSION as MAX,
+            MIN_SUPPORTED_CLI_WRAPPER_SCHEMA_VERSION as MIN,
+        };
+        let declared = match section.get("manifest_schema_version") {
+            None => 1,
+            Some(toml::Value::Integer(value)) => u32::try_from(*value).unwrap_or(0),
+            Some(_) => 0,
+        };
+        if declared < MIN || declared > MAX {
+            return Err(
+                maos_domain::cli_wrapper::CliWrapperAdmissionError::ECliWrapperSchemaUnsupported {
+                    declared,
+                    min_supported: MIN,
+                    max_supported: MAX,
+                },
+            );
+        }
+        Ok(declared)
+    }
+
     pub fn from_toml_str(s: &str) -> Result<Self, ManifestError> {
         let cfg: Self = toml::from_str(s).map_err(|e| ManifestError::Toml(e.to_string()))?;
         cfg.validate()?;
