+/// Story 20-5 — refuse a release SHA without a complete T3 chain for every
+/// target: one workflow run's five links, at this exact commit, >= 24 h of
+/// libFuzzer-measured seconds. Configured time and other runs never count.
+pub fn check_t3_fuzz_chain(ledger_path: &str, sha: &str) -> Result<(), String> {
+    let text = std::fs::read_to_string(ledger_path)
+        .map_err(|error| format!("failed to read fuzz ledger {ledger_path}: {error}"))?;
+    let ledger: FuzzLedger = serde_json::from_str(&text)
+        .map_err(|error| format!("invalid fuzz ledger {ledger_path}: {error}"))?;
+    if ledger.schema_version != 1 {
+        return Err(format!(
+            "fuzz ledger schema_version {} is not 1",
+            ledger.schema_version
+        ));
+    }
+    for target in T3_TARGETS {
+        let mut runs: std::collections::BTreeMap<&str, (usize, u64)> = Default::default();
+        for record in ledger
+            .records
+            .iter()
+            .filter(|r| r.target == target && r.tier == "T3" && r.commit == sha)
+        {
+            let run = record
+                .run_id
+                .rsplit_once('-')
+                .map_or(record.run_id.as_str(), |(run, _)| run);
+            let entry = runs.entry(run).or_default();
+            entry.0 += 1;
+            entry.1 += record.cpu_seconds;
+        }
+        if !runs
+            .values()
+            .any(|(links, seconds)| *links == T3_LINKS && *seconds >= T3_SECONDS)
+        {
+            return Err(format!(
+                "release precondition failed: no complete T3 fuzz chain for {target} at {sha} ({T3_LINKS} links, >= {T3_SECONDS} measured seconds, one run)"
+            ));
+        }
+    }
+    Ok(())
+}
