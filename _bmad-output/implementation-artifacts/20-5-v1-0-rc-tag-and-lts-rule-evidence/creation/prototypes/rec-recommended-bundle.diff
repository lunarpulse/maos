diff -ruN '--exclude=.git' a/xtask/src/check_rc_readiness.rs b/xtask/src/check_rc_readiness.rs
--- a/xtask/src/check_rc_readiness.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/xtask/src/check_rc_readiness.rs	2026-11-04 09:13:02.424773893 +0000
@@ -0,0 +1,126 @@
+#![forbid(unsafe_code)]
+
+//! Story 20-5 — `check-rc-readiness`: the tree-state half of the
+//! `v1.0.0-rc.N` readiness contract (`docs/release/rc-checklist.md`). It reads
+//! only committed files; the CI-evidence half (aggregate, T3 fuzz chain, perf
+//! verdicts) is `check-release-precondition` on the tag SHA. It never signs,
+//! tags or publishes.
+
+use std::collections::BTreeSet;
+use std::path::Path;
+
+use serde::Serialize;
+
+#[derive(Debug, Serialize)]
+struct Leg {
+    leg: &'static str,
+    passed: bool,
+    detail: String,
+}
+
+/// Provisioning rows a release candidate needs `present`
+/// (`docs/runbooks/provisioning-checklist.md`).
+const PROVISIONED: [&str; 3] = [
+    "`MAOS_RELEASE_PUBKEY`",
+    "`RELEASE_SIGNING_KEY`",
+    "`fuzz-ledger branch permission`",
+];
+
+pub fn run(workspace_root: &Path, tag: Option<&str>, json: bool) -> Result<(), String> {
+    let read = |rel: &str| {
+        std::fs::read_to_string(workspace_root.join(rel))
+            .map_err(|error| format!("check-rc-readiness: cannot read {rel}: {error}"))
+    };
+    let mut legs = Vec::new();
+
+    let cargo: toml::Value = toml::from_str(&read("Cargo.toml")?)
+        .map_err(|error| format!("check-rc-readiness: Cargo.toml: {error}"))?;
+    let version = cargo["workspace"]["package"]["version"]
+        .as_str()
+        .unwrap_or("")
+        .to_string();
+    let is_rc = version
+        .split_once("-rc.")
+        .is_some_and(|(_, n)| !n.is_empty() && n.bytes().all(|b| b.is_ascii_digit()));
+    let tag_ok = tag.is_none_or(|tag| tag.strip_prefix('v') == Some(version.as_str()));
+    legs.push(Leg {
+        leg: "version",
+        passed: is_rc && tag_ok,
+        detail: format!("workspace version {version}, tag {}", tag.unwrap_or("-")),
+    });
+
+    let stability = crate::stability_matrix::run(workspace_root, true, false);
+    legs.push(Leg {
+        leg: "stability-matrix",
+        passed: stability.is_ok(),
+        detail: stability.err().unwrap_or_else(|| "in sync".into()),
+    });
+
+    let status = crate::sprint_status::load_sprint_status(
+        &workspace_root
+            .join("_bmad-output/implementation-artifacts/sprint-status.yaml")
+            .to_string_lossy(),
+    );
+    let open: BTreeSet<&String> = status
+        .iter()
+        .filter(|(key, value)| {
+            key.starts_with("20-")
+                && key.as_bytes().get(3).is_some_and(u8::is_ascii_digit)
+                && value.as_str() != "done"
+        })
+        .map(|(key, _)| key)
+        .collect();
+    legs.push(Leg {
+        leg: "epic-20-stories",
+        passed: !status.is_empty() && open.is_empty(),
+        detail: format!("not done: {open:?}"),
+    });
+
+    let checklist = read("docs/runbooks/provisioning-checklist.md")?;
+    let absent: Vec<&str> = PROVISIONED
+        .into_iter()
+        .filter(|item| {
+            !checklist.lines().any(|line| {
+                line.starts_with(&format!("| {item} |"))
+                    && line.trim_end().ends_with("| `present` |")
+            })
+        })
+        .collect();
+    legs.push(Leg {
+        leg: "provisioning",
+        passed: absent.is_empty(),
+        detail: format!("not present: {absent:?}"),
+    });
+
+    let deny = read("deny.toml")?;
+    let deferred = read("_bmad-output/implementation-artifacts/deferred-work.md")?;
+    let undocumented: Vec<&str> = deny
+        .lines()
+        .filter_map(|line| line.trim().strip_prefix("\"RUSTSEC-"))
+        .map(|rest| rest.trim_end_matches(['"', ',']))
+        .filter(|id| !deferred.contains(&format!("RUSTSEC-{id}")))
+        .collect();
+    legs.push(Leg {
+        leg: "deny-ignores",
+        passed: undocumented.is_empty(),
+        detail: format!("ignored without a deferred-work row: {undocumented:?}"),
+    });
+
+    let passed = legs.iter().all(|leg| leg.passed);
+    if json {
+        println!(
+            "{}",
+            serde_json::json!({ "gate": "check-rc-readiness", "passed": passed, "legs": legs })
+        );
+    } else {
+        for leg in &legs {
+            let verdict = if leg.passed { "PASS" } else { "FAIL" };
+            eprintln!("check-rc-readiness: {verdict} {} — {}", leg.leg, leg.detail);
+        }
+    }
+    if passed {
+        Ok(())
+    } else {
+        Err("check-rc-readiness: the tree is not rc-ready".into())
+    }
+}
