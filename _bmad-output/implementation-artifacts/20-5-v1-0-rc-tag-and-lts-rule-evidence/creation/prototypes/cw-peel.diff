@@ -169,3 +169,14 @@
 /// assert!(!is_version_supported(0)); // Below floor — EAbiTooOld
 /// ```
 pub const MAX_SUPPORTED_MANIFEST_SCHEMA_VERSION: u32 = MANIFEST_SCHEMA_VERSION;
+
+/// Story 20-5 — schema version of a Worker (`[cli_wrapper]`) manifest. A
+/// separate counter from [`MANIFEST_SCHEMA_VERSION`]: a Worker manifest has no
+/// `[class]`. An absent `[cli_wrapper] manifest_schema_version` means `1`.
+pub const CLI_WRAPPER_SCHEMA_VERSION: u32 = 1;
+
+/// Oldest `[cli_wrapper]` schema version this kernel accepts.
+pub const MIN_SUPPORTED_CLI_WRAPPER_SCHEMA_VERSION: u32 = 1;
+
+/// Newest `[cli_wrapper]` schema version this kernel accepts; higher is refused.
+pub const MAX_SUPPORTED_CLI_WRAPPER_SCHEMA_VERSION: u32 = CLI_WRAPPER_SCHEMA_VERSION;
