+/// Story 20-14 (FR64) — `MAOS_SESSION_PRINCIPAL` under the D-19-2-08 A rule:
+/// unset or blank binds none; a set value is non-empty with no `:` or control
+/// character; a non-UTF-8 or malformed value refuses the boot.
+fn session_principal_from_env() -> Result<Option<String>, String> {
+    match std::env::var("MAOS_SESSION_PRINCIPAL") {
+        Err(std::env::VarError::NotPresent) => Ok(None),
+        Err(std::env::VarError::NotUnicode(raw)) => Err(format!(
+            "maos: MAOS_SESSION_PRINCIPAL {raw:?} is not valid UTF-8"
+        )),
+        Ok(principal) if principal.trim().is_empty() => Ok(None),
+        Ok(principal) if principal.chars().any(|c| c == ':' || c.is_ascii_control()) => {
+            Err(format!(
+                "maos: MAOS_SESSION_PRINCIPAL {principal:?} must have no `:` or control character"
+            ))
+        }
+        Ok(principal) => Ok(Some(principal)),
+    }
+}
