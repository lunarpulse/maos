+#[test]
+fn ac1_owned_cid_removed_before_workspaces_and_receipted() {
+    let f = Fixture::new();
+    f.purge(true);
+    let calls = f.calls();
+    assert!(
+        calls.contains(&format!("rm --force --volumes --time=0 {}", f.owned)),
