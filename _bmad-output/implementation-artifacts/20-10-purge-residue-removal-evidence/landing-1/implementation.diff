+}
+#[test]
+fn ac5_only_absent_cid_and_empty_state_are_reclaimed() {
+    let f = Fixture::new();
+    let empty = f.private("empty");
+    let absent = f.private("process/absent");
+    let present = f.private("process/present");
+    let unknown = f.private("process/unknown");
