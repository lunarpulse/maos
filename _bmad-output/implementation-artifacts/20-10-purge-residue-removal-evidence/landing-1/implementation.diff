+            .env("XDG_DATA_HOME", self.root().join("data"))
+            .env("XDG_CONFIG_HOME", self.root().join("config"))
+            .env("XDG_RUNTIME_DIR", self.root().join("runtime"))
+            .env("TMPDIR", self.root())
+            .env(
