+            impostor: ids[4].clone(),
+        }
+    }
+    fn root(&self) -> &Path {
+        self.dir.path()
+    }
+    fn command(&self) -> Command {
+        let mut c = Command::new(env!("CARGO_BIN_EXE_maos"));
