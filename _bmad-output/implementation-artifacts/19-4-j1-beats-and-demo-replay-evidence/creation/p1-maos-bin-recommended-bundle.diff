+/// Story 19-4 (AC5, D-19-4-05 A) — hold before section `ordinal` while `pid`
+/// has a halt pending resolution (polled ≤ 100 ms; bounded by `deadline` and
+/// the root's shutdown). `Ok(Some(text))` = resolved with provided context,
+/// dispatch resumes with it; `Ok(None)` = resolved without context;
+/// `Err` = still pending at the bound (the 19-1 stop applies).
+pub async fn hold_for_resolution(
+    registry: &HaltRegistry,
+    memory: &dyn maos_domain::ports::MemoryPort,
+    pid: u32,
+    halt_ids: &[String],
+    deadline: std::time::Duration,
+    shutdown: &tokio_util::sync::CancellationToken,
+) -> Result<Option<String>, ()> {
+    let started = std::time::Instant::now();
+    loop {
+        let pending = registry
+            .drain_for_spirit_dry_run(pid)
+            .into_iter()
+            .any(|(_, state)| state == HaltState::PendingResolution);
+        if !pending {
+            break;
+        }
+        if started.elapsed() >= deadline || shutdown.is_cancelled() {
+            return Err(());
+        }
+        tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+    }
+    Ok(halt_ids.iter().find_map(|id| {
+        match memory.read(
+            pid,
+            maos_domain::memory::MemoryTier::Private,
+            &maos_domain::memory::MemoryNamespace::Default,
+            &format!("halt_context::{id}"),
+        ) {
+            Ok(Some(maos_domain::memory::MemoryValue::Text(text))) => Some(text),
+            _ => None,
+        }
+    }))
+}
