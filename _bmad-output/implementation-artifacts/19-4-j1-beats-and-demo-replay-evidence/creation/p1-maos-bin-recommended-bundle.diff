+/// Story 19-4 (AC2, D-19-4-02 A) — judge section `section` before its frame:
+/// the Orchestrator's completion → `dispatch_ambiguity` through its scalar
+/// port; the kernel decides the halt. Unset mode (no port) is no judgement
+/// (ADR-064); every other failure refuses the run typed, never a default.
+pub fn judge_section(emitter: &Orchestrator, section: &EpicSection) -> Result<(), String> {
+    match emitter.assess_ambiguity(section) {
+        Ok((value, halted)) => {
+            println!(
+                "{}",
+                serde_json::json!({
+                    "event": "dispatch_judged",
+                    "section": section.ordinal,
+                    "tag": SCALAR_TAG_DISPATCH_AMBIGUITY,
+                    "value": value,
+                    "halt_id": halted.map(|receipt| receipt.halt_id.as_str().to_owned()),
+                })
+            );
+            Ok(())
+        }
+        Err(orchestrator::OrchestratorInferenceError::NotWired) => Ok(()),
+        Err(error) => Err(format!(
+            "maos run: section {} ambiguity judgement: {error}",
+            section.ordinal
+        )),
+    }
+}
