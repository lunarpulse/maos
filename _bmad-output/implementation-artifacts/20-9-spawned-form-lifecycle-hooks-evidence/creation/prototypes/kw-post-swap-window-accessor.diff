+    /// 20-9 — whether `spirit_pid`'s post-swap window is open, i.e. an
+    /// auto-revert can still restore the predecessor runtime.
+    pub fn post_swap_window_open(&self, spirit_pid: u32) -> bool {
+        self.active_monitors
+            .lock()
+            .get(&spirit_pid)
+            .is_some_and(|handle| !handle.is_finished())
+    }
