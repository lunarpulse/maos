+fn prototype_bridge_frames(
+    binary: &Path,
+    args: &[&str],
+    inputs: &[IacFrame],
+    component: Option<&str>,
+) -> Vec<IacFrame> {
+    use maos_domain::invariants::i1::Scope;
+    use maos_domain::invariants::i9::SandboxTier;
+    use maos_kernel_core::lifecycle::cli_wrapper::{
+        argv_prefix_hash, spawn_and_bridge, Backpressure, BridgeSpawnSpec, ExitCause, SubStream,
+    };
+    use maos_kernel_core::security::manifest::{CliWrapperControlChannel, CliWrapperStdioShape};
+    use maos_kernel_core::security::sandbox::SandboxSpec;
+    let argv_prefix: Vec<String> = args.iter().map(|arg| (*arg).into()).collect();
+    let mut sandbox = SandboxSpec::new_for_test(if component.is_some() {
+        SandboxTier::T2
+    } else {
+        SandboxTier::T0
+    });
+    if let Some(component) = component {
+        sandbox.declared_scopes = vec![Scope::FsRead {
+            subtree: Path::new(component)
+                .canonicalize()
+                .expect("component path")
+                .display()
+                .to_string(),
+        }];
+    }
+    let mut bridge = spawn_and_bridge(BridgeSpawnSpec {
+        program: binary.display().to_string(),
+        sandbox,
+        expected_argv_prefix_hash: argv_prefix_hash(&argv_prefix),
+        argv_prefix,
+        task_args: Vec::new(),
+        from_spirit_id: "prototype-host-bound".into(),
+        stdio_shape: CliWrapperStdioShape::JsonRpcOverStdio,
+        control_channel: CliWrapperControlChannel::Signals,
+        shutdown_signal: None,
+        channel_capacity: 8,
+        backpressure: Backpressure::Block,
+        env: Vec::new(),
+    })
+    .expect("actual framed bridge spawn, no skip");
+    for frame in inputs {
+        bridge
+            .write_stdin_frame(&codec::encode_cbor(frame).expect("encode"))
+            .expect("framed input");
+    }
+    bridge.close_frame_input();
+    let mut frames = Vec::new();
+    while let Some((stream, bytes)) = bridge.recv_frame().expect("framed output") {
+        match stream {
+            SubStream::Stdout => {
+                frames.push(codec::decode_cbor(&bytes).expect("actual IacFrame output"))
+            }
+            SubStream::Stderr => eprintln!(
+                "PROTOTYPE-BRIDGE-STDERR {}",
+                String::from_utf8_lossy(&bytes)
+            ),
+        }
+    }
+    let journal =
+        maos_kernel_core::iac::transparency_log::TransparencyLogAdapter::open_in_memory(0);
+    let exit = bridge.wait_and_finalize(&journal, 7, |code| {
+        assert_eq!(
+            code,
+            Some(0),
+            "form finalization must observe a successful exit"
+        );
+    });
+    assert_eq!(
+        exit.cause,
+        ExitCause::Exited { code: 0 },
+        "real form must exit cleanly"
+    );
+    println!(
+        "PROTOTYPE-BRIDGE-OUTCOME tier={} frames={} exit=0",
+        if component.is_some() { "T2" } else { "T0" },
+        frames.len()
+    );
+    frames
+}
