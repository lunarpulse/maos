+#![forbid(unsafe_code)]
+//! 17-3c PROTOTYPE — raw-byte `Content-Length`-framed session through the real
+//! `spawn_and_bridge` against REAL native programs (no WASM, no wasmtime).
+//!
+//! The subject is `cat` (a native binary that echoes stdin to stdout verbatim),
+//! so a frame written by `write_stdin_frame` comes back through the child's own
+//! stdout and the bridge's `Content-Length` reader. Each test fails if: the
+//! body is passed through a lossy `String`, a newline is appended/stripped,
+//! stdin is closed under `Signals` + `JsonRpcOverStdio`, or a framing error is
+//! swallowed.
+
+use maos_kernel_core::lifecycle::cli_wrapper::{
+    argv_prefix_hash, spawn_and_bridge, Backpressure, BridgeError, BridgeSpawnSpec, SpawnedBridge,
+    SubStream,
+};
+use maos_kernel_core::security::manifest::{CliWrapperControlChannel, CliWrapperStdioShape};
+
+fn spec(shape: CliWrapperStdioShape, script: &str) -> BridgeSpawnSpec {
+    let argv_prefix = vec!["-c".to_string()];
+    BridgeSpawnSpec {
+        program: "sh".to_string(),
+        sandbox: maos_kernel_core::security::sandbox::SandboxSpec::new_for_test(
+            maos_domain::invariants::i9::SandboxTier::T0,
+        ),
+        expected_argv_prefix_hash: argv_prefix_hash(&argv_prefix),
+        argv_prefix,
+        task_args: vec![script.to_string()],
+        from_spirit_id: "worker".to_string(),
+        stdio_shape: shape,
+        control_channel: CliWrapperControlChannel::Signals,
+        shutdown_signal: None,
+        channel_capacity: 2,
+        backpressure: Backpressure::Block,
+        env: vec![],
+    }
+}
+
+/// Next stdout record; stderr diagnostics are collected, errors fail the test.
+fn next_stdout(bridge: &mut SpawnedBridge, stderr: &mut Vec<Vec<u8>>) -> Vec<u8> {
+    loop {
+        match bridge.recv_frame().expect("framing error") {
+            Some((SubStream::Stdout, body)) => return body,
+            Some((SubStream::Stderr, line)) => stderr.push(line),
+            None => panic!("bridge closed before the expected stdout frame"),
+        }
+    }
+}
+
+/// A valid CBOR map `{"k": h'FFFE00', "v": h'0D0A0D0A'}` — not UTF-8, NUL- and
+/// CRLF-bearing, so lossy decode, NUL termination, or header-style trimming all
+/// change it.
+fn cbor_probe() -> Vec<u8> {
+    let mut b = vec![0xA2, 0x61, b'k', 0x43, 0xFF, 0xFE, 0x00];
+    b.extend_from_slice(&[0x61, b'v', 0x44, b'\r', b'\n', b'\r', b'\n']);
+    b
+}
+
+#[test]
+fn non_utf8_cbor_frames_round_trip_byte_exact_with_stdin_kept_open() {
+    let probe = cbor_probe();
+    assert!(
+        std::str::from_utf8(&probe).is_err(),
+        "probe must be non-UTF-8"
+    );
+    // Every byte value, larger than a pipe buffer: boundary + length must hold
+    // while the bounded channel (capacity 2) applies backpressure.
+    let big: Vec<u8> = (0..70_000u32).map(|i| (i % 256) as u8).collect();
+
+    // `echo diag >&2` first: plain-text stderr must NOT be parsed as a frame.
+    let mut bridge = spawn_and_bridge(spec(
+        CliWrapperStdioShape::JsonRpcOverStdio,
+        "echo diag >&2; exec cat",
+    ))
+    .expect("spawn sh");
+
+    let mut stderr = Vec::new();
+    bridge
+        .write_stdin_frame(&probe)
+        .expect("Signals + JsonRpcOverStdio must keep stdin open for frames");
+    assert_eq!(
+        next_stdout(&mut bridge, &mut stderr),
+        probe,
+        "CBOR frame not byte-exact"
+    );
+
+    // Back-to-back frames: a frame boundary is the length, not content.
+    bridge.write_stdin_frame(b"").expect("empty frame");
+    bridge
+        .write_stdin_frame(&probe)
+        .expect("frame after empty frame");
+    // Write both, then read both: the child echoes, the reader thread drains.
+    assert_eq!(
+        next_stdout(&mut bridge, &mut stderr),
+        b"",
+        "empty frame lost"
+    );
+    assert_eq!(next_stdout(&mut bridge, &mut stderr), probe);
+
+    bridge.write_stdin_frame(&big).expect("large frame");
+    assert_eq!(
+        next_stdout(&mut bridge, &mut stderr),
+        big,
+        "large frame corrupted"
+    );
+
+    // The stderr line arrives as a stderr record. It may have been collected
+    // above, or still be queued: drain until seen.
+    while stderr.is_empty() {
+        match bridge.recv_frame().expect("framing error") {
+            Some((SubStream::Stderr, line)) => stderr.push(line),
+            Some((SubStream::Stdout, _)) => panic!("unexpected extra stdout frame"),
+            None => break,
+        }
+    }
+    assert_eq!(
+        stderr,
+        vec![b"diag".to_vec()],
+        "stderr must stay LF-delimited text"
+    );
+}
+
+#[test]
+fn frame_write_is_refused_for_text_shapes_and_after_stdin_close() {
+    // Text shape under Signals: stdin is closed (existing 8-12 behavior kept) and
+    // frame writes are refused rather than silently emitting a bare body.
+    let mut text = spawn_and_bridge(spec(
+        CliWrapperStdioShape::NdjsonOverStdio,
+        "cat >/dev/null",
+    ))
+    .expect("spawn sh");
+    let err = text
+        .write_stdin_frame(b"x")
+        .expect_err("text shape must refuse frames");
+    assert_eq!(err.kind(), std::io::ErrorKind::InvalidInput);
+    assert!(
+        text.write_stdin_line(b"x").is_err(),
+        "Signals+text keeps closing stdin"
+    );
+
+    // Framed shape: stdin is open until the bridge is unloaded, then BrokenPipe.
+    let mut framed = spawn_and_bridge(spec(CliWrapperStdioShape::JsonRpcOverStdio, "exec cat"))
+        .expect("spawn sh");
+    framed.write_stdin_frame(b"ok").expect("stdin open");
+    framed.on_unload().expect("unload");
+    let err = framed
+        .write_stdin_frame(b"late")
+        .expect_err("stdin closed after unload");
+    assert_eq!(err.kind(), std::io::ErrorKind::BrokenPipe);
+}
+
+#[test]
+fn malformed_stdout_framing_is_an_error_not_silence() {
+    let mut bridge = spawn_and_bridge(spec(
+        CliWrapperStdioShape::JsonRpcOverStdio,
+        "printf 'not a header\\n\\n'",
+    ))
+    .expect("spawn sh");
+    match bridge.recv_frame() {
+        Err(BridgeError::Io(msg)) => assert!(msg.contains("Stdout"), "{msg}"),
+        other => panic!("bad Content-Length header must surface, got {other:?}"),
+    }
+}
