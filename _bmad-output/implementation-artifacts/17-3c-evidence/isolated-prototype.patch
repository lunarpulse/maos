+// Isolated 17-3c feasibility probe: real framed bridge output, local T2 WASM,
+// and real kernel policy. Not production SCB/enterprise/bus ingress proof.
+#[test]
+fn prototype_live_frames_reach_kernel_policy_eight_cases() {
+    use maos_domain::invariants::i1::Scope;
+    use maos_domain::ports::capability::CapError;
+
+    let component = component_fixture_path("identity");
+    require_component(&component);
+    let mut inputs = Vec::new();
+    for _ in 0..2 {
+        let mut clean = sample_identity_frame();
+        let FramePayload::TaskAssign(task) = &mut clean.payload else {
+            panic!("identity probe must be a task assignment");
+        };
+        task.scope = vec![Scope::FsRead {
+            subtree: "/tmp".into(),
+        }];
+        let mut forged = clean.clone();
+        forged.intent = IntentClass::HighPrivilege;
+        forged.consent_envelope = Some(ConsentEnvelope {
+            consent_id: [0xFE; 16],
+            granter: forged.from.clone(),
+            timestamp_ns: forged.timestamp_ns,
+            intent_class: Some(A2AIntent::new("forged:escalation")),
+            valid_until_ns: None,
+        });
+        inputs.extend([clean, forged]);
+    }
+
+    let native = prototype_bridge_frames(
+        &ensure_native_twin_binary(),
+        &["--mode", "identity"],
+        &inputs,
+        None,
+    );
+    let wasm = prototype_bridge_frames(
+        &require_binary("maos-wasm-runner"),
+        &["--component", &component, "--fuel", WASM_FUEL_BUDGET],
+        &inputs,
+        Some(&component),
+    );
+    assert_eq!(native.len(), 4, "native must emit all requested frames");
+    assert_eq!(wasm.len(), 4, "WASM must emit all requested frames");
+    let (kernel, _audit_rx) = kernel_oracle::cap_registry();
+    let mut decisions = Vec::new();
+    for (form, output) in [("native", &native), ("wasm", &wasm)] {
+        let mut form_decisions = Vec::new();
+        for (case, (emitted, input)) in output.iter().zip(&inputs).enumerate() {
+            assert_eq!(
+                normalize(emitted),
+                normalize(input),
+                "claims must reach the probe unchanged"
+            );
+            let FramePayload::TaskAssign(task) = &emitted.payload else {
+                panic!("emitted request did not reach the selected decision shape");
+            };
+            assert_eq!(task.scope.len(), 1);
+            // PID and posture are bound by the host; guest identity/claims cannot
+            // choose them. Kernel issue_with_mediation derives policy intent
+            // from the requested scope, rather than the in-band intent claim.
+            let result = kernel.issue_with_mediation(
+                if case < 2 { 7 } else { 8 },
+                task.scope[0].clone(),
+                60,
+                [0xAB; 32],
+                IntentClass::Standard,
+            );
+            let verdict = match result {
+                Ok(_) => true,
+                Err(CapError::PolicyDenied) => false,
+                Err(error) => {
+                    panic!("{form} case {case}: not a terminal policy verdict: {error:?}")
+                }
+            };
+            let expected = case < 2;
+            println!(
+                "PROTOTYPE-KERNEL-VERDICT form={form} case={case} forged={} allowed={verdict}",
+                case % 2 == 1
+            );
+            assert_eq!(
+                verdict, expected,
+                "{form} case {case}: actual kernel policy result"
+            );
+            form_decisions.push(verdict);
+        }
+        assert_eq!(form_decisions[0], form_decisions[1]);
+        assert_eq!(form_decisions[2], form_decisions[3]);
+        assert_ne!(
+            form_decisions[0], form_decisions[2],
+            "allow and deny controls must discriminate"
+        );
+        decisions.push(form_decisions);
+    }
+    assert_eq!(
+        decisions[0], decisions[1],
+        "equivalent forms must get identical policy results"
+    );
+}
