+    use std::process::{Command, Stdio};
+
+    let runner = std::env::var("MAOS_PROTO_RUNNER").expect("MAOS_PROTO_RUNNER is required");
+    let component = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../tests/fixtures/wasm/equiv_identity_spirit_component.wasm")
+        .canonicalize()
+        .expect("committed identity component");
+    let mut sandbox = SandboxSpec::new_for_test(SandboxTier::T2);
+    sandbox.declared_scopes = vec![Scope::FsRead {
+        subtree: component.display().to_string(),
+    }];
+    let mut command = Command::new(&runner);
+    command
+        .args([
+            "--component",
+            component.to_str().expect("UTF-8 component path"),
+        ])
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::inherit());
+    let mut child = spawn_sandboxed(&sandbox, &mut command)
+        .unwrap_or_else(|error| panic!("PROTOTYPE-T2-OUTCOME spawn refused, no skip: {error:?}"));
+    let status = child.wait().expect("wait real T2 runner");
+    println!("PROTOTYPE-T2-OUTCOME {status}");
+    assert!(
+        status.success(),
+        "T2 runner compilation/startup not yet supported: {status}"
+    );
+}
