+#[derive(Debug)]
+struct Elf64 {
+    interpreter: Option<String>,
+    needed: Vec<String>,
+    runpaths: Vec<String>,
+}
+
+#[derive(Debug)]
+struct ProgramHeader {
+    typ: u32,
+    offset: u64,
+    vaddr: u64,
+    filesz: u64,
+    memsz: u64,
+}
+
+impl Elf64 {
+    fn read(path: &Path) -> Result<Self, SpawnError> {
+        const ELF_HEADER_LEN: usize = 64;
+        const PROGRAM_HEADER_LEN: usize = 56;
+        const PT_LOAD: u32 = 1;
+        const PT_DYNAMIC: u32 = 2;
+        const PT_INTERP: u32 = 3;
+        const DT_NULL: i64 = 0;
+        const DT_NEEDED: i64 = 1;
+        const DT_STRTAB: i64 = 5;
+        const DT_STRSZ: i64 = 10;
+        const DT_RUNPATH: i64 = 29;
+
+        let mut file = File::open(path)
+            .map_err(|e| SpawnError::SandboxSetup(format!("open ELF {}: {e}", path.display())))?;
+        let mut header = [0_u8; ELF_HEADER_LEN];
+        file.read_exact(&mut header).map_err(|e| {
+            SpawnError::SandboxSetup(format!("read ELF header {}: {e}", path.display()))
+        })?;
+        if &header[..4] != b"\x7fELF" || header[4] != 2 || header[5] != 1 {
+            return Err(SpawnError::SandboxSetup(format!(
+                "program {} is not ELF64 little-endian",
+                path.display()
+            )));
+        }
+        let phoff = u64::from_le_bytes(header[32..40].try_into().unwrap());
+        let phentsize = u16::from_le_bytes(header[54..56].try_into().unwrap()) as usize;
+        let phnum = u16::from_le_bytes(header[56..58].try_into().unwrap()) as usize;
+        if phentsize != PROGRAM_HEADER_LEN {
+            return Err(SpawnError::SandboxSetup(format!(
+                "ELF program header size for {} is unsupported",
+                path.display()
+            )));
+        }
+
+        file.seek(SeekFrom::Start(phoff))
+            .map_err(|e| SpawnError::SandboxSetup(format!("seek ELF program headers: {e}")))?;
+        let mut headers = Vec::with_capacity(phnum);
+        for _ in 0..phnum {
+            let mut raw = [0_u8; PROGRAM_HEADER_LEN];
+            file.read_exact(&mut raw)
+                .map_err(|e| SpawnError::SandboxSetup(format!("read ELF program header: {e}")))?;
+            headers.push(ProgramHeader {
+                typ: u32::from_le_bytes(raw[0..4].try_into().unwrap()),
+                offset: u64::from_le_bytes(raw[8..16].try_into().unwrap()),
+                vaddr: u64::from_le_bytes(raw[16..24].try_into().unwrap()),
+                filesz: u64::from_le_bytes(raw[32..40].try_into().unwrap()),
+                memsz: u64::from_le_bytes(raw[40..48].try_into().unwrap()),
+            });
+        }
+
+        let interpreter = headers
+            .iter()
+            .find(|header| header.typ == PT_INTERP)
+            .map(|header| read_elf_string(&mut file, header.offset, header.filesz as usize))
+            .transpose()?;
+        let Some(dynamic) = headers.iter().find(|header| header.typ == PT_DYNAMIC) else {
+            return Ok(Self {
+                interpreter,
+                needed: vec![],
+                runpaths: vec![],
+            });
+        };
+
+        file.seek(SeekFrom::Start(dynamic.offset))
+            .map_err(|e| SpawnError::SandboxSetup(format!("seek ELF dynamic table: {e}")))?;
+        let entry_count = (dynamic.filesz / 16) as usize;
+        let mut needed_offsets = Vec::new();
+        let mut runpath_offsets = Vec::new();
+        let mut strtab_addr = None;
+        let mut strtab_size = None;
+        for _ in 0..entry_count {
+            let mut raw = [0_u8; 16];
+            file.read_exact(&mut raw)
+                .map_err(|e| SpawnError::SandboxSetup(format!("read ELF dynamic entry: {e}")))?;
+            let tag = i64::from_le_bytes(raw[0..8].try_into().unwrap());
+            let value = u64::from_le_bytes(raw[8..16].try_into().unwrap());
+            match tag {
+                DT_NULL => break,
+                DT_NEEDED => needed_offsets.push(value),
+                DT_STRTAB => strtab_addr = Some(value),
+                DT_STRSZ => strtab_size = Some(value),
+                DT_RUNPATH => runpath_offsets.push(value),
+                _ => {}
+            }
+        }
+        let Some(strtab_addr) = strtab_addr else {
+            return Ok(Self {
+                interpreter,
+                needed: vec![],
+                runpaths: vec![],
+            });
+        };
+        let strtab_size = strtab_size.unwrap_or(0);
+        let strtab_offset = headers
+            .iter()
+            .find(|header| {
+                header.typ == PT_LOAD
+                    && strtab_addr >= header.vaddr
+                    && strtab_addr < header.vaddr.saturating_add(header.memsz)
+            })
+            .map(|header| header.offset + (strtab_addr - header.vaddr))
+            .ok_or_else(|| SpawnError::SandboxSetup("ELF DT_STRTAB is outside PT_LOAD".into()))?;
+        let string_at = |offset: u64, file: &mut File| {
+            if offset >= strtab_size {
+                return Err(SpawnError::SandboxSetup(
+                    "ELF dynamic string offset is outside DT_STRSZ".into(),
+                ));
+            }
+            read_elf_string(
+                file,
+                strtab_offset + offset,
+                (strtab_size - offset) as usize,
+            )
+        };
+        let needed = needed_offsets
+            .into_iter()
+            .map(|offset| string_at(offset, &mut file))
+            .collect::<Result<Vec<_>, _>>()?;
+        let runpaths = runpath_offsets
+            .into_iter()
+            .map(|offset| string_at(offset, &mut file))
+            .collect::<Result<Vec<_>, _>>()?
+            .into_iter()
+            .flat_map(|paths| paths.split(':').map(str::to_owned).collect::<Vec<_>>())
+            .collect();
+        Ok(Self {
+            interpreter,
+            needed,
+            runpaths,
+        })
+    }
+}
+
+fn read_elf_string(file: &mut File, offset: u64, max_len: usize) -> Result<String, SpawnError> {
+    const MAX_ELF_STRING_LEN: usize = 4096;
+    file.seek(SeekFrom::Start(offset))
+        .map_err(|e| SpawnError::SandboxSetup(format!("seek ELF string: {e}")))?;
+    let mut bytes = Vec::new();
+    for _ in 0..max_len.min(MAX_ELF_STRING_LEN) {
+        let mut byte = [0_u8; 1];
+        file.read_exact(&mut byte)
+            .map_err(|e| SpawnError::SandboxSetup(format!("read ELF string: {e}")))?;
+        if byte[0] == 0 {
+            return String::from_utf8(bytes)
+                .map_err(|_| SpawnError::SandboxSetup("ELF dynamic string was not UTF-8".into()));
+        }
+        bytes.push(byte[0]);
+    }
+    Err(SpawnError::SandboxSetup(
+        "ELF dynamic string exceeded maximum length".into(),
+    ))
+}
+
+fn resolve_elf_libraries(
+    program: &Path,
+    program_elf: &Elf64,
+    loader: &Path,
+) -> Result<Vec<PathBuf>, SpawnError> {
+    let loader_dir = loader.parent().ok_or_else(|| {
+        SpawnError::SandboxSetup(format!(
+            "ELF interpreter {} has no parent directory",
+            loader.display()
+        ))
+    })?;
+    let mut libraries = Vec::new();
+    let mut resolved = BTreeSet::new();
+    let mut pending = VecDeque::from([(
+        program.to_path_buf(),
+        program_elf.needed.clone(),
+        program_elf.runpaths.clone(),
+    )]);
+    while let Some((owner, needed, runpaths)) = pending.pop_front() {
+        let search_dirs = std::iter::once(loader_dir.to_path_buf())
+            .chain(runpaths.into_iter().filter_map(|runpath| {
+                let path = PathBuf::from(runpath);
+                if path.is_absolute() {
+                    Some(path)
+                } else {
+                    owner.parent().map(|parent| parent.join(path))
+                }
+            }))
+            .collect::<Vec<_>>();
+        for soname in needed {
+            let library = search_dirs
+                .iter()
+                .map(|dir| dir.join(&soname))
+                .find_map(|candidate| candidate.canonicalize().ok())
+                .ok_or_else(|| {
+                    SpawnError::SandboxSetup(format!(
+                        "ELF dependency {soname} could not be resolved"
+                    ))
+                })?;
+            if resolved.insert(library.clone()) {
+                let elf = Elf64::read(&library)?;
+                pending.push_back((library.clone(), elf.needed, elf.runpaths));
+                libraries.push(library);
+            }
+        }
+    }
+    Ok(libraries)
+}
 
