+/// Resolve the executable exactly once in the parent before Landlock is enabled.
+fn resolve_program(command: &Command) -> Result<PathBuf, SpawnError> {
+    let program = Path::new(command.get_program());
+    let resolved = if program.is_absolute() || program.components().count() > 1 {
+        program.to_path_buf()
+    } else {
+        let path = command
+            .get_envs()
+            .find_map(|(key, value)| (key == OsStr::new("PATH")).then_some(value))
+            .flatten()
+            .map(OsString::from)
+            .or_else(|| std::env::var_os("PATH"))
+            .ok_or_else(|| {
+                SpawnError::SandboxSetup("PATH is unset while resolving program".into())
+            })?;
+        std::env::split_paths(&path)
+            .map(|dir| dir.join(program))
+            .find(|candidate| {
+                candidate.is_file()
+                    && candidate
+                        .metadata()
+                        .map(|metadata| metadata.permissions().mode() & 0o111 != 0)
+                        .unwrap_or(false)
+            })
+            .ok_or_else(|| {
+                SpawnError::SandboxSetup(format!(
+                    "program {} was not executable on PATH",
+                    program.display()
+                ))
+            })?
+    };
+    resolved.canonicalize().map_err(|e| {
+        SpawnError::SandboxSetup(format!("canonicalize program {}: {e}", resolved.display()))
+    })
