@@ -0,0 +1,278 @@
+//! Story 17-6 — the files an `execve` of a program opens: the program, its ELF
+//! interpreter (the dynamic loader) and the shared libraries the loader maps.
+//!
+//! The kernel's T2 sandbox (`maos-kernel-core` `security/sandbox/linux.rs`)
+//! grants Landlock rights on exactly this set. The program is PARSED, never
+//! run: no `ldd`, no subprocess. Input is hostile (any manifest can name a
+//! program), so every read is bounded, non-regular files are refused before
+//! they can block, and every failure is an error — never a broader answer.
+#![forbid(unsafe_code)]
+
+use std::collections::{BTreeSet, VecDeque};
+use std::ffi::OsStr;
+use std::fs::{File, OpenOptions};
+use std::io::{BufReader, Read, Seek, SeekFrom};
+use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+
+/// The resolved exec set. Paths are canonical.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ExecDeps {
+    pub program: PathBuf,
+    /// `PT_INTERP`, canonical; `None` for a static binary.
+    pub loader: Option<PathBuf>,
+    /// Transitive `DT_NEEDED` closure, deduplicated, in discovery order.
+    pub libraries: Vec<PathBuf>,
+}
+
+/// Why the set could not be resolved. The caller refuses the spawn.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Error(pub String);
+
+impl std::fmt::Display for Error {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(&self.0)
+    }
+}
+
+impl std::error::Error for Error {}
+
+fn err<T>(msg: impl Into<String>) -> Result<T, Error> {
+    Err(Error(msg.into()))
+}
+
+/// Resolve `program` the way `execvp` would (`path_env` is the child's `PATH`),
+/// then its loader and transitive libraries.
+pub fn resolve(program: &OsStr, path_env: Option<&OsStr>) -> Result<ExecDeps, Error> {
+    let program = resolve_program(Path::new(program), path_env)?;
+    let elf = Elf::read(&program)?;
+    let Some(interp) = &elf.interp else {
+        return Ok(ExecDeps {
+            program,
+            loader: None,
+            libraries: vec![],
+        });
+    };
+    let loader = canonical(Path::new(interp))?;
+    let loader_dir = loader.parent().map(Path::to_path_buf).unwrap_or_default();
+    let mut libraries = Vec::new();
+    let mut seen = BTreeSet::new();
+    let mut queue = VecDeque::from([(program.clone(), elf)]);
+    while let Some((owner, elf)) = queue.pop_front() {
+        let owner_dir = owner.parent().map(Path::to_path_buf).unwrap_or_default();
+        // ld.so order: DT_RPATH (only without DT_RUNPATH), DT_RUNPATH, then the
+        // loader's own directory (the system library directory).
+        let search: Vec<PathBuf> = elf
+            .search_paths
+            .iter()
+            .map(|p| {
+                if Path::new(p).is_absolute() {
+                    PathBuf::from(p)
+                } else {
+                    owner_dir.join(p)
+                }
+            })
+            .chain(std::iter::once(loader_dir.clone()))
+            .collect();
+        for soname in &elf.needed {
+            let Some(lib) = search
+                .iter()
+                .find_map(|dir| canonical(&dir.join(soname)).ok())
+            else {
+                return err(format!("{}: library {soname} not found", owner.display()));
+            };
+            if seen.insert(lib.clone()) {
+                queue.push_back((lib.clone(), Elf::read(&lib)?));
+                libraries.push(lib);
+            }
+        }
+    }
+    Ok(ExecDeps {
+        program,
+        loader: Some(loader),
+        libraries,
+    })
+}
+
+fn canonical(path: &Path) -> Result<PathBuf, Error> {
+    path.canonicalize()
+        .or_else(|e| err(format!("{}: {e}", path.display())))
+}
+
+fn resolve_program(program: &Path, path_env: Option<&OsStr>) -> Result<PathBuf, Error> {
+    if program.components().count() > 1 {
+        return canonical(program);
+    }
+    let path = path_env
+        .map(OsStr::to_os_string)
+        .or_else(|| std::env::var_os("PATH"));
+    let Some(path) = path else {
+        return err("PATH is unset while resolving the program");
+    };
+    std::env::split_paths(&path)
+        .map(|dir| dir.join(program))
+        .find(|c| {
+            c.metadata()
+                .is_ok_and(|m| m.is_file() && m.permissions().mode() & 0o111 != 0)
+        })
+        .map_or_else(
+            || {
+                err(format!(
+                    "{} is not an executable on PATH",
+                    program.display()
+                ))
+            },
+            |c| canonical(&c),
+        )
+}
+
+const MAX_STRING: usize = 4096;
+
+struct Elf {
+    interp: Option<String>,
+    needed: Vec<String>,
+    search_paths: Vec<String>,
+}
+
+impl Elf {
+    fn read(path: &Path) -> Result<Self, Error> {
+        let fail = |what: &str| Error(format!("{}: {what}", path.display()));
+        // O_NONBLOCK: a FIFO named as the program must not hang the daemon.
+        let file = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NONBLOCK)
+            .open(path)
+            .map_err(|e| fail(&e.to_string()))?;
+        if !file.metadata().map_err(|e| fail(&e.to_string()))?.is_file() {
+            return Err(fail("not a regular file"));
+        }
+        let mut f = BufReader::new(file);
+        let mut h = [0u8; 64];
+        f.read_exact(&mut h).map_err(|_| fail("short ELF header"))?;
+        if &h[..4] != b"\x7fELF" || h[4] != 2 || h[5] != 1 || u16_at(&h, 54) != 56 {
+            return Err(fail("not an ELF64 little-endian executable"));
+        }
+        let (phoff, phnum) = (u64_at(&h, 32), u16_at(&h, 56));
+        let mut phdrs = Vec::with_capacity(usize::from(phnum));
+        seek(&mut f, phoff, &fail)?;
+        for _ in 0..phnum {
+            let mut p = [0u8; 56];
+            f.read_exact(&mut p)
+                .map_err(|_| fail("short program header"))?;
+            // (type, offset, vaddr, filesz, memsz)
+            phdrs.push((
+                u32_at(&p, 0),
+                u64_at(&p, 8),
+                u64_at(&p, 16),
+                u64_at(&p, 32),
+                u64_at(&p, 40),
+            ));
+        }
+        let interp = match phdrs.iter().find(|p| p.0 == 3) {
+            Some(p) => Some(read_str(&mut f, p.1, p.3, &fail)?),
+            None => None,
+        };
+        let mut elf = Elf {
+            interp,
+            needed: vec![],
+            search_paths: vec![],
+        };
+        let Some(dynamic) = phdrs.iter().find(|p| p.0 == 2) else {
+            return Ok(elf);
+        };
+        let (mut needed, mut rpath, mut runpath, mut strtab, mut strsz) =
+            (vec![], vec![], vec![], None, 0);
+        seek(&mut f, dynamic.1, &fail)?;
+        for _ in 0..dynamic.3 / 16 {
+            let mut d = [0u8; 16];
+            f.read_exact(&mut d)
+                .map_err(|_| fail("short dynamic entry"))?;
+            let value = u64_at(&d, 8);
+            match u64_at(&d, 0) {
+                0 => break,
+                1 => needed.push(value),
+                5 => strtab = Some(value),
+                10 => strsz = value,
+                15 => rpath.push(value),
+                29 => runpath.push(value),
+                _ => {}
+            }
+        }
+        if needed.is_empty() {
+            return Ok(elf);
+        }
+        let Some(strtab) = strtab else {
+            return Err(fail("DT_NEEDED without DT_STRTAB"));
+        };
+        let base = phdrs
+            .iter()
+            .find(|p| p.0 == 1 && strtab >= p.2 && strtab - p.2 < p.4)
+            .and_then(|p| p.1.checked_add(strtab - p.2))
+            .ok_or_else(|| fail("DT_STRTAB outside every PT_LOAD"))?;
+        let mut string = |off: u64| {
+            if off >= strsz {
+                return Err(fail("dynamic string outside DT_STRSZ"));
+            }
+            let at = base
+                .checked_add(off)
+                .ok_or_else(|| fail("dynamic string offset overflows"))?;
+            read_str(&mut f, at, strsz - off, &fail)
+        };
+        elf.needed = needed
+            .into_iter()
+            .map(&mut string)
+            .collect::<Result<_, _>>()?;
+        let paths = if runpath.is_empty() { rpath } else { runpath };
+        for off in paths {
+            let joined = string(off)?;
+            if joined.contains('$') {
+                return Err(fail(
+                    "$ORIGIN/$LIB substitution in a library search path is not supported",
+                ));
+            }
+            elf.search_paths.extend(
+                joined
+                    .split(':')
+                    .filter(|s| !s.is_empty())
+                    .map(str::to_owned),
+            );
+        }
+        Ok(elf)
+    }
+}
+
+fn seek(f: &mut BufReader<File>, at: u64, fail: &dyn Fn(&str) -> Error) -> Result<(), Error> {
+    f.seek(SeekFrom::Start(at))
+        .map(drop)
+        .map_err(|_| fail("seek past end"))
+}
+
+fn read_str(
+    f: &mut BufReader<File>,
+    at: u64,
+    max: u64,
+    fail: &dyn Fn(&str) -> Error,
+) -> Result<String, Error> {
+    seek(f, at, fail)?;
+    let limit = usize::try_from(max).unwrap_or(MAX_STRING).min(MAX_STRING);
+    let mut bytes = Vec::new();
+    for byte in f.by_ref().bytes().take(limit) {
+        match byte.map_err(|_| fail("short string"))? {
+            0 => return String::from_utf8(bytes).map_err(|_| fail("non-UTF-8 string")),
+            b => bytes.push(b),
+        }
+    }
+    Err(fail("unterminated string"))
+}
+
+fn u16_at(b: &[u8], at: usize) -> u16 {
+    u16::from_le_bytes([b[at], b[at + 1]])
+}
+
+fn u32_at(b: &[u8], at: usize) -> u32 {
+    u32::from_le_bytes(b[at..at + 4].try_into().expect("4 bytes"))
+}
+
+fn u64_at(b: &[u8], at: usize) -> u64 {
+    u64::from_le_bytes(b[at..at + 8].try_into().expect("8 bytes"))
+}
