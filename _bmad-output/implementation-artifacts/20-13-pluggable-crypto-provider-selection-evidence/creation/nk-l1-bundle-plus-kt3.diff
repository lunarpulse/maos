+/// Story 20-13 (FR48) — the selected provider is the only crypto instance.
+/// `RingCryptoProvider` may be constructed only by the provider table
+/// (`maos-bin/src/crypto_provider.rs`), by its own module, and in test code.
+const CRYPTO_CONSTRUCTION_ALLOWED: &[(&str, &str)] = &[
+    (
+        "maos-bin/src/crypto_provider.rs",
+        "the selection point (FR48 AC1)",
+    ),
+    (
+        "maos-kernel-core/src/security/crypto.rs",
+        "the provider's own module",
+    ),
+    ("maos-bench/src/", "benchmark harness, not a daemon root"),
+];
+
+fn crypto_provider_violations(crates: &std::path::Path) -> Vec<String> {
+    let mut files = Vec::new();
+    crate::fs_walk::collect_rs_files(crates, &mut files);
+    let mut violations = Vec::new();
+    for file in files {
+        let path = file.to_string_lossy().replace('\\', "/");
+        let Some(rel) = path.split("crates/").nth(1) else {
+            continue;
+        };
+        if !rel.contains("/src/")
+            || CRYPTO_CONSTRUCTION_ALLOWED
+                .iter()
+                .any(|(p, _)| rel.starts_with(p))
+        {
+            continue;
+        }
+        let Ok(text) = fs::read_to_string(&file) else {
+            continue;
+        };
+        // Production text ends at the first `#[cfg(test)]` / `#[cfg(all(test, …))]` module.
+        let production = test_module_re()
+            .find(&text)
+            .map_or(text.as_str(), |m| &text[..m.start()]);
+        for (line_no, line) in production.lines().enumerate() {
+            if line.contains("RingCryptoProvider")
+                && !line.trim_start().starts_with("//")
+                && !line.trim_start().starts_with("use ")
+                && !line.trim_start().starts_with("pub use ")
+                && !line.trim_end().ends_with(",")
+            {
+                violations.push(format!(
+                    "error: {rel}:{} constructs RingCryptoProvider outside the FR48 selection point (crates/maos-bin/src/crypto_provider.rs)",
+                    line_no + 1
+                ));
+            }
+        }
+    }
+    violations
+}
+
+fn test_module_re() -> &'static regex::Regex {
+    static RE: OnceLock<regex::Regex> = OnceLock::new();
+    RE.get_or_init(|| {
+        regex::Regex::new(
+            r"(?m)^\s*#\[cfg\((?:all\()?test[^\]]*\]\s*\n\s*(?:pub(?:\(crate\))? )?mod ",
+        )
+        .unwrap()
+    })
+}
