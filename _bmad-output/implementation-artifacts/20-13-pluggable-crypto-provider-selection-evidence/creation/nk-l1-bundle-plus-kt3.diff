+/// Story 20-13 (FR48) — record `[crypto] provider` (the one persisted
+/// selection `maos run` reads), replacing any previous `[crypto]` table.
+/// Returns the previously recorded name.
+fn record_crypto_provider(
+    config_path: &std::path::Path,
+    provider: &str,
+) -> Result<Option<String>, Box<dyn std::error::Error>> {
+    let text = std::fs::read_to_string(config_path)?;
+    let mut kept = String::with_capacity(text.len());
+    let (mut in_crypto, mut previous) = (false, None);
+    for line in text.lines() {
+        if line.starts_with('[') {
+            in_crypto = line.trim() == "[crypto]";
+        }
+        if in_crypto {
+            if let Some(value) = line.trim().strip_prefix("provider = ") {
+                previous = Some(value.trim_matches('"').to_owned());
+            }
+            continue;
+        }
+        kept.push_str(line);
+        kept.push('\n');
+    }
+    kept.push_str(&format!("\n[crypto]\nprovider = \"{provider}\"\n"));
+    let staged = config_path.with_extension("toml.tmp");
+    std::fs::write(&staged, kept)?;
+    std::fs::rename(&staged, config_path)?;
+    Ok(previous)
+}
