+//! Story 20-13 (FR48 / NFR-Sec-15 provider-trait half) — the crypto-provider
+//! selection point.
+//!
+//! `maos init --crypto-provider <name>` records `[crypto] provider` in the
+//! home's `config.toml`; `maos run` reads it once, constructs exactly one
+//! `Arc<dyn CryptoProvider>` from [`PROVIDERS`] and hands that instance to every
+//! FR48 consumer (capability tokens, CRL, T3 image lock, installed-package
+//! verification, at-rest seal). v1.0 ships `ring` only: pluggability, not
+//! FIPS validation (the validated module is v1.5).
+
+use maos_domain::ports::CryptoProvider;
+use std::path::Path;
+use std::sync::Arc;
+
+/// One constructible provider: the name the operator selects, the module
+/// version the boot journals, and its constructor.
+pub struct ProviderRow {
+    pub name: &'static str,
+    pub version: &'static str,
+    build: fn(&Path) -> Arc<dyn CryptoProvider>,
+}
+
+/// Every provider this build can construct; the first row is the default.
+pub const PROVIDERS: &[ProviderRow] = &[
+    ProviderRow {
+        name: "ring",
+        // Pinned to the locked `ring` (`Cargo.lock`); a test compares them.
+        version: "0.17.14",
+        build: |_| Arc::new(maos_kernel_core::security::crypto::RingCryptoProvider),
+    },
+    #[cfg(feature = "crypto-recording")]
+    ProviderRow {
+        name: "recording",
+        version: "test",
+        build: |home| Arc::new(recording::RecordingCryptoProvider::new(home)),
+    },
+];
+
+/// The boot's selection: identity plus the one shared instance.
+#[derive(Clone)]
+pub struct SelectedCrypto {
+    pub name: &'static str,
+    pub version: &'static str,
+    /// `true` when the home records no `[crypto]` table (homes initialised
+    /// before 20-13 boot on the default and the journal says so).
+    pub defaulted: bool,
+    pub provider: Arc<dyn CryptoProvider>,
+}
+
+/// The names this build accepts, for typed refusals.
+pub fn known_names() -> String {
+    PROVIDERS
+        .iter()
+        .map(|row| row.name)
+        .collect::<Vec<_>>()
+        .join(", ")
+}
+
+/// Refuse an unknown name with the known set (shared by init and boot).
+pub fn validate(name: &str) -> Result<&'static ProviderRow, String> {
+    PROVIDERS
+        .iter()
+        .find(|row| row.name == name)
+        .ok_or_else(|| {
+            format!(
+                "unknown crypto provider '{name}' (known: {})",
+                known_names()
+            )
+        })
+}
+
+/// Read the persisted selection and construct the instance.
+pub fn select(home: &Path) -> Result<SelectedCrypto, String> {
+    let path = home.join("config.toml");
+    let recorded = match std::fs::read_to_string(&path) {
+        Ok(text) => {
+            let document: toml::Value =
+                toml::from_str(&text).map_err(|e| format!("{}: {e}", path.display()))?;
+            match document.get("crypto").map(|table| table.get("provider")) {
+                None => None,
+                Some(Some(toml::Value::String(name))) => Some(name.clone()),
+                Some(_) => {
+                    return Err(format!(
+                        "{}: [crypto] provider must be a string",
+                        path.display()
+                    ))
+                }
+            }
+        }
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => None,
+        Err(e) => return Err(format!("{}: {e}", path.display())),
+    };
+    let defaulted = recorded.is_none();
+    let row = validate(recorded.as_deref().unwrap_or(PROVIDERS[0].name))?;
+    Ok(SelectedCrypto {
+        name: row.name,
+        version: row.version,
+        defaulted,
+        provider: (row.build)(home),
+    })
+}
+
+/// Journal the selection once at boot (FR48 AC3).
+pub fn journal(
+    transparency_log: &maos_kernel_core::iac::TransparencyLogAdapter,
+    selected: &SelectedCrypto,
+) {
+    let payload = serde_json::json!({
+        "provider": selected.name,
+        "version": selected.version,
+        "source": if selected.defaulted { "default" } else { "config" },
+    });
+    if let Ok(bytes) = serde_json::to_vec(&payload) {
+        let _ = transparency_log.insert_frame_event(
+            maos_kernel_core::iac::transparency_log::FrameKind::TelemetryEvent,
+            0,
+            None,
+            "crypto.provider.selected",
+            &bytes,
+            maos_domain::invariants::i3::FrameOrigin::Kernel,
+        );
+    }
+}
+
+#[cfg(feature = "crypto-recording")]
+mod recording {
+    #[cfg(not(debug_assertions))]
+    compile_error!("crypto-recording is dev/CI-only and MUST NOT ship in release builds");
+
+    use maos_domain::ports::crypto::{CryptoError, CryptoProvider};
+    use std::io::Write;
+    use std::path::{Path, PathBuf};
+
+    /// Test-only provider: delegates to `ring` and appends one line per call
+    /// to `<home>/crypto-recording.log`, so a hermetic test can prove routing.
+    #[derive(Debug)]
+    pub struct RecordingCryptoProvider {
+        log: PathBuf,
+        inner: maos_kernel_core::security::crypto::RingCryptoProvider,
+    }
+
+    impl RecordingCryptoProvider {
+        pub fn new(home: &Path) -> Self {
+            Self {
+                log: home.join("crypto-recording.log"),
+                inner: maos_kernel_core::security::crypto::RingCryptoProvider,
+            }
+        }
+
+        fn record(&self, op: &str) {
+            if let Ok(mut file) = std::fs::OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(&self.log)
+            {
+                let _ = writeln!(file, "{op}");
+            }
+        }
+    }
+
+    impl CryptoProvider for RecordingCryptoProvider {
+        fn verify_signature(&self, key: &[u8], msg: &[u8], sig: &[u8]) -> Result<(), CryptoError> {
+            self.record("verify_signature");
+            self.inner.verify_signature(key, msg, sig)
+        }
+
+        fn seal_for_export(
+            &self,
+            key: &[u8],
+            nonce: &[u8],
+            aad: &[u8],
+            plaintext: &[u8],
+        ) -> Result<Vec<u8>, CryptoError> {
+            self.record("seal_for_export");
+            self.inner.seal_for_export(key, nonce, aad, plaintext)
+        }
+
+        fn sign_capability_token(&self, key: &[u8], token: &[u8]) -> Result<Vec<u8>, CryptoError> {
+            self.record("sign_capability_token");
+            self.inner.sign_capability_token(key, token)
+        }
+    }
+}
