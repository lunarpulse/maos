             .map_err(|_| CryptoError::MalformedKey("Ed25519 seed must be 32 bytes"))?;
         Ok(keypair.sign(token_bytes).as_ref().to_vec())
     }
+
+    fn open_sealed(
+        &self,
+        sealing_key: &[u8],
+        nonce: &[u8],
+        aad: &[u8],
+        ciphertext: &[u8],
+    ) -> Result<Vec<u8>, CryptoError> {
+        let unbound = aead::UnboundKey::new(&aead::AES_256_GCM, sealing_key)
+            .map_err(|_| CryptoError::MalformedKey("AES-256-GCM key rejected by ring"))?;
+        let nonce = aead::Nonce::try_assume_unique_for_key(nonce)
+            .map_err(|_| CryptoError::OperationFailed("AES-GCM nonce must be 12 bytes"))?;
+        let mut in_out = ciphertext.to_vec();
+        let plaintext = aead::LessSafeKey::new(unbound)
+            .open_in_place(nonce, aead::Aad::from(aad), &mut in_out)
+            .map_err(|_| CryptoError::OperationFailed("AES-GCM open failed"))?;
+        Ok(plaintext.to_vec())
+    }
 }
 
