+#[test]
+fn barrier_probe_stale_clock_cannot_restore_filled_next_window() {
+    use maos_kernel_core::capability::cap_quota::IssuanceQuota;
+    use std::sync::Barrier;
+    use std::time::Duration;
+    let clock = Arc::new(ManualClock::default());
+    let tracker = CapQuotaTracker::with_clock(
+        IssuanceQuota {
+            budget_per_window: 2,
+            window: Duration::from_nanos(10),
+        },
+        clock.clone(),
+    );
+    tracker.commit(tracker.charge(PID).unwrap());
+    let barrier = Barrier::new(2);
+    std::thread::scope(|scope| {
+        let tracker = &tracker;
+        let clock = &clock;
+        let barrier = &barrier;
+        let delayed = scope.spawn(move || {
+            barrier.wait();
+            // This racing clock sample is older than the already-filled epoch.
+            clock.0.store(0, Ordering::SeqCst);
+            let exhausted = tracker.charge(PID).unwrap_err();
+            assert_eq!(exhausted.window, 1);
+        });
+        clock.0.store(10, Ordering::SeqCst);
+        for _ in 0..2 {
+            tracker.commit(tracker.charge(PID).unwrap());
+        }
+        barrier.wait();
+        delayed.join().unwrap();
+    });
+    assert!(tracker.charge(PID).is_err());
+}
