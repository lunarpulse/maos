+#[test]
+fn barrier_probe_out_of_order_commit_refund_pressure_once() {
+    use maos_kernel_core::capability::cap_quota::IssuanceQuota;
+    use std::sync::Barrier;
+    use std::time::Duration;
+    let tracker = CapQuotaTracker::with_clock(
+        IssuanceQuota {
+            budget_per_window: 20,
+            window: Duration::from_nanos(10),
+        },
+        Arc::new(ManualClock::default()),
+    );
+    for _ in 0..15 {
+        tracker.commit(tracker.charge(PID).unwrap());
+    }
+    let failed = tracker.charge(PID).unwrap();
+    let earlier = tracker.charge(PID).unwrap();
+    let later = tracker.charge(PID).unwrap();
+    let barrier = Barrier::new(2);
+    std::thread::scope(|scope| {
+        let tracker = &tracker;
+        let barrier = &barrier;
+        let worker = scope.spawn(move || {
+            let committed = tracker.commit(later);
+            assert_eq!(committed.issued, 16);
+            assert_eq!(committed.signals, [QuotaSignal::Pressure]);
+            barrier.wait();
+        });
+        barrier.wait();
+        tracker.refund(failed);
+        let committed = tracker.commit(earlier);
+        assert_eq!(committed.issued, 17);
+        assert!(committed.signals.is_empty());
+        worker.join().unwrap();
+    });
+    let committed = tracker.commit(tracker.charge(PID).unwrap());
+    assert_eq!(committed.issued, 18);
+    assert!(committed.signals.is_empty());
+}
