+//! Story 17-9 tracker behavior, using only the public reservation/commit API.
+use maos_capability::cap_quota::*;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Barrier};
+use std::time::Duration;
+#[derive(Debug, Default)]
+struct ManualClock(AtomicU64);
+impl ManualClock {
+    fn set(&self, ns: u64) {
+        self.0.store(ns, Ordering::SeqCst);
+    }
+}
+impl QuotaClock for ManualClock {
+    fn now_ns(&self) -> u64 {
+        self.0.load(Ordering::SeqCst)
+    }
+}
+fn tracker(budget: u64) -> (Arc<ManualClock>, CapQuotaTracker) {
+    let clock = Arc::new(ManualClock::default());
+    let tracker = CapQuotaTracker::with_clock(
+        IssuanceQuota {
+            budget_per_window: budget,
+            window: Duration::from_nanos(10),
+        },
+        clock.clone(),
+    );
+    (clock, tracker)
+}
+fn fill(t: &CapQuotaTracker, pid: u32, count: u64) {
+    for _ in 0..count {
+        t.commit(t.charge(pid).unwrap());
+    }
+}
+#[test]
+fn constructors_keep_the_named_default_and_explicit_quota() {
+    assert_eq!(
+        DEFAULT_ISSUANCE_QUOTA,
+        IssuanceQuota {
+            budget_per_window: 60_000,
+            window: Duration::from_secs(60)
+        }
+    );
+    assert_eq!(CapQuotaTracker::new().quota(), DEFAULT_ISSUANCE_QUOTA);
+    assert_eq!(CapQuotaTracker::default().quota(), DEFAULT_ISSUANCE_QUOTA);
+    let quota = IssuanceQuota {
+        budget_per_window: 7,
+        window: Duration::from_secs(3),
+    };
+    assert_eq!(CapQuotaTracker::with_quota(quota).quota(), quota);
+}
+#[test]
+#[should_panic(expected = "IssuanceQuota budget_per_window must be at least 1")]
+fn zero_budget_is_rejected() {
+    let _ = tracker(0);
+}
+#[test]
+#[should_panic(expected = "IssuanceQuota window must be at least 1 ns")]
+fn zero_window_is_rejected() {
+    CapQuotaTracker::with_quota(IssuanceQuota {
+        budget_per_window: 1,
+        window: Duration::ZERO,
+    });
+}
+#[test]
+fn one_nanosecond_windows_are_valid() {
+    let clock = Arc::new(ManualClock::default());
+    let t = CapQuotaTracker::with_clock(
+        IssuanceQuota {
+            budget_per_window: 1,
+            window: Duration::from_nanos(1),
+        },
+        clock.clone(),
+    );
+    assert_eq!(t.charge(7).unwrap().window(), 0);
+    clock.set(1);
+    assert_eq!(t.charge(7).unwrap().window(), 1);
+}
+#[test]
+fn thresholds_use_ceil_and_do_not_overflow_at_max_budget() {
+    let (_, t) = tracker(7);
+    for issued in 1..=7 {
+        let c = t.commit(t.charge(7).unwrap());
+        assert_eq!(
+            c.signals,
+            match issued {
+                6 => vec![QuotaSignal::Pressure],
+                7 => vec![QuotaSignal::Limit],
+                _ => vec![],
+            }
+        );
+    }
+    // Construction exercises the u128 threshold arithmetic without requiring
+    // u64::MAX issuances; small initial usage must not spuriously cross either.
+    let (_, t) = tracker(u64::MAX);
+    assert!(t.commit(t.charge(7).unwrap()).signals.is_empty());
+}
+#[test]
+fn capacity_is_inclusive_and_crossings_fire_once() {
+    let (_, t) = tracker(100);
+    for issued in 1..=100 {
+        let c = t.commit(t.charge(7).unwrap());
+        assert_eq!((c.window, c.issued), (0, issued));
+        assert_eq!(
+            c.signals,
+            match issued {
+                80 => vec![QuotaSignal::Pressure],
+                95 => vec![QuotaSignal::Limit],
+                _ => vec![],
+            }
+        );
+    }
+    assert_eq!(
+        t.charge(7).unwrap_err(),
+        Exhausted {
+            spirit_pid: 7,
+            window: 0,
+            first_in_window: true
+        }
+    );
+    assert!(!t.charge(7).unwrap_err().first_in_window);
+    assert_eq!(t.commit(t.charge(8).unwrap()).issued, 1);
+}
+#[test]
+fn small_budgets_can_fire_both_signals_in_order() {
+    for budget in [1, 2, 3] {
+        let (_, t) = tracker(budget);
+        fill(&t, 7, budget - 1);
+        assert_eq!(
+            t.commit(t.charge(7).unwrap()).signals,
+            [QuotaSignal::Pressure, QuotaSignal::Limit]
+        );
+        assert!(t.charge(7).is_err());
+    }
+}
+#[test]
+fn windows_tumble_on_exact_boundaries_and_skips_reset_state() {
+    let (clock, t) = tracker(2);
+    clock.set(9);
+    assert_eq!(t.charge(7).unwrap().window(), 0);
+    clock.set(10);
+    assert_eq!(t.commit(t.charge(7).unwrap()).issued, 1);
+    clock.set(19);
+    assert_eq!(t.commit(t.charge(7).unwrap()).issued, 2);
+    assert!(t.charge(7).unwrap_err().first_in_window);
+    clock.set(100);
+    let c = t.commit(t.charge(7).unwrap());
+    assert_eq!((c.window, c.issued), (10, 1));
+}
+#[test]
+fn rollover_rearms_both_thresholds_and_first_exhaustion() {
+    let (clock, t) = tracker(1);
+    for window in 0..3 {
+        clock.set(window * 10);
+        let c = t.commit(t.charge(7).unwrap());
+        assert_eq!((c.window, c.issued), (window, 1));
+        assert_eq!(c.signals, [QuotaSignal::Pressure, QuotaSignal::Limit]);
+        assert!(t.charge(7).unwrap_err().first_in_window);
+        assert!(!t.charge(7).unwrap_err().first_in_window);
+    }
+}
+#[test]
+fn refund_restores_capacity_without_counting_failed_crossings() {
+    let (_, t) = tracker(20);
+    fill(&t, 7, 15);
+    t.refund(t.charge(7).unwrap());
+    let c = t.commit(t.charge(7).unwrap());
+    assert_eq!(c.issued, 16);
+    assert_eq!(c.signals, [QuotaSignal::Pressure]);
+    fill(&t, 7, 2);
+    t.refund(t.charge(7).unwrap());
+    let c = t.commit(t.charge(7).unwrap());
+    assert_eq!(c.issued, 19);
+    assert_eq!(c.signals, [QuotaSignal::Limit]);
+    assert!(t.commit(t.charge(7).unwrap()).signals.is_empty());
+}
+#[test]
+fn non_crossing_refund_preserves_previously_fired_bits() {
+    let (_, t) = tracker(20);
+    let early = t.charge(7).unwrap();
+    fill(&t, 7, 16);
+    t.refund(early);
+    let c = t.commit(t.charge(7).unwrap());
+    assert_eq!(c.issued, 17);
+    assert!(c.signals.is_empty());
+}
+#[test]
+fn out_of_order_refund_does_not_rearm_a_committed_crossing() {
+    let (_, t) = tracker(20);
+    fill(&t, 7, 15);
+    let failed = t.charge(7).unwrap();
+    let later = t.charge(7).unwrap();
+    assert_eq!(t.commit(later).signals, [QuotaSignal::Pressure]);
+    t.refund(failed);
+    let c = t.commit(t.charge(7).unwrap());
+    assert_eq!(c.issued, 17);
+    assert!(c.signals.is_empty());
+}
+#[test]
+fn refund_preserves_the_exhaustion_notification_latch() {
+    let (_, t) = tracker(1);
+    let failed = t.charge(7).unwrap();
+    assert!(t.charge(7).unwrap_err().first_in_window);
+    t.refund(failed);
+    assert_eq!(
+        t.commit(t.charge(7).unwrap()).signals,
+        [QuotaSignal::Pressure, QuotaSignal::Limit]
+    );
+    assert!(!t.charge(7).unwrap_err().first_in_window);
+}
+#[test]
+fn refund_after_rollover_does_not_reduce_the_new_window() {
+    let (clock, t) = tracker(2);
+    let old = t.charge(7).unwrap();
+    clock.set(10);
+    fill(&t, 7, 1);
+    t.refund(old);
+    fill(&t, 7, 1);
+    assert!(t.charge(7).is_err());
+}
+#[test]
+fn refund_of_a_swept_slot_does_not_reinsert_it() {
+    let (clock, t) = tracker(1);
+    let old = t.charge(7).unwrap();
+    clock.set(10);
+    fill(&t, 8, 1);
+    t.refund(old);
+    assert_eq!(t.commit(t.charge(7).unwrap()).issued, 1);
+}
+#[test]
+fn stale_slot_is_reset_under_its_entry_lock() {
+    let (clock, t) = tracker(1);
+    fill(&t, 7, 1);
+    assert!(t.charge(7).unwrap_err().first_in_window);
+    clock.set(10);
+    let c = t.commit(t.charge(7).unwrap());
+    assert_eq!((c.window, c.issued), (1, 1));
+    assert_eq!(c.signals, [QuotaSignal::Pressure, QuotaSignal::Limit]);
+    assert!(t.charge(7).unwrap_err().first_in_window);
+}
+#[test]
+fn commit_after_rollover_is_a_noop() {
+    let (clock, t) = tracker(1);
+    let old = t.charge(7).unwrap();
+    clock.set(10);
+    let current = t.charge(7).unwrap();
+    let c = t.commit(old);
+    assert_eq!((c.window, c.issued), (0, 0));
+    assert!(c.signals.is_empty());
+    assert_eq!(t.commit(current).issued, 1);
+}
+#[test]
+fn concurrent_charges_cannot_oversubscribe_or_duplicate_signals() {
+    let (_, t) = tracker(1_000);
+    let barrier = Barrier::new(12);
+    let totals = std::thread::scope(|scope| {
+        let mut workers = Vec::new();
+        for _ in 0..12 {
+            let t = t.clone();
+            let barrier = &barrier;
+            workers.push(scope.spawn(move || {
+                let mut counts = [0u64; 4];
+                barrier.wait();
+                for _ in 0..200 {
+                    match t.charge(7) {
+                        Ok(charge) => {
+                            counts[0] += 1;
+                            for signal in t.commit(charge).signals {
+                                match signal {
+                                    QuotaSignal::Pressure => counts[1] += 1,
+                                    QuotaSignal::Limit => counts[2] += 1,
+                                    QuotaSignal::Exhausted => panic!("commit emitted exhaustion"),
+                                }
+                            }
+                        }
+                        Err(e) => counts[3] += u64::from(e.first_in_window),
+                    }
+                }
+                counts
+            }));
+        }
+        let mut total = [0; 4];
+        for worker in workers {
+            for (sum, count) in total.iter_mut().zip(worker.join().unwrap()) {
+                *sum += count;
+            }
+        }
+        total
+    });
+    assert_eq!(totals, [1_000, 1, 1, 1]);
+    assert!(t.charge(7).is_err());
+}
+#[test]
+fn concurrent_refunds_restore_all_reservations() {
+    let (_, t) = tracker(8);
+    let barrier = Barrier::new(16);
+    std::thread::scope(|scope| {
+        for _ in 0..16 {
+            let t = &t;
+            let barrier = &barrier;
+            scope.spawn(move || {
+                barrier.wait();
+                for _ in 0..100 {
+                    if let Ok(c) = t.charge(7) {
+                        t.refund(c);
+                    }
+                }
+            });
+        }
+    });
+    for issued in 1..=8 {
+        assert_eq!(t.commit(t.charge(7).unwrap()).issued, issued);
+    }
+    assert!(t.charge(7).is_err());
+}
+#[test]
+fn wide_duration_and_signal_intents_are_supported() {
+    let clock = Arc::new(ManualClock(AtomicU64::new(u64::MAX)));
+    let t = CapQuotaTracker::with_clock(
+        IssuanceQuota {
+            budget_per_window: 1,
+            window: Duration::from_secs(u64::MAX),
+        },
+        clock,
+    );
