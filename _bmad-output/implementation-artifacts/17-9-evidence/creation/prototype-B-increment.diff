new file mode 100644
index 0000000..85a1d4c
--- /dev/null
+++ b/crates/maos-bin/src/mcp_mint.rs
@@ -0,0 +1,60 @@
+//! Governed MCP minting with a durable refusal before the caller returns.
+
+use maos_domain::invariants::i1::{CapabilityToken, IntentClass, Scope};
+use maos_domain::invariants::i3::FrameOrigin;
+use maos_iac::adapter::transparency_log::{FrameKind, TransparencyLogAdapter};
+use maos_kernel_core::capability::CapabilityRegistryAdapter;
+
+use crate::enterprise_identity::EnterpriseRuntime;
+use crate::enterprise_pdp_runtime::EnterprisePdpRuntime;
+use crate::worker_spawn::{issue_enterprise_governed_capability, GovernedMintError};
+
+/// Mint for one MCP call, journaling exactly one capability-denied receipt on
+/// failure. The composition root supplies the trusted sender and current pid;
+/// no MCP request can choose either. The original typed mint error is preserved.
+#[allow(clippy::too_many_arguments)]
+pub fn mint_mcp_capability(
+    capability: &CapabilityRegistryAdapter,
+    enterprise: Option<&EnterpriseRuntime>,
+    pdp: Option<&EnterprisePdpRuntime>,
+    journal: &TransparencyLogAdapter,
+    spirit_id: &str,
+    spirit_pid: u32,
+    server: &str,
+    tool: &str,
+    posture_hash: [u8; 32],
+) -> Result<CapabilityToken, GovernedMintError> {
+    issue_enterprise_governed_capability(
+        capability,
+        enterprise,
+        pdp,
+        spirit_pid,
+        Scope::McpCall {
+            server: server.into(),
+            tool: tool.into(),
+        },
+        60,
+        posture_hash,
+        IntentClass::Standard,
+    )
+    .map_err(|error| {
+        #[derive(serde::Serialize)]
+        struct RefusalPayload<'a> {
+            server: &'a str,
+            tool: &'a str,
+        }
+        let payload = serde_json::to_vec(&RefusalPayload { server, tool })
+            .expect("MCP refusal receipt contains only serializable strings");
+        journal.insert_frame_event_with_sender(
+            FrameKind::GovernanceEvent,
+            spirit_pid,
+            spirit_id,
+            "",
+            None,
+            "mcp.call.refused:capability-denied",
+            &payload,
+            FrameOrigin::Kernel,
+        );
+        error
+    })
+}
