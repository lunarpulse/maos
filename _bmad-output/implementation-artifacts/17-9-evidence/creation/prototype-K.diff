@@ -0,0 +1,114 @@
+use maos_domain::{
+    invariants::{
+        i1::{IntentClass, Scope},
+        i9::SandboxTier,
+    },
+    ports::crypto::{CryptoError, CryptoProvider},
+};
+use maos_kernel_core::{
+    capability::{
+        cap_audit, cap_policy, cap_quota, cap_tokens, CapabilityRegistryAdapter, WorkingMemoryStore,
+    },
+    security::RingCryptoProvider,
+    telemetry::TelemetryStreamAdapter,
+};
+use std::{sync::Arc, time::Instant};
+struct Mock;
+impl CryptoProvider for Mock {
+    fn verify_signature(&self, _: &[u8], _: &[u8], _: &[u8]) -> Result<(), CryptoError> {
+        Ok(())
+    }
+    fn seal_for_export(
+        &self,
+        _: &[u8],
+        _: &[u8],
+        _: &[u8],
+        p: &[u8],
+    ) -> Result<Vec<u8>, CryptoError> {
+        Ok(p.to_vec())
+    }
+    fn sign_capability_token(&self, _: &[u8], token: &[u8]) -> Result<Vec<u8>, CryptoError> {
+        let mut sig = [0u8; 64];
+        for (i, b) in token.iter().enumerate() {
+            sig[i % 64] ^= *b;
+        }
+        Ok(sig.to_vec())
+    }
+}
+#[test]
+fn throughput() {
+    cap_tokens::init_monotonic_base();
+    for (name, crypto) in [
+        (
+            "Ring",
+            Arc::new(RingCryptoProvider) as Arc<dyn CryptoProvider>,
+        ),
+        ("Mock", Arc::new(Mock) as Arc<dyn CryptoProvider>),
+    ] {
+        let policy = cap_policy::PolicyTable::new();
+        let mut inner = cap_policy::PolicyTableInner::default();
+        inner.manifest_scopes.insert(
+            7,
+            cap_policy::ManifestCapabilityScope {
+                scopes: vec![Scope::FsRead {
+                    subtree: "/tmp".into(),
+                }],
+                declared_tier: SandboxTier(0),
+                trust_tier: cap_policy::decision::TrustTier::Verified,
+            },
+        );
+        policy.update(inner);
+        let (tx, mut rx) = cap_audit::channel();
+        let drain = std::thread::spawn(move || while rx.blocking_recv().is_some() {});
+        let quota = cap_quota::CapQuotaTracker::with_quota(cap_quota::IssuanceQuota {
+            budget_per_window: u64::MAX,
+            window: std::time::Duration::from_secs(3600),
+        });
+        let adapter = CapabilityRegistryAdapter::new(
+            crypto,
+            cap_tokens::Ed25519SigningKey::new([0; 32]),
+            7,
+            Arc::new(policy),
+            tx,
+            quota,
+            Arc::new(WorkingMemoryStore::new()),
+            Arc::new(TelemetryStreamAdapter::default()),
+        );
+        let start = Instant::now();
+        for _ in 0..200_000 {
+            std::hint::black_box(
+                adapter
+                    .issue_with_mediation(
+                        7,
+                        Scope::FsRead {
+                            subtree: "/tmp".into(),
+                        },
+                        60,
+                        [0; 32],
+                        IntentClass::Standard,
+                    )
+                    .unwrap(),
+            );
+        }
+        let elapsed = start.elapsed();
+        println!(
+            "PROTO_THROUGHPUT {name} count=200000 seconds={} ips={}",
+            elapsed.as_secs_f64(),
+            200000.0 / elapsed.as_secs_f64()
+        );
+        drop(adapter);
+        drain.join().unwrap();
+    }
+    let tracker = cap_quota::CapQuotaTracker::with_quota(cap_quota::IssuanceQuota {
+        budget_per_window: u64::MAX,
+        window: std::time::Duration::from_secs(3600),
+    });
+    let start = Instant::now();
+    for _ in 0..10_000_000 {
+        let _charge = std::hint::black_box(tracker.charge(7).unwrap());
+    }
+    println!(
+        "PROTO_CHARGE count=10000000 ns_per_op={}",
+        start.elapsed().as_nanos() as f64 / 10_000_000.0
+    );
+}
