diff --git a/crates/maos-kernel-core/tests/issuance_quota_window_17_9.rs b/crates/maos-kernel-core/tests/issuance_quota_window_17_9.rs
new file mode 100644
index 0000000..ed903e7
--- /dev/null
+++ b/crates/maos-kernel-core/tests/issuance_quota_window_17_9.rs
@@ -0,0 +1,252 @@
+//! Throwaway Story 17-9 AC1 sizing vector; isolated prototype only.
+//! Run with `--nocapture` to retain the measured end-to-end wall time.
+
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::Arc;
+use std::time::Instant;
+
+use maos_domain::invariants::i1::{IntentClass, Scope};
+use maos_domain::invariants::i3::FrameOrigin;
+use maos_domain::invariants::i9::SandboxTier;
+use maos_domain::ports::capability::CapError;
+use maos_domain::ports::crypto::{CryptoError, CryptoProvider};
+use maos_kernel_core::capability::{
+    cap_audit::{self, CapAuditEvent, CapAuditWriter},
+    cap_policy,
+    cap_quota::{CapQuotaTracker, QuotaClock, QuotaSignal, DEFAULT_ISSUANCE_QUOTA},
+    cap_tokens, CapabilityRegistryAdapter, WorkingMemoryStore,
+};
+use maos_kernel_core::iac::transparency_log::{FrameFilter, FrameKind, TransparencyLogAdapter};
+use maos_kernel_core::telemetry::TelemetryStreamAdapter;
+
+const PID: u32 = 7;
+const SIGN_FAILURE: &str = "17-9 requested signing failure";
+
+#[derive(Debug, Default)]
+struct ManualClock(AtomicU64);
+
+impl QuotaClock for ManualClock {
+    fn now_ns(&self) -> u64 {
+        self.0.load(Ordering::SeqCst)
+    }
+}
+
+#[derive(Default)]
+struct FailOnDemandCrypto {
+    fail_next: AtomicBool,
+}
+
+impl CryptoProvider for FailOnDemandCrypto {
+    fn verify_signature(&self, _pk: &[u8], _msg: &[u8], _sig: &[u8]) -> Result<(), CryptoError> {
+        Ok(())
+    }
+
+    fn seal_for_export(
+        &self,
+        _key: &[u8],
+        _nonce: &[u8],
+        _aad: &[u8],
+        plaintext: &[u8],
+    ) -> Result<Vec<u8>, CryptoError> {
+        Ok(plaintext.to_vec())
+    }
+
+    fn sign_capability_token(
+        &self,
+        _key: &[u8],
+        token_bytes: &[u8],
+    ) -> Result<Vec<u8>, CryptoError> {
+        if self.fail_next.swap(false, Ordering::SeqCst) {
+            return Err(CryptoError::OperationFailed(SIGN_FAILURE));
+        }
+        let mut signature = [0u8; 64];
+        for (index, byte) in token_bytes.iter().enumerate() {
+            signature[index % 64] ^= byte;
+        }
+        Ok(signature.to_vec())
+    }
+}
+
+fn issue(adapter: &CapabilityRegistryAdapter, scope: Scope) -> Result<(), CapError> {
+    adapter
+        .issue_with_mediation(PID, scope, 60, [1u8; 32], IntentClass::Standard)
+        .map(|_| ())
+}
+
+fn allowed_scope() -> Scope {
+    Scope::FsRead {
+        subtree: "/tmp".into(),
+    }
+}
+
+fn assert_policy_denied(adapter: &CapabilityRegistryAdapter) {
+    assert_eq!(
+        // Policy matches manifest scope variants, not FsRead subtree values.
+        // LoomWrite has a valid intent but is absent from this PID's manifest.
+        issue(adapter, Scope::LoomWrite),
+        Err(CapError::PolicyDenied),
+    );
+}
+
+fn drain_quota(
+    receiver: &mut tokio::sync::mpsc::Receiver<CapAuditEvent>,
+    quota_events: &mut Vec<CapAuditEvent>,
+) {
+    while let Ok(event) = receiver.try_recv() {
+        if matches!(&event, CapAuditEvent::Quota { .. }) {
+            quota_events.push(event);
+        }
+    }
+}
+
+#[tokio::test]
+async fn ac1_default_capacity_refunds_and_tokenless_quota_audit_in_two_windows() {
+    let started = Instant::now();
+    cap_tokens::init_monotonic_base();
+    assert_eq!(DEFAULT_ISSUANCE_QUOTA.budget_per_window, 60_000);
+    assert_eq!(DEFAULT_ISSUANCE_QUOTA.window.as_secs(), 60);
+    let clock = Arc::new(ManualClock::default());
+    let crypto = Arc::new(FailOnDemandCrypto::default());
+    let policy = cap_policy::PolicyTable::new();
+    let mut inner = cap_policy::PolicyTableInner::default();
+    inner.manifest_scopes.insert(
+        PID,
+        cap_policy::ManifestCapabilityScope {
+            scopes: vec![allowed_scope()],
+            declared_tier: SandboxTier(0),
+            trust_tier: cap_policy::decision::TrustTier::Verified,
+        },
+    );
+    policy.update(inner);
+    let (audit, mut receiver) = cap_audit::channel();
+    let adapter = CapabilityRegistryAdapter::new(
+        crypto.clone(),
+        cap_tokens::Ed25519SigningKey::new([0u8; 32]),
+        0x17_09,
+        Arc::new(policy),
+        audit,
+        CapQuotaTracker::with_clock(DEFAULT_ISSUANCE_QUOTA, clock.clone()),
+        Arc::new(WorkingMemoryStore::new()),
+        Arc::new(TelemetryStreamAdapter::default()),
+    );
+    let mut quota_events = Vec::new();
+
+    for window in 0..2u64 {
+        clock.0.store(
+            window * DEFAULT_ISSUANCE_QUOTA.window.as_nanos() as u64,
+            Ordering::SeqCst,
+        );
+        let mut successes = 0;
+        for ordinal in 1..=60_000u64 {
+            // Denials interleave with allowed requests but must not steal capacity.
+            if ordinal % 10_000 == 0 {
+                assert_policy_denied(&adapter);
+                drain_quota(&mut receiver, &mut quota_events);
+            }
+            // A failed crossing must neither consume capacity nor emit a signal.
+            // Exercise both threshold refunds and the final inclusive capacity slot.
+            if matches!(ordinal, 48_000 | 57_000 | 60_000) {
+                let before = quota_events.len();
+                crypto.fail_next.store(true, Ordering::SeqCst);
+                assert_eq!(
+                    issue(&adapter, allowed_scope()),
+                    Err(CapError::CryptoFailed(CryptoError::OperationFailed(
+                        SIGN_FAILURE
+                    ))),
+                );
+                assert!(!crypto.fail_next.load(Ordering::SeqCst));
+                drain_quota(&mut receiver, &mut quota_events);
+                assert_eq!(
+                    quota_events.len(),
+                    before,
+                    "failed issuance emitted quota audit"
+                );
+            }
+            issue(&adapter, allowed_scope()).expect("all 60,000 capacity slots must succeed");
+            successes += 1;
+            // Drain synchronously after every request: no racing consumer or audit drops.
+            drain_quota(&mut receiver, &mut quota_events);
+        }
+        assert_eq!(successes, 60_000);
+        // Policy still wins over exhaustion, including when the budget is full.
+        assert_policy_denied(&adapter);
+        for _ in 0..3 {
+            assert_eq!(
+                issue(&adapter, allowed_scope()),
+                Err(CapError::ContextExhausted { spirit_id: PID }),
+            );
+            drain_quota(&mut receiver, &mut quota_events);
+        }
+        let actual: Vec<_> = quota_events
+            .iter()
+            .filter_map(|event| match event {
+                CapAuditEvent::Quota {
+                    spirit_pid,
+                    signal,
+                    window: event_window,
+                    used,
+                    budget,
+                } if *event_window == window => {
+                    assert_eq!(*spirit_pid, PID);
+                    assert_eq!(*budget, 60_000);
+                    Some((*signal, *used))
+                }
+                _ => None,
+            })
+            .collect();
+        assert_eq!(
+            actual,
+            vec![
+                (QuotaSignal::Pressure, 48_000),
+                (QuotaSignal::Limit, 57_000),
+                (QuotaSignal::Exhausted, 60_000),
+            ],
+            "each window must emit each threshold/refusal exactly once",
+        );
+    }
+    assert_eq!(quota_events.len(), 6);
+    drop(adapter);
+
+    // Feed the six REAL adapter events (not fabricated quota fixtures) through
+    // the production writer into SQLite's in-memory Transparency Log.
+    let log = Arc::new(TransparencyLogAdapter::open_in_memory(0x17_09));
+    let (writer_sender, writer_receiver) = cap_audit::channel();
+    let writer = CapAuditWriter::spawn(writer_receiver, log.clone());
+    for event in quota_events {
+        writer_sender
+            .send(event)
+            .await
+            .expect("writer remains live");
+    }
+    drop(writer_sender);
+    writer.await.expect("writer drains to channel closure");
+    let rows = log
+        .query_frames(FrameFilter {
+            order_by_insertion: true,
+            ..FrameFilter::default()
+        })
+        .expect("read the in-memory TL");
+    assert_eq!(rows.len(), 6);
+    let expected_intents = [
+        "cap.quota.pressure",
+        "cap.quota.limit",
+        "cap.quota.exhausted",
+        "cap.quota.pressure",
+        "cap.quota.limit",
+        "cap.quota.exhausted",
+    ];
+    for (row, expected_intent) in rows.iter().zip(expected_intents) {
+        assert_eq!(row.intent, expected_intent);
+        assert_eq!(row.spirit_pid, PID);
+        assert_eq!(row.kind, FrameKind::CapabilityInvocation);
+        assert_eq!(row.origin, FrameOrigin::Kernel);
+        assert_eq!(
+            row.capability_token, None,
+            "quota SQL token column must be NULL"
+        );
+    }
+    eprintln!(
+        "17-9 AC1: 120000 successful issuances, 2 manual windows, 6 quota rows; wall={:?}",
+        started.elapsed()
+    );
+}
