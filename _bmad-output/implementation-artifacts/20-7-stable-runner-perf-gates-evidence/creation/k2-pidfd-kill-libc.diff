+/// `pidfd_send_signal(2)` SIGKILL; needs no container-runtime lock.
+#[doc(hidden)]
+pub fn pidfd_kill(pidfd: std::os::fd::BorrowedFd<'_>) -> io::Result<()> {
+    // SAFETY: pidfd_send_signal(2) takes a borrowed descriptor, a signal
+    // number, a null siginfo pointer and zero flags by value; it reads no
+    // caller memory.
+    let rc = unsafe {
+        libc::syscall(
+            libc::SYS_pidfd_send_signal,
+            pidfd.as_raw_fd(),
+            libc::SIGKILL,
+            std::ptr::null::<libc::siginfo_t>(),
+            0,
+        )
+    };
+    if rc < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
