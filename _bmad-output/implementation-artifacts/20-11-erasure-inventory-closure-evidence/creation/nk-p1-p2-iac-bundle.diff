+    /// EC-13: run `sql` over consecutive stable-rowid windows of
+    /// [`FORGET_SCAN_PAGE`] rows, taking the log lock per window only, so a
+    /// large log never stalls log-before-deliver writers for a whole scan.
+    /// `sql` binds `?1` = principal, `?2`/`?3` = the exclusive/inclusive rowid
+    /// bounds; rows appended during the scan are reached by later windows.
+    fn scan_rowid_windows(
+        &self,
+        sql: &str,
+        principal: Option<&str>,
+        mut each: impl FnMut(&rusqlite::Row<'_>) -> Result<(), AuditError>,
+    ) -> Result<(), AuditError> {
+        let mut after = 0_i64;
+        loop {
+            let inner = self
+                .inner
+                .lock()
+                .expect("TransparencyLogAdapter inner poisoned");
+            let last: i64 = inner
+                .conn
+                .query_row(
+                    "SELECT coalesce(max(rowid), 0) FROM transparency_log",
+                    [],
+                    |row| row.get(0),
+                )
+                .map_err(AuditError::SqliteRead)?;
+            if after >= last {
+                return Ok(());
+            }
+            let upto = after.saturating_add(FORGET_SCAN_PAGE);
+            let mut stmt = inner
+                .conn
+                .prepare_cached(sql)
+                .map_err(AuditError::SqliteRead)?;
+            let mut rows = stmt
+                .query(rusqlite::params![principal, after, upto])
+                .map_err(AuditError::SqliteRead)?;
+            while let Some(row) = rows.next().map_err(AuditError::SqliteRead)? {
+                each(row)?;
+            }
+            after = upto;
+        }
+    }
