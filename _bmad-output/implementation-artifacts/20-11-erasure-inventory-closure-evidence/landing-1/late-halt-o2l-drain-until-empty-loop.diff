+/// Story 20-11 (D-20-11-11) — the per-halt arm of the single receipt writer,
+/// also used for halts drained after `terminate_spirit` (unload's last drain).
+pub(crate) fn receipt_drained(
+    tl: &TransparencyLogAdapter,
+    pending: Vec<(HaltId, HaltState)>,
+    spirit_pid: u32,
+    kind_str: &str,
+    boot_nonce: u64,
+) -> Vec<HaltReceipt> {
+    let timestamp_ns = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_nanos() as u64;
+    let mut receipts = Vec::with_capacity(pending.len());
+    for (halt_id, _state) in pending {
+        tl.insert_frame_event(
+            FrameKind::EpistemicHalt,
+            spirit_pid,
+            None,
+            kind_str,
+            &[],
+            FrameOrigin::Kernel,
+        );
+        let frame_id = tl.last_frame_id();
+
