+    /// Remove the operator-installed generation inventory, not registry inbox
+    /// publications. A missing package is observed empty without creating a root.
+    pub fn uninstall_package(spirit_id: &str) -> Result<bool, StorageError> {
+        path_segment(spirit_id)?;
+        let root = Self::default_root();
+        let mut installs = Self::load_installs(&root)?;
+        if !installs.contains_key(spirit_id) { return Ok(false); }
+        // Validate the stored generation path before any filesystem mutation.
+        Self::installed_manifests_at(&root)?;
+        let directory = root.join("installed").join(spirit_id);
+        match fs::remove_dir_all(&directory) {
+            Ok(()) => {}
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+            Err(error) => return Err(StorageError::Io(error.to_string())),
+        }
+        installs.remove(spirit_id);
+        write_json_atomic(&root.join("installed-index.json"), &installs)?;
+        Ok(true)
+    }
