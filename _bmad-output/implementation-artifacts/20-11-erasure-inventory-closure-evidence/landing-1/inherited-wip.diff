+    /// Stable rowid windows bound each forget scan's TL lock hold. Appends
+    /// committed before a later window are included; receipt order is sorted below.
+    fn scan_rowid_windows(
+        &self,
+        sql: &str,
+        principal: Option<&str>,
+        mut each: impl FnMut(&rusqlite::Row<'_>) -> Result<(), AuditError>,
+    ) -> Result<(), AuditError> {
+        const FORGET_SCAN_PAGE: i64 = 4096;
+        let mut after = 0_i64;
+        loop {
+            let inner = self.inner.lock().expect("TransparencyLogAdapter inner poisoned");
+            let last: i64 = inner.conn.query_row(
+                "SELECT coalesce(max(rowid), 0) FROM transparency_log", [], |row| row.get(0),
+            ).map_err(AuditError::SqliteRead)?;
+            if after >= last { return Ok(()); }
+            let upto = after.saturating_add(FORGET_SCAN_PAGE);
+            let mut stmt = inner.conn.prepare_cached(sql).map_err(AuditError::SqliteRead)?;
+            let mut rows = stmt.query(rusqlite::params![principal, after, upto]).map_err(AuditError::SqliteRead)?;
+            while let Some(row) = rows.next().map_err(AuditError::SqliteRead)? { each(row)?; }
+            after = upto;
+        }
+    }
