+        match bridge.poll_frame(Duration::from_millis(50)).unwrap() {
+            BridgePoll::Data(SubStream::Stdout, bytes) => {
+                if let Some(line) = String::from_utf8_lossy(&bytes).strip_prefix("DESCENDANT ")
