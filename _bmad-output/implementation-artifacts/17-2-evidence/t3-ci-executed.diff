+name: 17-2 native containment proof
+on:
+  push:
+    branches: ['ci/17-2-native-proof']
+permissions:
+  contents: read
+jobs:
+  native-proof:
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-24.04, ubuntu-26.04]
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@stable
+      - uses: Swatinem/rust-cache@v2
+      - name: Provision signed T3 image
+        uses: ./.github/actions/provision-t3-test-substrate
+      - name: Build production maos and real Worker fixture
+        shell: bash
+        run: |
+          set -euo pipefail
+          cargo build --locked -p maos-bin --features network,wasm-host --bin maos
+          cargo build --locked -p worker --bin worker-cli-fixture
+      - name: Run limited real rootless T3 canary and focused T3 integration
+        shell: bash
+        run: |
+          set -euo pipefail
+          unit=maos-17-2-worker-proof
+          trap 'sudo systemctl stop "$unit.service" || true' EXIT
+          set +e
+          sudo systemd-run --unit="$unit" --uid="$(id -u)" --gid="$(id -g)" --working-directory="$GITHUB_WORKSPACE" \
+            --property=Delegate=yes --property=RuntimeMaxSec=1500 --property=TimeoutStopSec=10 \
+            --wait --pipe --collect --expand-environment=no \
+            env PATH="$PATH" HOME="$HOME" CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" \
+            RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}" \
+            CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$GITHUB_WORKSPACE/target}" \
+            CI=true GITHUB_ACTIONS=true MAOS_SECRETS_BACKEND=env \
+            MAOS_T3_RUNTIME="$MAOS_T3_RUNTIME" \
+            MAOS_T3_IMAGE_LOCK_PATH="$MAOS_T3_IMAGE_LOCK_PATH" \
+            MAOS_T3_IMAGE_TRUST_ANCHOR_PUB_HEX="$MAOS_T3_IMAGE_TRUST_ANCHOR_PUB_HEX" \
+            ${XDG_RUNTIME_DIR:+XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR"} \
+            ${DBUS_SESSION_BUS_ADDRESS:+DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS"} \
+            bash -c '
+              set -euo pipefail
+              test "$(id -u)" -ne 0
+              cgroup=$(cut -d: -f3 /proc/self/cgroup)
+              test "$cgroup" = /system.slice/maos-17-2-worker-proof.service
+              test "$(systemctl show maos-17-2-worker-proof.service -p Delegate --value)" = yes
+              root=/sys/fs/cgroup$cgroup
+              for controller in cpu memory pids; do
+                case " $(cat "$root/cgroup.controllers") " in
+                  *" $controller "*) ;;
+                  *) echo "missing controller: $controller" >&2; exit 1 ;;
+                esac
+              done
+              mkdir "$root/daemon"
+              test "$$" = "$BASHPID"
+              printf "%s\n" "$$" > "$root/daemon/cgroup.procs"
+              printf "+cpu +memory +pids\n" > "$root/cgroup.subtree_control"
+              cargo test --locked -p maos-bin --features network,wasm-host --test smoke_cli_wrapper_8_12 maos_run_cli_wrapper_worker_spawns_real_subprocess -- --exact --nocapture
+              cargo test --locked -p maos-bin --features network,wasm-host --test worker_resource_limits_17_2 -- --nocapture
+            ' 2>&1 | tee worker-proof.log
+          result=${PIPESTATUS[0]}
+          set -e
+          python3 -c 'import re,sys; s=open("worker-proof.log").read(); code=int(sys.argv[1]); reports=[tuple(map(int,r)) for r in re.findall(r"test result: (?:ok|FAILED)\. (\d+) passed; (\d+) failed; (\d+) ignored",s)]; good=code==0 and len(reports)==2 and all(p>0 and f==0 and i==0 for p,f,i in reports) and not re.search(r"(?m)^SKIP ",s); detail="\n".join(s.splitlines()[-100:])[-2800:].replace("%","%25").replace("\r","%0D").replace("\n","%0A"); kind="notice" if good else "error"; print("::"+kind+" title=17-2 Worker proof::runner=${{ matrix.os }} exit="+str(code)+" suites="+str(reports)+"; real rootless Worker%0A"+detail); sys.exit(0 if good else 1)' "$result"
+          exit "$result"
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: worker-proof-${{ matrix.os }}
+          path: worker-proof.log
