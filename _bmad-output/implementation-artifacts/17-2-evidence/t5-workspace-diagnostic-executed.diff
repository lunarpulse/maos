+            "FAMILY": "${{ matrix.family }}",
+            "MODE": "${{ matrix.mode }}"
+          },
+          "run": "set -euo pipefail\nhelper=scripts/run_cgroup_ceiling_17_2.py\ncanary=()\ncase \"$FAMILY\" in\n native) command=(cargo test --locked --offline -p maos-kernel-core --test cgroup_ceiling_smoke native_child_is_placed_before_guest_and_resource_limits_bite -- --exact --nocapture --test-threads=1); oracle=native_child_is_placed_before_guest_and_resource_limits_bite;;\n producer) command=(cargo test --locked --offline -p maos-bin --features network,wasm-host --test spawned_scope_17_3c resource_downgrade_memory_only_is_persisted_for_each_fast_t2_restart -- --exact --nocapture --test-threads=1); oracle=resource_downgrade_memory_only_is_persisted_for_each_fast_t2_restart;;\n worker) command=(cargo test --locked --offline -p maos-bin --features network,wasm-host --test worker_resource_limits_17_2 real_maos_worker_applies_independent_t3_limits_and_observes_exhaustion -- --exact --nocapture --test-threads=1); oracle=real_maos_worker_applies_independent_t3_limits_and_observes_exhaustion; canary=(--rootless-canary);;\n *) exit 2;;\nesac\nprintf 'MUTATION-COMMAND baseline=%q ' \"${command[@]}\"; printf '\\n'\nset +e\npython3 \"$helper\" run --mode \"$MODE\" --unit \"maos-17-2-control-$MUTATION\" --timeout 1500 \"${canary[@]}\" -- \"${command[@]}\" 2>&1 | tee baseline.log\nbaseline_rc=${PIPESTATUS[0]}\nset -e\nexpected=(--expected-count 1)\nif [ \"$FAMILY\" = worker ]; then expected+=(--expected-count 1); fi\npython3 \"$helper\" check-log --exit-code \"$baseline_rc\" \"${expected[@]}\" baseline.log\ngit apply --check \".github/17-2-mutations/$MUTATION.patch\"\ngit apply \".github/17-2-mutations/$MUTATION.patch\"\nprintf 'MUTATION-APPLIED %s sha256=' \"$MUTATION\"; sha256sum \".github/17-2-mutations/$MUTATION.patch\"\nset +e\npython3 \"$helper\" run --mode \"$MODE\" --unit \"maos-17-2-mutant-$MUTATION\" --timeout 1500 \"${canary[@]}\" -- \"${command[@]}\" 2>&1 | tee mutant.log\nmutant_rc=${PIPESTATUS[0]}\nset -e\npython3 - \"$mutant_rc\" \"$baseline_rc\" \"$IMAGE\" \"$MUTATION\" \"$FAMILY\" \"$oracle\" <<'PY'\nimport hashlib,json,pathlib,re,sys\nrc,baseline_rc,image,mutation,family,oracle=sys.argv[1:]\ntext=pathlib.Path('mutant.log').read_text(errors='replace')\nsuites=re.findall(r'test result: (ok|FAILED)\\. (\\d+) passed; (\\d+) failed; (\\d+) ignored;',text)\nexpected=[('FAILED','0','1','0')]\nif family=='worker':expected.insert(0,('ok','1','0','0'))\ncauses={'lose-pids-max':('left: \"max\"','right: \"12\"'),'ignore-worker-resources':('actual OCI memory limit',),'cpu-percent-as-cores':('actual OCI CPU ceiling is not exactly 0.10 cores',),'fd-aliased-to-pids':('PID cap must not alias FD cap',),'suppress-downgrade-producer':('successful fallback is recorded once per spawn',)}\nvalid=rc=='101' and baseline_rc=='0' and suites==expected and oracle in text and all(cause in text for cause in causes[mutation]) and not re.search(r'^SKIP\\b',text,re.M)\npatch=pathlib.Path('.github/17-2-mutations')/(mutation+'.patch')\nproof={'runner':image,'mutation':mutation,'baseline_exit':int(baseline_rc),'mutant_exit':int(rc),'suites':suites,'oracle':oracle,'causes':causes[mutation],'patch_sha256':hashlib.sha256(patch.read_bytes()).hexdigest(),'proven_red':valid}\npathlib.Path('mutation-proof.json').write_text(json.dumps(proof,indent=2)+'\\n')\nmessage=json.dumps(proof).replace('%','%25').replace('\\n','%0A')\nprint(f'::{\"notice\" if valid else \"error\"} title=17-2 mutation proof::{message}')\nlines=text.splitlines()\nfor i,line in enumerate(lines):\n if 'panicked at' in line:\n  excerpt='\\n'.join(lines[i:i+12])[:2300].replace('%','%25').replace('\\r','').replace('\\n','%0A')\n  print(f'::notice title=17-2 mutant actual panic::{excerpt}')\nassert valid,'control did not produce its genuine expected consumer-visible assertion failure'\nPY\n"
+        },
