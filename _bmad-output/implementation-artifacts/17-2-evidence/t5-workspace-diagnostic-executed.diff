+        {
+          "name": "Fetch locked dependencies and fixture assembler",
+          "run": "cargo fetch --locked\nfor fixture in crates/maos-wasm-host/guests/echo-spirit crates/maos-wasm-host/guests/routed-relay crates/maos-wasm-host/guests/equiv-fixture/native-twin; do\n  cargo fetch --locked --manifest-path \"$fixture/Cargo.toml\"\ndone\ncargo install --locked wasm-tools --version 1.259.0\n",
+          "if": "${{ matrix.family == 'producer' }}"
+        },
+        {
+          "name": "Compile the actual production runner and session surface",
+          "run": "cargo test --locked --offline -p maos-bin --features network,wasm-host --test spawned_scope_17_3c --no-run\ncargo build --locked --offline --release -p maos-wasm-host --bin maos-wasm-runner\ncargo build --locked --offline -p maos-cli --bin maosctl\nfor fixture in echo-spirit routed-relay; do\n  cargo build --locked --offline --release --manifest-path \"crates/maos-wasm-host/guests/$fixture/Cargo.toml\" --target wasm32-wasip2 --target-dir \"${CARGO_TARGET_DIR:-$PWD/target}\"\ndone\ncargo build --locked --offline --release --manifest-path crates/maos-wasm-host/guests/equiv-fixture/native-twin/Cargo.toml --target-dir \"${CARGO_TARGET_DIR:-$PWD/target}\"\n",
+          "if": "${{ matrix.family == 'producer' }}"
