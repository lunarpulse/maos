+{
+  "name": "17-2 actual permanent cgroup jobs and workspace envelope",
+  "on": {
+    "push": {
+      "branches": [
+        "ci/17-2-ci-enforcement"
+      ],
+      "paths": [
+        ".github/workflows/17-2-ci-acceptance.yml",
+        ".github/workflows/discipline.yml",
+        "scripts/run_cgroup_ceiling_17_2.py",
+        "scripts/tests/test_cgroup_ceiling_17_2.py",
+        "xtask/tests/cgroup_ceiling_workflow_17_2.rs"
+      ]
+    }
+  },
+  "permissions": {
+    "contents": "read"
+  },
+  "env": {
+    "CARGO_TERM_COLOR": "always",
+    "TOKEI_VERSION": "14.0.0",
+    "CARGO_DENY_VERSION": "0.19.4",
+    "CARGO_PUBLIC_API_VERSION": "0.51.0",
+    "MAOS_SECRETS_BACKEND": "env",
+    "CARGO_NET_RETRY": "10"
+  },
+  "jobs": {
+    "cgroup-ceiling-delegated": {
+      "strategy": {
+        "fail-fast": false,
+        "matrix": {
+          "image": [
+            "ubuntu-24.04",
+            "ubuntu-26.04",
+            "ubuntu-24.04-arm",
+            "ubuntu-26.04-arm"
+          ]
+        }
+      },
+      "runs-on": "${{ matrix.image }}",
+      "timeout-minutes": 60,
+      "steps": [
+        {
+          "uses": "actions/checkout@v5"
+        },
+        {
+          "uses": "dtolnay/rust-toolchain@v1",
+          "with": {
+            "toolchain": "stable",
+            "targets": "wasm32-wasip2"
+          }
+        },
+        {
+          "uses": "Swatinem/rust-cache@v2",
+          "with": {
+            "key": "cgroup-ceiling-${{ matrix.image }}-${{ hashFiles('**/Cargo.lock') }}"
+          }
+        },
+        {
+          "uses": "./.github/actions/provision-t3-test-substrate",
+          "if": "${{ !endsWith(matrix.image, '-arm') }}"
+        },
+        {
+          "name": "Install pinned WASM fixture assembler",
+          "run": "cargo install --locked wasm-tools --version 1.259.0"
+        },
+        {
+          "name": "Fetch locked standalone fixture dependencies for offline session tests",
+          "run": "cargo fetch --locked\nfor fixture in \\\n  crates/maos-wasm-host/guests/echo-spirit \\\n  crates/maos-wasm-host/guests/routed-relay \\\n  crates/maos-wasm-host/guests/equiv-fixture/native-twin; do\n  cargo fetch --locked --manifest-path \"$fixture/Cargo.toml\"\ndone\n"
+        },
+        {
+          "name": "Exercise helper boundary regressions",
+          "run": "python3 -m unittest scripts.tests.test_cgroup_ceiling_17_2"
+        },
+        {
+          "name": "Native cgroup-v2 smoke — four real cases",
+          "shell": "bash",
+          "run": "set -o pipefail\npython3 scripts/run_cgroup_ceiling_17_2.py run --mode delegated --unit maos-17-2-delegated --timeout 1800 -- \\\n  bash -euo pipefail -c 'cargo test --locked -p maos-kernel-core --test cgroup_ceiling_smoke -- --nocapture --test-threads=1 2>&1 | tee cgroup-smoke.log; test ${PIPESTATUS[0]} -eq 0'\npython3 scripts/run_cgroup_ceiling_17_2.py check-log --exit-code 0 --expected-count 4 cgroup-smoke.log\n"
+        },
+        {
+          "name": "Real admitted session suite — 22 cases, serial",
+          "shell": "bash",
+          "run": "set -o pipefail\npython3 scripts/run_cgroup_ceiling_17_2.py run --mode delegated --unit maos-17-2-delegated --timeout 2400 -- \\\n  bash -euo pipefail -c 'cargo test --locked -p maos-bin --features network,wasm-host --test spawned_scope_17_3c -- --nocapture --test-threads=1 2>&1 | tee spawned-17-3c.log; test ${PIPESTATUS[0]} -eq 0'\npython3 scripts/run_cgroup_ceiling_17_2.py check-log --exit-code 0 --expected-count 22 spawned-17-3c.log\n"
+        },
+        {
+          "name": "Build the actual Worker CLI fixture before the in-unit canary (x64)",
+          "if": "${{ !endsWith(matrix.image, '-arm') }}",
+          "run": "cargo build --locked -p worker --bin worker-cli-fixture"
+        },
+        {
+          "name": "Rootless T3 Worker resource enforcement (x64)",
+          "if": "${{ !endsWith(matrix.image, '-arm') }}",
+          "shell": "bash",
+          "run": "set -o pipefail\npython3 scripts/run_cgroup_ceiling_17_2.py run --mode delegated --unit maos-17-2-delegated --timeout 1800 --rootless-canary -- \\\n  bash -euo pipefail -c 'cargo test --locked -p maos-bin --features network,wasm-host --test worker_resource_limits_17_2 -- --nocapture --test-threads=1 2>&1 | tee worker-resource.log; test ${PIPESTATUS[0]} -eq 0'\npython3 scripts/run_cgroup_ceiling_17_2.py check-log --exit-code 0 --expected-count 2 worker-resource.log\n"
+        }
+      ]
+    },
+    "cgroup-ceiling-undelegated": {
+      "strategy": {
+        "fail-fast": false,
+        "matrix": {
+          "image": [
+            "ubuntu-24.04",
+            "ubuntu-26.04",
+            "ubuntu-24.04-arm",
+            "ubuntu-26.04-arm"
+          ]
+        }
+      },
+      "runs-on": "${{ matrix.image }}",
+      "timeout-minutes": 45,
+      "steps": [
+        {
+          "uses": "actions/checkout@v5"
+        },
+        {
+          "uses": "dtolnay/rust-toolchain@v1",
+          "with": {
+            "toolchain": "stable",
+            "targets": "wasm32-wasip2"
+          }
+        },
+        {
+          "uses": "Swatinem/rust-cache@v2",
+          "with": {
+            "key": "cgroup-undelegated-${{ matrix.image }}-${{ hashFiles('**/Cargo.lock') }}"
+          }
+        },
+        {
+          "name": "Install pinned WASM fixture assembler",
+          "run": "cargo install --locked wasm-tools --version 1.259.0"
+        },
+        {
+          "name": "Fetch locked standalone fixture dependencies for offline session tests",
+          "run": "cargo fetch --locked\nfor fixture in \\\n  crates/maos-wasm-host/guests/echo-spirit \\\n  crates/maos-wasm-host/guests/routed-relay \\\n  crates/maos-wasm-host/guests/equiv-fixture/native-twin; do\n  cargo fetch --locked --manifest-path \"$fixture/Cargo.toml\"\ndone\n"
+        },
+        {
+          "name": "Exercise helper boundary regressions",
+          "run": "python3 -m unittest scripts.tests.test_cgroup_ceiling_17_2"
+        },
+        {
+          "name": "Full undelegated session suite — live fallback, strict refusal, persistence and ordering",
+          "shell": "bash",
+          "run": "set -o pipefail\npython3 scripts/run_cgroup_ceiling_17_2.py run --mode undelegated --unit maos-17-2-undelegated --timeout 1800 -- \\\n  bash -euo pipefail -c 'cargo test --locked -p maos-bin --features network,wasm-host --test spawned_scope_17_3c -- --nocapture --test-threads=1 2>&1 | tee undelegated-session.log; test ${PIPESTATUS[0]} -eq 0'\npython3 scripts/run_cgroup_ceiling_17_2.py check-log --exit-code 0 --expected-count 22 undelegated-session.log\n"
+        }
+      ]
+    },
+    "workspace-test-suite": {
+      "runs-on": "ubuntu-24.04",
+      "timeout-minutes": 90,
+      "steps": [
+        {
+          "uses": "actions/checkout@v5",
+          "with": {
+            "fetch-depth": 0
+          }
+        },
+        {
+          "uses": "dtolnay/rust-toolchain@v1",
+          "with": {
+            "toolchain": "stable"
+          }
+        },
+        {
+          "uses": "Swatinem/rust-cache@v2"
+        },
+        {
+          "uses": "./.github/actions/provision-t3-test-substrate"
+        },
+        {
+          "name": "Install nightly toolchain for cargo-public-api integration tests",
+          "run": "rustup toolchain install nightly --profile minimal"
+        },
+        {
+          "name": "Install cargo-public-api for workspace integration tests",
+          "run": "cargo install cargo-public-api --version ${CARGO_PUBLIC_API_VERSION}"
+        },
+        {
+          "name": "Build the fixture binaries every workspace suite resolves by path",
+          "run": "cargo fetch --locked\ncargo build --locked -p worker --bin worker-cli-fixture --bin worker-probe-fixture\ncargo build --locked -p maos-cli --bin maosctl\ncargo build --release --manifest-path crates/maos-wasm-host/guests/equiv-fixture/native-twin/Cargo.toml\ncargo build --release --manifest-path crates/maos-wasm-host/test-fixtures/forbidden-syscall-probe/Cargo.toml\n"
+        },
+        {
+          "name": "Install python Ed25519 for the two-host reconcile suite",
+          "run": "python3 -c \"import cryptography\" || python3 -m pip install --user cryptography"
+        },
+        {
+          "name": "Install tokei",
+          "run": "# kloc_check unit tests measure the real workspace through tokei\n# (xtask/src/tests/kloc_check_tests.rs shells out and pins the\n# version); the runner image ships no tokei, which reds all 8\n# kloc_check unit tests with \"failed to read tokei version: No\n# such file or directory\" (runs 34699558533 / 34763853953).\n# Same cargo-install recipe as the kloc-check job; rust-cache\n# absorbs the build cost on subsequent runs.\ncargo install --locked --version ${TOKEI_VERSION} tokei\n"
+        },
+        {
+          "name": "Seed a decoy operator door on HOME (D-16-1-Q control)",
+          "run": "set -euo pipefail\ncargo build --locked -p maos-bin --bin maos\n./target/debug/maos init\npython3 - <<'PY'\nimport json, os, pathlib, socket, subprocess, sys\ncontrol = pathlib.Path(os.environ[\"HOME\"]) / \".maos\" / \"control.json\"\nrecord = json.loads(control.read_text())\nhost, port = record[\"endpoint\"].removeprefix(\"tcp://\").rsplit(\":\", 1)\n# Hold the port for the rest of the job. A test that inherits this\n# HOME now meets a taken endpoint instead of a free one.\nholder = socket.socket()\nholder.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\nholder.bind((host, int(port)))\nholder.listen(16)\npid = os.fork()\nif pid == 0:\n    os.setsid()\n    while True:\n        try:\n            connection, _ = holder.accept()\n            connection.close()\n        except OSError:\n            break\n    sys.exit(0)\nprint(f\"decoy door holding {host}:{port} (pid {pid})\")\nPY\n"
+        },
+        {
+          "name": "Run the full workspace test suite",
+          "run": "set +e\npython3 scripts/run_cgroup_ceiling_17_2.py run --mode delegated --unit maos-17-2-workspace --timeout 5400 --rootless-canary -- cargo test --workspace --locked --no-fail-fast 2>&1 | tee workspace-test-suite.log\npipeline=(\"${PIPESTATUS[@]}\")\nresult=${pipeline[0]}\nif [ \"$result\" -eq 0 ]; then result=${pipeline[1]}; fi\nWORKSPACE_EXIT=\"$result\" python3 - <<'PY'\nimport os\nstatus = int(os.environ[\"WORKSPACE_EXIT\"])\nif status:\n    with open(\"workspace-test-suite.log\", \"rb\") as log:\n        log.seek(0, 2)\n        log.seek(max(0, log.tell() - 2800))\n        excerpt = log.read(2800).decode(errors=\"replace\")\n    excerpt = excerpt.replace(\"%\", \"%25\").replace(\"\\r\", \"%0D\").replace(\"\\n\", \"%0A\")\n    print(f\"::error title=17-2 actual workspace failure::exit={status} {excerpt}\", flush=True)\nelse:\n    print(\"::notice title=17-2 actual workspace execution::command=cargo test --workspace --locked --no-fail-fast exit=0\", flush=True)\nPY\nreport=$?\nif [ \"$result\" -eq 0 ]; then result=$report; fi\nexit \"$result\"\n"
+        }
+      ]
+    },
+    "macos-scope": {
+      "runs-on": "ubuntu-latest",
+      "timeout-minutes": 10,
+      "outputs": {
+        "applicable": "${{ steps.scope.outputs.applicable }}",
+        "reason": "${{ steps.scope.outputs.reason }}"
+      },
+      "steps": [
+        {
+          "uses": "actions/checkout@v5",
+          "with": {
+            "fetch-depth": 0
+          }
+        },
+        {
+          "name": "Decide whether the diff is platform-sensitive",
+          "id": "scope",
+          "env": {
+            "EVENT_NAME": "${{ github.event_name }}",
+            "BASE_SHA": "${{ github.event.before }}",
+            "HEAD_SHA": "${{ github.sha }}"
+          },
+          "run": "set -euo pipefail\nemit() {\n  local reason=\"${2//[$'\\n\\r']/ }\"   # a path can carry a newline; never let it forge an output\n  echo \"applicable=$1\" >> \"$GITHUB_OUTPUT\"\n  echo \"reason=$reason\" >> \"$GITHUB_OUTPUT\"\n  echo \"macos-scope: applicable=$1 — $reason\"\n  echo \"- macos-check applicable=$1 — $reason\" >> \"${GITHUB_STEP_SUMMARY:-/dev/null}\"\n}\n# Pull request: `github.sha` is the MERGE commit checkout builds, and\n# its first parent is the base tip it lands on. `pull_request.base.sha`\n# is NOT used: it is not refreshed when `main` moves, so diffing\n# against it would charge the PR for every commit merged since it opened.\nif [ \"$EVENT_NAME\" = \"pull_request\" ]; then\n  BASE_SHA=\"$(git rev-parse --verify --quiet \"${HEAD_SHA}^1\" || true)\"\nfi\n# FAIL OPEN: with no usable base (new branch, force-push, unreachable\n# commit) the diff is unknown, and an unknown diff runs the guard.\nif [ -z \"${BASE_SHA:-}\" ] || [[ \"$BASE_SHA\" =~ ^0+$ ]] || ! git cat-file -e \"${BASE_SHA}^{commit}\" 2>/dev/null; then\n  emit true \"no usable diff base — guard runs (fail open)\"\n  exit 0\nfi\n# NUL-separated, so no path is ever C-quoted or split (a non-ASCII\n# `macos.rs` directory must still match). Deleted paths are listed\n# too (a deleted `macos.rs` is a macOS change).\nlist=\"$(mktemp)\"\ntrap 'rm -f \"$list\"' EXIT\ngit diff -z --name-only --no-renames \"$BASE_SHA\" \"$HEAD_SHA\" > \"$list\"\nmapfile -d '' -t listed < \"$list\"\n# Trees that are NOT workspace members (their own fuzz/guest/fixture/\n# spike workspaces; `templates/` is `exclude`d): no change there can\n# alter what `cargo check --workspace` compiles, so they never start a\n# macOS runner (D-15-4-F). The contract test pins that no workspace\n# member falls under this pattern. Rules (1) and (3) read `files`.\nOUTSIDE_RE='^(spikes|templates|tests/fixtures|xtask/tests/fixtures)/|/(fuzz|guests|test-fixtures)/'\nfiles=()\nfor f in ${listed[@]+\"${listed[@]}\"}; do\n  [[ \"$f\" =~ $OUTSIDE_RE ]] || files+=(\"$f\")\ndone\n\n# (1) Named platform-sensitive paths — epic-20 §20-6 AC1, plus the\n#     inputs that change what compiles: build scripts, cargo config and\n#     the pinned toolchain.\nPATH_RE='(^|/)macos\\.rs$|^crates/maos-kernel-core/src/security/sandbox/|^crates/maos-bin/src/(purge|operator_door)\\.rs$|(^|/)Cargo\\.(toml|lock)$|(^|/)build\\.rs$|(^|/)\\.cargo/|^rust-toolchain\\.toml$|^\\.github/workflows/release\\.yml$'\nfor f in ${files[@]+\"${files[@]}\"}; do\n  if [[ \"$f\" =~ $PATH_RE ]]; then\n    emit true \"platform-sensitive path changed: $f\"\n    exit 0\n  fi\ndone\n\n# (2) This job's own definition, so a change to the guard is exercised\n#     by the PR that makes it: (a) the macos-scope/macos-check job\n#     blocks differ between base and head (any edit, not just one that\n#     spells \"macos\"), or (b) any other discipline.yml line that\n#     mentions macos/darwin changed. The many unrelated edits to this\n#     file do not start a macOS runner.\nmacos_jobs() {\n  git show \"$1:.github/workflows/discipline.yml\" 2>/dev/null \\\n    | awk '/^  macos-(scope|check):/ {p=1; print; next} /^  (#|[A-Za-z0-9_-]+:)/ {p=0} p'\n}\nif [ \"$(macos_jobs \"$BASE_SHA\")\" != \"$(macos_jobs \"$HEAD_SHA\")\" ]; then\n  emit true \"the macos-scope/macos-check job definitions changed\"\n  exit 0\nfi\nif [ \"$(git diff -U0 --no-renames \"$BASE_SHA\" \"$HEAD_SHA\" -- .github/workflows/discipline.yml | grep -Eic '^[+-].*(macos|darwin)' || true)\" -gt 0 ]; then\n  emit true \"discipline.yml changed a macos/darwin line\"\n  exit 0\nfi\n\n# (3) Rust source that is platform-conditional, or that calls OS-typed\n#     APIs (`st_dev` is `dev_t`: u64 on Linux, i32 on macOS — the\n#     purge.rs break had no cfg at the failing sites). Judged on the\n#     file as it will be (HEAD) AND on its removed/added lines, so\n#     deleting the last `cfg` from a file still counts (the `+`/`-`\n#     prefix is cut first, so the anchored alternative below sees the\n#     line as written). CFG_RE is line-oriented, so it also matches the\n#     bare predicate lines rustfmt leaves when it wraps `#[cfg(any(…))]`\n#     over several lines. API_RE matches `os::{unix,linux,fd,macos,…}`\n#     wherever it sits in a path (`use std::{io, os::linux::…}`), and\n#     names every crate a workspace manifest takes only under\n#     `cfg(target_os = \"linux\")` (absent, or empty, on macOS); the\n#     contract test derives that list from the manifests.\n# BLIND SPOT, stated: a portable edit (a rename in a file with no\n# platform marker) that breaks UNCHANGED macOS-only code elsewhere is\n# not seen — that is what the pre-tag rehearsal is for.\nCFG_RE='cfg(_attr)?!?\\(.*(unix|windows)|\\btarget_(os|family|vendor|env|arch|pointer_width|endian)[[:space:]]*=|^[[:space:]]*(not\\()?(unix|windows)\\)*,?[[:space:]]*$'\nAPI_RE='(^|[^A-Za-z0-9_])os::(unix|linux|fd|macos|darwin|windows)\\b|std::os::\\{|libc::|rustix::|nix::|MetadataExt|/proc/|landlock::|seccompiler::|maos_exec_deps::'\nSRC_RE=\"$CFG_RE|$API_RE\"\nfor f in ${files[@]+\"${files[@]}\"}; do\n  case \"$f\" in *.rs) ;; *) continue ;; esac\n  git cat-file -e \"$HEAD_SHA:$f\" 2>/dev/null || continue\n  if [ \"$(git show \"$HEAD_SHA:$f\" | grep -Ec \"$SRC_RE\" || true)\" -gt 0 ]; then\n    emit true \"platform-sensitive Rust source changed: $f\"\n    exit 0\n  fi\ndone\nfor f in ${files[@]+\"${files[@]}\"}; do\n  case \"$f\" in *.rs) ;; *) continue ;; esac\n  if [ \"$(git --literal-pathspecs diff -U0 --no-renames \"$BASE_SHA\" \"$HEAD_SHA\" -- \"$f\" | grep -E '^[-+]' | grep -Ev '^(\\+\\+\\+|---)' | cut -c2- | grep -Ec \"$SRC_RE\" || true)\" -gt 0 ]; then\n    emit true \"a changed Rust line adds or removes platform-conditional code: $f\"\n    exit 0\n  fi\ndone\nemit false \"no platform-sensitive path in this diff — NOT a pass; the pre-tag rehearsal stays mandatory\"\n"
+        }
+      ]
+    },
+    "macos-check": {
+      "needs": "macos-scope",
+      "if": "needs.macos-scope.outputs.applicable == 'true'",
+      "runs-on": "macos-latest",
+      "timeout-minutes": 45,
+      "steps": [
+        {
+          "uses": "actions/checkout@v5"
+        },
+        {
+          "uses": "dtolnay/rust-toolchain@v1",
+          "with": {
+            "toolchain": "stable",
+            "targets": "aarch64-apple-darwin"
+          }
+        },
+        {
+          "uses": "Swatinem/rust-cache@v2",
+          "with": {
+            "key": "macos-check-${{ hashFiles('**/Cargo.lock') }}"
+          }
+        },
+        {
+          "name": "cargo check (aarch64-apple-darwin)",
+          "run": "cargo check --locked --workspace --all-targets --target aarch64-apple-darwin"
+        },
+        {
+          "name": "cargo check feature-enabled spawned session (aarch64-apple-darwin)",
+          "run": "cargo check --locked -p maos-bin --all-targets --features network,wasm-host --target aarch64-apple-darwin"
+        }
+      ]
+    }
+  }
+}
