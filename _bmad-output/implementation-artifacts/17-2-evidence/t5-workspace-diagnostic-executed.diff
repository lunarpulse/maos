diff --git a/.github/workflows/17-2-a6-descendant-red.yml b/.github/workflows/17-2-a6-descendant-red.yml
new file mode 100644
index 00000000..78a61acd
--- /dev/null
+++ b/.github/workflows/17-2-a6-descendant-red.yml
@@ -0,0 +1,52 @@
+{
+  "name": "17-2 A6 actual failing-before descendant containment",
+  "on": {
+    "workflow_dispatch": {}
+  },
+  "permissions": {
+    "contents": "read"
+  },
+  "jobs": {
+    "descendant-failing-before": {
+      "strategy": {
+        "fail-fast": false,
+        "matrix": {
+          "image": [
+            "ubuntu-24.04",
+            "ubuntu-26.04",
+            "ubuntu-24.04-arm",
+            "ubuntu-26.04-arm"
+          ]
+        }
+      },
+      "runs-on": "${{ matrix.image }}",
+      "timeout-minutes": 60,
+      "steps": [
+        {
+          "uses": "actions/checkout@v5"
+        },
+        {
+          "uses": "dtolnay/rust-toolchain@v1",
+          "with": {
+            "toolchain": "stable",
+            "targets": "wasm32-wasip2"
+          }
+        },
+        {
+          "uses": "Swatinem/rust-cache@v2",
+          "with": {
+            "key": "cgroup-ceiling-${{ matrix.image }}-${{ hashFiles('**/Cargo.lock') }}"
+          }
+        },
+        {
+          "name": "Compile the real existing native smoke target before the bounded service",
+          "run": "cargo test --locked -p maos-kernel-core --test cgroup_ceiling_smoke --no-run"
+        },
+        {
+          "name": "Require the actual uncapped descendant assertion to fail before production correction",
+          "run": "python3 - <<'PY'\nimport re, subprocess, sys\ncommand = [\"python3\", \"scripts/run_cgroup_ceiling_17_2.py\", \"run\", \"--mode\", \"delegated\", \"--unit\", \"maos-17-2-descendant-red\", \"--timeout\", \"300\", \"--\", \"cargo\", \"test\", \"--locked\", \"-p\", \"maos-kernel-core\", \"--test\", \"cgroup_ceiling_smoke\", \"killed_leader_cleanup_kills_its_surviving_descendant\", \"--\", \"--exact\", \"--nocapture\", \"--test-threads=1\"]\nresult = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=480)\nprint(result.stdout)\nsummary = re.search(r\"test result: FAILED\\. 0 passed; 1 failed; 0 ignored; 0 measured; 3 filtered out\", result.stdout)\nassert result.returncode == 101, (\"expected actual Rust assertion failure\", result.returncode)\nassert summary, \"actual one-selected failed descendant assertion was not executed\"\nassert \"a descendant awaiting its new parent's reap must already be dead\" in result.stdout, \"failure was not the real descendant-lifetime oracle\"\nprint(\"::notice title=17-2 A6 actual failing-before descendant proof::source=\" + __import__('os').environ['GITHUB_SHA'] + \" original-production=unchanged selected=1 failed=1 ignored=0 underlying-exit=101 actual-regression=uncapped-native-descendant-alive\")\nPY\n"
+        }
+      ]
+    }
+  }
+}
diff --git a/.github/workflows/17-2-ci-acceptance.yml b/.github/workflows/17-2-ci-acceptance.yml
