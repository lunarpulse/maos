diff --git a/scripts/17_2_harness_lifetime_proof.py b/scripts/17_2_harness_lifetime_proof.py
new file mode 100644
index 00000000..2d2d777c
--- /dev/null
+++ b/scripts/17_2_harness_lifetime_proof.py
@@ -0,0 +1,82 @@
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import time
+
+
+ROOT = Path.cwd()
+HELPER = ROOT / "scripts/run_cgroup_ceiling_17_2.py"
+PROOFS = []
+
+
+def client_pid(parent):
+    children = (Path(f"/proc/{parent}/task/{parent}/children").read_text().split())
+    for child in children:
+        pid = int(child)
+        command = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")[0]
+        if Path(os.fsdecode(command)).name == "systemd-run":
+            return pid
+        found = client_pid(pid)
+        if found:
+            return found
+    return None
+
+for scenario in ("wrapper-term", "client-term", "client-kill", "runtime-expiry"):
+    unit = f"maos-17-2-lifetime-{scenario}"
+    log = ROOT / f"lifetime-{scenario}.log"
+    started = time.monotonic()
+    with log.open("w") as output:
+        process = subprocess.Popen(
+            [sys.executable, str(HELPER), "run", "--mode", "delegated", "--unit", unit,
+             "--timeout", "2" if scenario == "runtime-expiry" else "30", "--",
+             sys.executable, "-u", "-c",
+             "import os,time;print('LIFETIME-CHILD',os.getpid(),flush=True);time.sleep(120)"],
+            stdout=output, stderr=subprocess.STDOUT, start_new_session=True,
+        )
+        pid = None
+        deadline = time.monotonic() + 20
+        try:
+            while time.monotonic() < deadline:
+                for line in log.read_text().splitlines():
+                    if line.startswith("LIFETIME-CHILD "):
+                        pid = int(line.split()[1])
+                        break
+                if pid:
+                    break
+                assert process.poll() is None, log.read_text()
+                time.sleep(0.05)
+            assert pid is not None, "actual contained command did not start: " + log.read_text()
+            if scenario != "runtime-expiry":
+                membership = Path(f"/proc/{pid}/cgroup").read_text()
+                assert f"0::/system.slice/{unit}.service/daemon\n" in membership, membership
+                if scenario == "wrapper-term":
+                    os.kill(process.pid, signal.SIGTERM)
+                else:
+                    client = client_pid(process.pid)
+                    assert client is not None, "actual systemd-run client was not found"
+                    subprocess.run(["sudo", "kill", "-KILL" if scenario == "client-kill" else "-TERM", str(client)], check=True)
+            status = process.wait(timeout=45)
+            elapsed = time.monotonic() - started
+            assert status != 0, "interrupted/expired execution must not report success"
+            active = subprocess.run(["systemctl", "is-active", "--quiet", f"{unit}.service"])
+            assert active.returncode != 0, "terminated client left its actual service active"
+            reap_deadline = time.monotonic() + 5
+            while Path(f"/proc/{pid}").exists() and time.monotonic() < reap_deadline:
+                time.sleep(0.05)
+            assert not Path(f"/proc/{pid}").exists(), "owned contained command was not reaped"
+            PROOFS.append({"scenario": scenario, "uid": os.getuid(), "child_pid": pid,
+                           "helper_exit": status, "elapsed_seconds": elapsed,
+                           "service_active": False, "child_reaped": True})
+        finally:
+            subprocess.run(["sudo", "systemctl", "stop", f"{unit}.service"],
+                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
+            if process.poll() is None:
+                process.kill()
+                process.wait(timeout=10)
+
+Path("harness-lifetime-proof.json").write_text(json.dumps(PROOFS, indent=2) + "\n")
+message = json.dumps({"runner": os.environ["IMAGE"], "actual_lifetime_proofs": PROOFS})
+print("::notice title=17-2 bounded harness lifetime::" + message.replace("%", "%25"), flush=True)
