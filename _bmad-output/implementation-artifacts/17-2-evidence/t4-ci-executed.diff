@@ -0,0 +1,142 @@
+name: 17-2 admitted T2 session proof
+on:
+  push:
+    branches: [ci/17-2-session-proof]
+permissions:
+  contents: read
+env:
+  MAOS_SECRETS_BACKEND: env
+jobs:
+  session-proof:
+    strategy:
+      fail-fast: false
+      matrix:
+        image: [ubuntu-24.04, ubuntu-26.04, ubuntu-24.04-arm, ubuntu-26.04-arm]
+        mode: [delegated, undelegated]
+    runs-on: ${{ matrix.image }}
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@v5
+      - uses: dtolnay/rust-toolchain@v1
+        with:
+          toolchain: stable
+          targets: wasm32-wasip2
+      - uses: Swatinem/rust-cache@v2
+        with:
+          key: session-proof-${{ matrix.image }}-${{ hashFiles('**/Cargo.lock') }}
+      - name: Fetch locked dependencies and fixture assembler
+        run: |
+          cargo fetch --locked
+          for fixture in crates/maos-wasm-host/guests/echo-spirit crates/maos-wasm-host/guests/routed-relay crates/maos-wasm-host/guests/equiv-fixture/native-twin; do
+            cargo fetch --locked --manifest-path "$fixture/Cargo.toml"
+          done
+          cargo install --locked wasm-tools --version 1.259.0
+      - name: Compile the actual production runner and session surface
+        run: |
+          cargo test --locked --offline -p maos-bin --features network,wasm-host --test spawned_scope_17_3c --no-run
+          cargo build --locked --offline --release -p maos-wasm-host --bin maos-wasm-runner
+          cargo build --locked --offline -p maos-cli --bin maosctl
+          for fixture in echo-spirit routed-relay; do
+            cargo build --locked --offline --release --manifest-path "crates/maos-wasm-host/guests/$fixture/Cargo.toml" --target wasm32-wasip2 --target-dir "${CARGO_TARGET_DIR:-$PWD/target}"
+          done
+          cargo build --locked --offline --release --manifest-path crates/maos-wasm-host/guests/equiv-fixture/native-twin/Cargo.toml --target-dir "${CARGO_TARGET_DIR:-$PWD/target}"
+      - name: Run all actual admitted-session cases in the asserted system unit
+        shell: bash
+        env:
+          IMAGE: ${{ matrix.image }}
+          MODE: ${{ matrix.mode }}
+        run: |
+          set -euo pipefail
+          unit="maos-17-2-session-${{ strategy.job-index }}"
+          inside="$RUNNER_TEMP/17-2-session-inside.sh"
+          cat > "$inside" <<'SH'
+          set -euo pipefail
+          unit=$1; mode=$2
+          [ "$(id -u)" -ne 0 ]
+          own=$(python3 -c 'from pathlib import Path; print(next(line[3:] for line in Path("/proc/self/cgroup").read_text().splitlines() if line.startswith("0::")))')
+          [ "$own" = "/system.slice/$unit.service" ]
+          python3 -c 'from pathlib import Path; assert any(line.split()[4] == "/sys/fs/cgroup" and " - cgroup2 " in line for line in Path("/proc/self/mountinfo").read_text().splitlines())'
+          actual=$(systemctl show "$unit.service" --property=Delegate --value)
+          root="/sys/fs/cgroup$own"
+          if [ "$mode" = delegated ]; then
+            [ "$actual" = yes ]
+            [ "$(cat "$root/cgroup.type")" = domain ]
+            for controller in cpu memory pids; do
+              [[ " $(cat "$root/cgroup.controllers") " == *" $controller "* ]]
+            done
+            mkdir "$root/daemon"
+            printf '%s\n' "$$" > "$root/daemon/cgroup.procs"
+            printf '+cpu +memory +pids\n' > "$root/cgroup.subtree_control"
+            for controller in cpu memory pids; do
+              [[ " $(cat "$root/cgroup.subtree_control") " == *" $controller "* ]]
+            done
+            [ "$(python3 -c 'from pathlib import Path; print(next(line[3:] for line in Path("/proc/self/cgroup").read_text().splitlines() if line.startswith("0::")))')" = "$own/daemon" ]
+          else
+            [ "$actual" = no ]
+            python3 - "$root" <<'PY'
+          import errno, os, pathlib, sys, uuid
+          mount = pathlib.Path('/sys/fs/cgroup')
+          own = pathlib.Path(sys.argv[1])
+          for candidate in [own, *own.parents]:
+              if not candidate.is_relative_to(mount):
+                  break
+              controllers = (candidate / 'cgroup.subtree_control').read_text().split()
+              if not set(controllers).intersection(('cpu', 'memory', 'pids')):
+                  print(f'NEGATIVE-ANCESTOR {candidate} not selected by resource discovery: {controllers}')
+                  continue
+              try:
+                  descriptor = os.open(candidate / 'cgroup.procs', os.O_WRONLY)
+              except OSError as error:
+                  assert error.errno in (errno.EPERM, errno.EACCES, errno.EROFS), error
+                  print(f'NEGATIVE-ANCESTOR {candidate} common-placement denied errno={error.errno}')
+              else:
+                  os.close(descriptor)
+                  raise AssertionError(f'unexpected common-ancestor placement access: {candidate}')
+              parents = [candidate]
+              if (candidate / 'maos.slice').is_dir():
+                  parents.append(candidate / 'maos.slice')
+              for parent in parents:
+                  probe = parent / ('maos-17-2-probe-' + uuid.uuid4().hex)
+                  try:
+                      probe.mkdir()
+                  except OSError as error:
+                      assert error.errno in (errno.EPERM, errno.EACCES, errno.EROFS), error
+                      print(f'NEGATIVE-ANCESTOR {parent} owned-subtree denied errno={error.errno}')
+                  else:
+                      probe.rmdir()
+                      raise AssertionError(f'unexpected owned-subtree creation access: {parent}')
+          PY
+          fi
+          printf 'T2-PROVISION mode=%s uid=%s unit=%s membership=%s Delegate=%s\n' "$mode" "$(id -u)" "$unit" "$own" "$actual"
+          cargo test --locked --offline -p maos-bin --features network,wasm-host --test spawned_scope_17_3c -- --nocapture
+          SH
+          env_args=(--setenv="PATH=$PATH" --setenv="HOME=$HOME" --setenv=CI=true --setenv=GITHUB_ACTIONS=true --setenv=MAOS_SECRETS_BACKEND=env --setenv="MAOS_17_2_CGROUP_MODE=$MODE")
+          while IFS='=' read -r key value; do
+            case "$key" in CARGO_*|RUSTUP_*|RUSTFLAGS|RUSTC_WRAPPER|RUSTC_WORKSPACE_WRAPPER|MAOS_T3_RUNTIME|MAOS_T3_IMAGE_LOCK_PATH|MAOS_T3_IMAGE_TRUST_ANCHOR_PUB_HEX|XDG_RUNTIME_DIR|DBUS_SESSION_BUS_ADDRESS) env_args+=(--setenv="$key=$value");; esac
+          done < <(env)
+          delegate=no; [ "$MODE" != delegated ] || delegate=yes
+          trap 'sudo systemctl stop "$unit.service" >/dev/null 2>&1 || true' EXIT INT TERM
+          set +e
+          sudo systemd-run --unit="$unit" --wait --pipe --collect --expand-environment=no --uid="$(id -u)" --gid="$(id -g)" --property="Delegate=$delegate" --property=RuntimeMaxSec=1500 --property=TimeoutStopSec=10 --property=KillMode=control-group --property="WorkingDirectory=$PWD" "${env_args[@]}" /bin/bash "$inside" "$unit" "$MODE" 2>&1 | tee session.log
+          rc=${PIPESTATUS[0]}
+          set -e
+          python3 - "$rc" "$IMAGE" "$MODE" <<'PY'
+          import pathlib, re, sys
+          rc, image, mode = sys.argv[1:]
+          text = pathlib.Path('session.log').read_text(errors='replace')
+          suites = re.findall(r'test result: (ok|FAILED)\. (\d+) passed; (\d+) failed; (\d+) ignored;', text)
+          valid = rc == '0' and suites == [('ok', '22', '0', '0')] and not re.search(r'^SKIP\b', text, re.M)
+          details = '\n'.join(line for line in text.splitlines() if 'T2-PROVISION' in line or ('test ' in line and any(name in line for name in ('resource_downgrade_', 'memory_only_t2_', 'admitted_t2_echo_', 'fast_t2_crash_'))))
+          if not valid:
+              details += '\n' + text[-1800:]
+          message = f'runner={image} mode={mode} exit={rc} suites={suites}\n{details}'[-2800:]
+          message = message.replace('%', '%25').replace('\r', '').replace('\n', '%0A')
+          print(f'::{"notice" if valid else "error"} title=17-2 session proof::{message}')
+          assert valid, 'actual session execution failed or was vacuous'
+          PY
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: session-${{ matrix.image }}-${{ matrix.mode }}
+          path: session.log
+          if-no-files-found: warn
