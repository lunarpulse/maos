+            resolve_worker_caps(&manifest, &policy).expect("resolve updated policy"),
+            ResolvedCaps {
+                cpu_max_pct: Some(20),
+                memory_max_mb: Some(128),
+                fd_max: Some(16),
+                pids_max: Some(80),
+            },
+            "each launch must read the latest policy snapshot rather than a frozen boot value"
+        );
+    }
