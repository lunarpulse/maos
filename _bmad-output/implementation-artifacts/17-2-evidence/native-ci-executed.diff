new file mode 100644
index 00000000..9fdbc7d4
--- /dev/null
+++ b/.github/workflows/17-2-native-proof.yml
@@ -0,0 +1,61 @@
+name: 17-2 native containment proof
+on:
+  push:
+    branches: ['ci/17-2-native-proof']
+permissions:
+  contents: read
+jobs:
+  native-proof:
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-24.04, ubuntu-26.04, ubuntu-24.04-arm, ubuntu-26.04-arm]
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@stable
+      - uses: Swatinem/rust-cache@v2
+      - name: Run strict native containment smoke in delegated domain
+        shell: bash
+        run: |
+          set -euo pipefail
+          unit=maos-17-2-proof
+          trap 'sudo systemctl stop "$unit.service" || true' EXIT
+          set +e
+          sudo systemd-run --unit="$unit" --uid="$(id -u)" --gid="$(id -g)" --working-directory="$GITHUB_WORKSPACE" \
+            --property=Delegate=yes --property=RuntimeMaxSec=1000 --property=TimeoutStopSec=10 \
+            --wait --pipe --collect --expand-environment=no \
+            env PATH="$PATH" HOME="$HOME" CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" \
+            RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}" \
+            CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$GITHUB_WORKSPACE/target}" \
+            CI=true GITHUB_ACTIONS=true MAOS_SECRETS_BACKEND=env \
+            bash -c '
+              set -euo pipefail
+              test "$(id -u)" -ne 0
+              cgroup=$(cut -d: -f3 /proc/self/cgroup)
+              test "$cgroup" = /system.slice/maos-17-2-proof.service
+              test "$(systemctl show maos-17-2-proof.service -p Delegate --value)" = yes
+              root=/sys/fs/cgroup$cgroup
+              for controller in cpu memory pids; do
+                case " $(cat "$root/cgroup.controllers") " in
+                  *" $controller "*) ;;
+                  *) echo "missing controller: $controller" >&2; exit 1 ;;
+                esac
+              done
+              mkdir "$root/daemon"
+              printf "DOMAIN type=%s leaf-type=%s pid=%s bashpid=%s\n" "$(cat "$root/cgroup.type")" "$(cat "$root/daemon/cgroup.type")" "$$" "$BASHPID"
+              test "$$" = "$BASHPID"
+              printf "%s\n" "$$" > "$root/daemon/cgroup.procs"
+              printf "+cpu +memory +pids\n" > "$root/cgroup.subtree_control"
+              cargo test --locked -p maos-kernel-core --test cgroup_ceiling_smoke -- --nocapture
+            ' 2>&1 | tee native-proof.log
+          result=${PIPESTATUS[0]}
+          set -e
+          python3 -c 'import re,sys; s=open("native-proof.log").read(); code=int(sys.argv[1]); m=re.search(r"test result: ok\. (\d+) passed; 0 failed; 0 ignored",s); detail="\n".join(s.splitlines()[-90:]).replace("%","%25").replace("\r","%0D").replace("\n","%0A"); print("::error title=17-2 native proof::runner=${{ matrix.os }} exit="+str(code)+"%0A"+detail) if code else None; assert code or (m and int(m[1])>0),"native smoke did not execute assertions"; print("::notice title=17-2 native proof::cgroup_ceiling_smoke executed="+m[1]+" passed; delegated cpu memory pids; runner=${{ matrix.os }}") if not code else None' "$result"
+          exit "$result"
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: native-proof-${{ matrix.os }}
+          path: native-proof.log
