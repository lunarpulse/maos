+    timeouts: TcpTimeouts,
+    retry: HandshakeRetryPolicy,
+    consent_now_ns: u64,
+) -> TcpA2ATransport {
+    let pems = write_pem(own_leaf, ca);
+    let cfg = tcp_config(&pems, peer_pins, Duration::from_secs(30));
+    TcpA2ATransport::bind(
+        cfg,
+        peer_configs,
+        own_boot_nonce,
+        timeouts,
+        retry,
+        Some(clock.unix()),
+        Some(consent_now_ns),
+    )
+    .await
+    .expect("bind endpoint (consent-pinned)")
+}
