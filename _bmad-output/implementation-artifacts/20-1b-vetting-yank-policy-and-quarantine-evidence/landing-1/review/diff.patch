+    maos_registry::install::install("immutable@1.0.0", &uri, None, None).unwrap();
+    assert_eq!(
+        std::fs::read(root.join("installed-index.json")).unwrap(),
+        index
+    );
+    pkg.artifact_bytes.push(1);
+    sign(&mut pkg, &PUBLISHER);
+    assert!(rpc(
+        &server.addr,
+        "registry.publish",
+        serde_json::to_value(pkg).unwrap()
+    )
