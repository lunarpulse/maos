+    for params in [
+        serde_json::json!({"spirit_id":"owner","version":"1.0.0","reason":"unauthenticated"}),
+        yank("owner", "1.0.0", &[0x54; 32], YankOrigin::Publisher),
+        yank("owner", "1.0.0", &VETTER, YankOrigin::Vetter),
+    ] {
