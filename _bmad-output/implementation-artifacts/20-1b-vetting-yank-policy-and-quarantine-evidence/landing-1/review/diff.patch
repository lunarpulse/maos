+    .unwrap();
+    for params in [
+        serde_json::to_value(package("owner", "1.0.0", &[0x54; 32])).unwrap(),
+        serde_json::to_value(package("owner", "2.0.0", &[0x54; 32])).unwrap(),
+    ] {
+        assert!(rpc(&server.addr, "registry.publish", params)
+            .get("error")
