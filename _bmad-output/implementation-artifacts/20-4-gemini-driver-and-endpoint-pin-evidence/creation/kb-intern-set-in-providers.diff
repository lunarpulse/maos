 /// that already has consumers.
 pub use provider::Provider as ProviderDriver;
 
+/// The closed set of provider ids a rate-limit bucket may name. An id outside
+/// it fails closed in the kernel adapter (Story 6.4 review fix).
+pub const PROVIDER_IDS: [&str; 5] = ["anthropic", "openai", "ollama", "gemini", "kimi"];
+
+/// Intern `id` into [`PROVIDER_IDS`]; `None` for an unknown provider.
+pub fn intern_provider_id(id: &str) -> Option<&'static str> {
+    PROVIDER_IDS.iter().copied().find(|known| *known == id)
+}
