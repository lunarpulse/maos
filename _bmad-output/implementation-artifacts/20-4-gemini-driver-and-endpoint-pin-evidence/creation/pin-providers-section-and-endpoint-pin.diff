+/// Story 20-4 (FR3) — every `[providers]` entry must name a registered driver,
+/// and a pinned entry must match `sha256(endpoint_url)` of that driver exactly
+/// (the registered base URL's bytes; no normalisation).
+pub fn check_provider_pins(
+    providers: &maos_kernel_core::security::ProvidersSection,
+    endpoints: &BTreeMap<String, String>,
+) -> Result<(), AdmissionRefusal> {
+    use sha2::Digest;
+    for config in std::iter::once(&providers.primary).chain(&providers.fallback) {
+        let Some(endpoint) = endpoints.get(&config.id) else {
+            return Err(AdmissionRefusal::ProviderUnavailable {
+                provider: config.id.clone(),
+            });
+        };
+        let pin_ok = config
+            .provider_endpoint_pin
+            .as_deref()
+            .is_none_or(|pin| hex::encode(sha2::Sha256::digest(endpoint.as_bytes())) == pin);
+        let url_ok = config
+            .endpoint_url
+            .as_deref()
+            .is_none_or(|url| url == endpoint);
+        if !(pin_ok && url_ok) {
+            return Err(AdmissionRefusal::EndpointPinMismatch {
+                provider: config.id.clone(),
+            });
+        }
+    }
+    Ok(())
+}
