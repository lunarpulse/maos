+#![forbid(unsafe_code)]
+//! 20-4 AC6: admission checks exact configured URL bytes, before inference.
+#[allow(dead_code)]
+#[path = "support/provider204.rs"]
+mod support;
+use sha2::{Digest, Sha256};
+use support::*;
+
+#[test]
+fn wrong_endpoint_pin_refuses_before_inference() -> TestResult {
+    let home = tempfile::tempdir()?;
+    let out = researcher(
+        home.path(),
+        "openai",
+        &format!(
+            "[providers.primary]\nid = \"openai\"\nprovider_endpoint_pin = \"{}\"\n",
+            "0".repeat(64)
+        ),
+    )?;
+    assert!(!out.status.success(), "wrong pin admitted");
+    assert!(
+        stderr(&out).contains("endpoint_pin_mismatch"),
+        "{}",
+        stderr(&out)
+    );
+    assert!(!intents(home.path())?
+        .iter()
+        .any(|s| s.starts_with("infer:")));
+    assert!(issuance_payloads(home.path())?
+        .iter()
+        .all(|s| !s.contains("ProviderInfer")));
+    Ok(())
+}
+#[test]
+fn matching_endpoint_pin_and_model_admit() -> TestResult {
+    let home = tempfile::tempdir()?;
+    let pin = hex::encode(Sha256::digest(b"https://api.openai.com"));
+    let out = researcher(home.path(), "openai", &format!("[providers.primary]\nid = \"openai\"\nprovider_endpoint_pin = \"{pin}\"\nendpoint_url = \"https://api.openai.com\"\nmodel_id = \"gpt-4o-mini\"\n"))?;
+    assert!(out.status.success(), "{}", stderr(&out));
+    Ok(())
+}
+#[test]
+fn endpoint_and_model_are_assertions_not_reconfiguration() -> TestResult {
+    for assertion in [
+        "endpoint_url = \"https://elsewhere.invalid\"",
+        "model_id = \"gpt-unconfigured\"",
+    ] {
+        let home = tempfile::tempdir()?;
+        let out = researcher(
+            home.path(),
+            "openai",
+            &format!("[providers.primary]\nid = \"openai\"\n{assertion}\n"),
+        )?;
+        assert!(!out.status.success());
+        assert!(!intents(home.path())?
+            .iter()
+            .any(|s| s.starts_with("infer:")));
+    }
+    Ok(())
+}
+#[test]
+fn airgap_pin_tracks_ollama_configuration_in_keyless_replay() -> TestResult {
+    let endpoint = "http://127.0.0.1:11434";
+    let pin = hex::encode(Sha256::digest(endpoint.as_bytes()));
+    for (url, accepted) in [(endpoint, true), ("http://10.0.0.5:11434", false)] {
+        let home = tempfile::tempdir()?;
+        let mut doc: toml::Value = toml::from_str(&std::fs::read_to_string(
+            root().join("spirits/researcher/manifest.toml"),
+        )?)?;
+        doc["capabilities"]["required"]["provider"]["complete"] =
+            toml::Value::Array(vec![toml::Value::String("ollama".into())]);
+        let manifest = home.path().join("airgap.toml");
+        std::fs::write(
+            &manifest,
+            format!(
+                "{}\n[providers.primary]\nid = \"ollama\"\nprovider_endpoint_pin = \"{pin}\"\n",
+                toml::to_string(&doc)?
+            ),
+        )?;
+        let out = command(home.path())
+            .arg("run")
+            .arg(manifest)
+            .arg("--once")
+            .env("MAOS_OLLAMA_URL", url)
+            .env(
+                "MAOS_REPLAY_CASSETTE",
+                root().join("crates/maos-journey-test/cassettes/j-researcher/survey-distill.json"),
+            )
+            .output()?;
+        assert_eq!(out.status.success(), accepted, "{}", stderr(&out));
+        if !accepted {
+            assert!(stderr(&out).contains("endpoint_pin_mismatch"));
+        }
+    }
+    Ok(())
+}
diff --git a/crates/maos-bin/tests/provider_selection_20_4.rs b/crates/maos-bin/tests/provider_selection_20_4.rs
new file mode 100644
index 00000000..dd316c6e
--- /dev/null
+++ b/crates/maos-bin/tests/provider_selection_20_4.rs
@@ -0,0 +1,242 @@
+#![forbid(unsafe_code)]
+//! 20-4 AC1/2/3/5: isolated roots, seeded routing and no-inference keyed boots.
+#[allow(dead_code)]
+#[path = "support/provider204.rs"]
+mod support;
+use support::*;
+
+#[test]
+fn epic_gemini_shell_command_selects_and_routes() -> TestResult {
+    let home = tempfile::tempdir()?;
+    let out = shell(
+        home.path(),
+        "gemini",
+        "crates/maos-journey-test/cassettes/providers/gemini-shell-intro.json",
+    )?;
+    assert!(out.status.success(), "{}", stderr(&out));
+    assert!(String::from_utf8_lossy(&out.stdout).contains("Hello from the Gemini routing seed"));
+    assert!(intents(home.path())?
+        .iter()
+        .any(|s| s.starts_with("infer:gemini->replay:")));
+    assert!(issuance_payloads(home.path())?
+        .iter()
+        .any(|s| s.contains("ProviderInfer") && s.contains("gemini")));
+    Ok(())
+}
+#[test]
+fn kimi_shell_selects_and_routes() -> TestResult {
+    let home = tempfile::tempdir()?;
+    let out = shell(
+        home.path(),
+        "kimi",
+        "crates/maos-journey-test/cassettes/providers/kimi-shell-intro.json",
+    )?;
+    assert!(out.status.success(), "{}", stderr(&out));
+    assert!(String::from_utf8_lossy(&out.stdout).contains("Hello from the Kimi routing seed"));
+    assert!(intents(home.path())?
+        .iter()
+        .any(|s| s.starts_with("infer:kimi->replay:")));
+    Ok(())
+}
+#[test]
+fn unknown_default_refuses_with_registered_ids() -> TestResult {
+    let home = tempfile::tempdir()?;
+    let out = command(home.path())
+        .arg("shell")
+        .env("MAOS_DEFAULT_PROVIDER", "bedrock")
+        .output()?;
+    assert!(!out.status.success());
+    let err = stderr(&out);
+    assert!(
+        err.contains("MAOS_DEFAULT_PROVIDER") && err.contains("bedrock"),
+        "{err}"
+    );
+    for id in ["anthropic", "openai", "gemini", "kimi", "ollama"] {
+        assert!(err.contains(id), "{err}");
+    }
+    Ok(())
+}
+#[test]
+fn invalid_credentials_refuse_without_echoing_bytes() -> TestResult {
+    for key in [
+        "MAOS_ANTHROPIC_API_KEY",
+        "MAOS_OPENAI_API_KEY",
+        "MAOS_GEMINI_API_KEY",
+        "MAOS_KIMI_API_KEY",
+    ] {
+        let home = tempfile::tempdir()?;
+        let secret = "sk-DO-NOT-ECHO\u{1}tail";
+        let out = command(home.path())
+            .arg("shell")
+            .env(key, secret)
+            .output()?;
+        assert_eq!(out.status.code(), Some(78), "{key}: {}", stderr(&out));
+        assert!(!stderr(&out).contains("DO-NOT-ECHO"));
+        assert!(!String::from_utf8_lossy(&out.stdout).contains("DO-NOT-ECHO"));
+    }
+    Ok(())
+}
+#[test]
+fn researcher_primary_overrides_declaration_order() -> TestResult {
+    let home = tempfile::tempdir()?;
+    let out = researcher(
+        home.path(),
+        "openai",
+        "[providers.primary]\nid = \"openai\"\n",
+    )?;
+    assert!(out.status.success(), "{}", stderr(&out));
+    let rows = intents(home.path())?;
+    assert!(
+        rows.iter().any(|s| s.starts_with("infer:openai->")),
+        "{rows:?}"
+    );
+    assert!(
+        !rows.iter().any(|s| s.starts_with("infer:anthropic->")),
+        "{rows:?}"
+    );
+    Ok(())
+}
+#[test]
+fn fallback_is_refused_before_inference() -> TestResult {
+    let home = tempfile::tempdir()?;
+    let out = researcher(
+        home.path(),
+        "openai",
+        "[providers.primary]\nid = \"anthropic\"\n[[providers.fallback]]\nid = \"openai\"\n",
+    )?;
+    assert!(!out.status.success());
+    assert!(
+        stderr(&out).contains("fallback_unsupported"),
+        "{}",
+        stderr(&out)
+    );
+    assert!(!intents(home.path())?
+        .iter()
+        .any(|s| s.starts_with("infer:")));
+    Ok(())
+}
+
+#[test]
+fn new_keys_route_in_replay() -> TestResult {
+    for (key, id) in [
+        ("MAOS_GEMINI_API_KEY", "gemini"),
+        ("MAOS_KIMI_API_KEY", "kimi"),
+    ] {
+        let home = tempfile::tempdir()?;
+        let mut child = command(home.path())
+            .arg("shell")
+            .env(key, "test-key-visible-ascii")
+            // Replay proves explicit routing, not native key registration.
+            .env("MAOS_DEFAULT_PROVIDER", id)
+            .stdin(std::process::Stdio::piped())
+            .stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::piped())
+            .spawn()?;
+        std::io::Write::write_all(
+            &mut child.stdin.take().ok_or("stdin")?,
+            b"@hello-spirit hello\n",
+        )?;
+        let out = child.wait_with_output()?;
+        assert!(out.status.success(), "{}", stderr(&out));
+        assert!(intents(home.path())?
+            .iter()
+            .any(|s| s.starts_with(&format!("infer:{id}->"))));
+    }
+    Ok(())
+}
+
+#[test]
+fn empty_default_preserves_existing_router_default() -> TestResult {
+    let home = tempfile::tempdir()?;
+    let out = shell(
+        home.path(),
+        "",
+        "crates/maos-journey-test/cassettes/j0/shell-intro.json",
+    )?;
+    assert!(out.status.success(), "{}", stderr(&out));
+    assert!(intents(home.path())?
+        .iter()
+        .any(|s| s.starts_with("infer:anthropic->")));
+    Ok(())
+}
+
+#[test]
+fn undeclared_primary_is_a_typed_refusal() -> TestResult {
+    let home = tempfile::tempdir()?;
+    let out = researcher(
+        home.path(),
+        "openai",
+        "[providers.primary]\nid = \"gemini\"\n",
+    )?;
+    assert!(!out.status.success());
+    assert!(
+        stderr(&out).contains("provider_unavailable"),
+        "{}",
+        stderr(&out)
+    );
+    assert!(!intents(home.path())?
+        .iter()
+        .any(|s| s.starts_with("infer:")));
+    Ok(())
+}
+
+fn real_registration(key: &str, id: &str, absent: &str) -> TestResult {
+    let home = tempfile::tempdir()?;
+    for (selected, accepted) in [(id, true), (absent, false)] {
+        let out = command(home.path())
+            .arg("shell")
+            .env("MAOS_INFERENCE_MODE", "live")
+            .env_remove("MAOS_REPLAY_CASSETTE")
+            .env(key, "test-key-visible-ascii")
+            .env("MAOS_DEFAULT_PROVIDER", selected)
+            .stdin(std::process::Stdio::null())
+            .output()?;
+        assert_eq!(
+            out.status.success(),
+            accepted,
+            "{id}/{selected}: {}",
+            stderr(&out)
+        );
+        assert!(!intents(home.path())?
+            .iter()
+            .any(|s| s.starts_with("infer:")));
+    }
+    Ok(())
+}
+#[test]
+fn gemini_key_really_registers_without_replay_p3() -> TestResult {
+    real_registration("MAOS_GEMINI_API_KEY", "gemini", "kimi")
+}
+#[test]
+fn kimi_key_really_registers_without_replay_p3() -> TestResult {
+    real_registration("MAOS_KIMI_API_KEY", "kimi", "gemini")
+}
+#[test]
+fn existing_key_precedence_is_preserved_p3() -> TestResult {
+    for new_key in ["MAOS_GEMINI_API_KEY", "MAOS_KIMI_API_KEY"] {
+        for (old_key, id) in [
+            ("MAOS_ANTHROPIC_API_KEY", "anthropic"),
+            ("MAOS_OPENAI_API_KEY", "openai"),
+        ] {
+            let home = tempfile::tempdir()?;
+            let mut child = command(home.path())
+                .arg("shell")
+                .env(new_key, "new-key")
+                .env(old_key, "old-key")
+                .stdin(std::process::Stdio::piped())
+                .stdout(std::process::Stdio::piped())
+                .stderr(std::process::Stdio::piped())
+                .spawn()?;
+            std::io::Write::write_all(
+                &mut child.stdin.take().ok_or("stdin")?,
+                b"@hello-spirit hello\n",
+            )?;
+            let out = child.wait_with_output()?;
+            assert!(out.status.success(), "{}", stderr(&out));
+            assert!(intents(home.path())?
+                .iter()
+                .any(|s| s.starts_with(&format!("infer:{id}->"))));
+        }
+    }
+    Ok(())
+}
diff --git a/crates/maos-bin/tests/support/provider204.rs b/crates/maos-bin/tests/support/provider204.rs
new file mode 100644
index 00000000..957a57be
--- /dev/null
+++ b/crates/maos-bin/tests/support/provider204.rs
@@ -0,0 +1,95 @@
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Output, Stdio};
+
+pub type TestResult = Result<(), Box<dyn std::error::Error>>;
+pub fn root() -> PathBuf {
+    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../..")
+}
+pub fn command(home: &Path) -> Command {
+    let mut cmd = Command::new(env!("CARGO_BIN_EXE_maos"));
+    cmd.current_dir(root())
+        .env_clear()
+        .env("PATH", std::env::var_os("PATH").unwrap_or_default())
+        .env("HOME", home)
+        .env("MAOS_HOME", home.join("maos"))
+        .env("XDG_DATA_HOME", home.join("xdg"))
+        .env("MAOS_SECRETS_BACKEND", "env")
+        .env("MAOS_OLLAMA_URL", "skip")
+        .env("MAOS_INFERENCE_MODE", "replay")
+        .env(
+            "MAOS_REPLAY_CASSETTE",
+            root().join("crates/maos-journey-test/cassettes/j0/shell-intro.json"),
+        );
+    cmd
+}
+pub fn shell(
+    home: &Path,
+    provider: &str,
+    cassette: &str,
+) -> Result<Output, Box<dyn std::error::Error>> {
+    let mut child = command(home)
+        .arg("shell")
+        .env("MAOS_DEFAULT_PROVIDER", provider)
+        .env("MAOS_REPLAY_CASSETTE", root().join(cassette))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()?;
+    child
+        .stdin
+        .take()
+        .ok_or("missing stdin")?
+        .write_all(b"@hello-spirit hello\n")?;
+    Ok(child.wait_with_output()?)
+}
+pub fn intents(home: &Path) -> Result<Vec<String>, Box<dyn std::error::Error>> {
+    let path = home.join("maos/audit/transparency.sqlite");
+    if !path.exists() {
+        return Ok(Vec::new());
+    }
+    let conn =
+        rusqlite::Connection::open_with_flags(path, rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY)?;
+    let mut stmt = conn.prepare("SELECT intent FROM transparency_log ORDER BY rowid")?;
+    let rows = stmt.query_map([], |r| r.get(0))?;
+    Ok(rows.collect::<Result<Vec<_>, _>>()?)
+}
+pub fn issuance_payloads(home: &Path) -> Result<Vec<String>, Box<dyn std::error::Error>> {
+    let conn = rusqlite::Connection::open_with_flags(
+        home.join("maos/audit/transparency.sqlite"),
+        rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY,
+    )?;
+    let mut stmt = conn.prepare("SELECT payload_redacted FROM transparency_log WHERE intent LIKE 'cap.issue%' ORDER BY rowid")?;
+    let rows = stmt.query_map([], |r| r.get::<_, Option<Vec<u8>>>(0))?;
+    let mut payloads = Vec::new();
+    for row in rows {
+        payloads.push(String::from_utf8_lossy(&row?.unwrap_or_default()).into_owned());
+    }
+    Ok(payloads)
+}
+pub fn researcher(
+    home: &Path,
+    provider: &str,
+    config: &str,
+) -> Result<Output, Box<dyn std::error::Error>> {
+    let text = std::fs::read_to_string(root().join("spirits/researcher/manifest.toml"))?;
+    let mut doc: toml::Value = toml::from_str(&text)?;
+    doc["capabilities"]["required"]["provider"]["complete"] = toml::Value::Array(vec![
+        toml::Value::String("anthropic.claude-sonnet-5-5".into()),
+        toml::Value::String(provider.into()),
+    ]);
+    let manifest = home.join("researcher.toml");
+    std::fs::write(&manifest, format!("{}\n{config}", toml::to_string(&doc)?))?;
+    Ok(command(home)
+        .args(["run"])
+        .arg(&manifest)
+        .arg("--once")
+        .env(
+            "MAOS_REPLAY_CASSETTE",
+            root().join("crates/maos-journey-test/cassettes/j-researcher/survey-distill.json"),
+        )
+        .output()?)
+}
+pub fn stderr(out: &Output) -> String {
+    String::from_utf8_lossy(&out.stderr).into_owned()
+}
