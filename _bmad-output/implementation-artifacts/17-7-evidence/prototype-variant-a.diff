+    let unavailable = || ContainerTerminalFacts {
+        observation: maos_domain::sandbox::ContainerObservationAvailability::Unavailable,
+        payload_wait_status: maos_domain::sandbox::ContainerPayloadWaitStatus::Unknown,
+        exit_code: None,
