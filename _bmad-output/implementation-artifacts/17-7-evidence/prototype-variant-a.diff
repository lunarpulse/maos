+#[doc(hidden)]
+#[cfg(target_os = "linux")]
+pub fn validate_state_dir(path: &Path) -> std::io::Result<()> {
+    use std::os::unix::fs::{MetadataExt, PermissionsExt};
+    let meta = std::fs::symlink_metadata(path)?;
+    let effective_uid = std::fs::metadata("/proc/self")?.uid();
+    if !meta.is_dir() || meta.uid() != effective_uid || meta.permissions().mode() & 0o777 != 0o700 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::PermissionDenied,
+            "state dir must be euid-owned mode 0700",
+        ));
+    }
+    if path.join("init.pid").exists() || std::fs::symlink_metadata(path.join("init.pid")).is_ok() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::AlreadyExists,
+            "pidfile already exists",
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(target_os = "linux")]
+#[doc(hidden)]
+pub fn read_pidfile(path: &Path) -> std::io::Result<u32> {
+    use std::os::unix::fs::OpenOptionsExt;
+    let file = std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)?;
+    let meta = file.metadata()?;
+    if !meta.is_file() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "pidfile is not regular",
+        ));
+    }
+    let mut text = String::new();
+    use std::io::Read;
+    (&file).take(64).read_to_string(&mut text)?;
+    let pid = text
+        .trim()
+        .parse::<u32>()
+        .map_err(|_| std::io::Error::new(std::io::ErrorKind::InvalidData, "invalid pidfile"))?;
+    if pid == 0 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "zero pid",
+        ));
+    }
+    Ok(pid)
+}
+#[cfg(target_os = "linux")]
+fn open_payload_pidfd(pid: u32, cid: &str) -> std::io::Result<std::os::fd::OwnedFd> {
+    let fd = crate::security::sandbox::linux::open_pidfd(pid)?;
+    let cgroup = std::fs::read_to_string(format!("/proc/{pid}/cgroup"))?;
+    if !cgroup.contains(cid) || !std::path::Path::new(&format!("/proc/{pid}")).exists() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "pidfile PID does not identify live container init",
+        ));
+    }
+    Ok(fd)
+}
