+        observation: maos_domain::sandbox::ContainerObservationAvailability::Available,
+        payload_wait_status: maos_domain::sandbox::ContainerPayloadWaitStatus::Unknown,
+        exit_code: None,
+        exit_signal: None,
+        runtime_status: status.into(),
+        runtime_exit_code: Some(exit_code),
+        oom_marker: Some(oom_marker),
+        runtime_error: state
+            .get("Error")
+            .and_then(|v| v.as_str())
+            .filter(|s| !s.is_empty())
+            .map(str::to_owned),
+        started_at: state
+            .get("StartedAt")
+            .and_then(|v| v.as_str())
+            .map(str::to_owned),
+        finished_at: state
+            .get("FinishedAt")
+            .and_then(|v| v.as_str())
+            .map(str::to_owned),
+        observed_pid: state
+            .get("Pid")
+            .and_then(|v| v.as_u64())
+            .and_then(|v| u32::try_from(v).ok()),
