+                state.get("Status").and_then(|v| v.as_str()),
+                state
+                    .get("ExitCode")
+                    .and_then(|v| v.as_i64())
+                    .and_then(|v| i32::try_from(v).ok()),
+                state.get("OOMKilled").and_then(|v| v.as_bool()),
+                state.get("Error").and_then(|v| v.as_str()),
+                state.get("StartedAt").and_then(|v| v.as_str()),
+                state.get("FinishedAt").and_then(|v| v.as_str()),
+                state
+                    .get("Pid")
+                    .and_then(|v| v.as_u64())
+                    .and_then(|v| u32::try_from(v).ok()),
+            ) {
+                (Some(a), Some(b), Some(c), d, e, f, Some(g)) => (
+                    a.to_owned(),
+                    b,
+                    c,
+                    d.map(str::to_owned),
+                    e.map(str::to_owned),
+                    f.map(str::to_owned),
+                    g,
+                ),
+                _ => return unavailable(),
+            };
+            let mut facts = ContainerTerminalFacts {
+                observation: maos_domain::sandbox::ContainerObservationAvailability::Available,
+                payload_wait_status: maos_domain::sandbox::ContainerPayloadWaitStatus::Unknown,
+                exit_code: None,
+                exit_signal: None,
+                runtime_status: status,
+                runtime_exit_code: Some(runtime_code),
+                oom_marker: Some(oom),
+                runtime_error: error,
+                started_at: started,
+                finished_at: finished,
+                observed_pid: Some(pid),
+                container_id: self.cid.clone(),
+                runtime: self.runtime.kind.as_str().to_owned(),
+            };
+            #[cfg(target_os = "linux")]
+            if let Some(fd) = &self.pidfd {
+                if let Some(raw) = crate::security::sandbox::linux::pidfd_exit_status(
+                    fd,
+                    std::time::Instant::now() + std::time::Duration::from_secs(2),
+                ) {
+                    if raw & 0x7f == 0 {
+                        facts.payload_wait_status =
+                            maos_domain::sandbox::ContainerPayloadWaitStatus::Exited;
+                        facts.exit_code = Some((raw >> 8) & 0xff);
+                    } else if raw & 0x7f != 0x7f {
+                        facts.payload_wait_status =
+                            maos_domain::sandbox::ContainerPayloadWaitStatus::Signaled;
+                        facts.exit_signal = Some(raw & 0x7f);
+                    }
+                }
+            }
+            facts
