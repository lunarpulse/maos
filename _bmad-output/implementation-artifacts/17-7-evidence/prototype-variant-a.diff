+/// Open a pidfd for a process without requiring it to be our child.
+pub fn open_pidfd(pid: u32) -> io::Result<std::os::fd::OwnedFd> {
+    use std::os::fd::FromRawFd;
+    // SAFETY: pidfd_open accepts an integer PID and flags and returns a fresh fd.
+    let fd = unsafe { libc::syscall(libc::SYS_pidfd_open, pid as libc::pid_t, 0) as i32 };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: successful pidfd_open returns a new owned descriptor.
+    Ok(unsafe { std::os::fd::OwnedFd::from_raw_fd(fd) })
+}
+
+#[repr(C)]
+struct PidfdInfo {
+    mask: u64,
+    cgroupid: u64,
+    pid: u32,
+    tgid: u32,
+    ppid: u32,
+    ruid: u32,
+    rgid: u32,
+    euid: u32,
+    egid: u32,
+    suid: u32,
+    sgid: u32,
+    fsuid: u32,
+    fsgid: u32,
+    exit_code: i32,
+}
+
+/// Return the raw wait status once the process has exited and been reaped.
+pub fn pidfd_exit_status(fd: &std::os::fd::OwnedFd, deadline: std::time::Instant) -> Option<i32> {
+    let mut pfd = libc::pollfd {
+        fd: fd.as_raw_fd(),
+        events: libc::POLLHUP | libc::POLLIN,
+        revents: 0,
+    };
+    loop {
+        let remaining = deadline.checked_duration_since(std::time::Instant::now())?;
+        let ms = remaining.as_millis().min(i32::MAX as u128) as i32;
+        // SAFETY: pfd points to one initialized pollfd for the duration of poll.
+        let result = unsafe { libc::poll(&mut pfd, 1, ms) };
+        if result == 0 {
+            return None;
+        }
+        if result < 0 {
+            let error = io::Error::last_os_error();
+            if error.kind() == io::ErrorKind::Interrupted {
+                continue;
+            }
+            return None;
+        }
+        if pfd.revents & (libc::POLLHUP | libc::POLLIN) == 0 {
+            continue;
+        }
+        loop {
+            let mut info = PidfdInfo {
+                mask: 1 << 3,
+                cgroupid: 0,
+                pid: 0,
+                tgid: 0,
+                ppid: 0,
+                ruid: 0,
+                rgid: 0,
+                euid: 0,
+                egid: 0,
+                suid: 0,
+                sgid: 0,
+                fsuid: 0,
+                fsgid: 0,
+                exit_code: 0,
+            };
+            // SAFETY: ioctl uses the Linux PIDFD_GET_INFO _IOWR request and a writable
+            // version-0 64-byte pidfd_info structure matching the kernel UAPI.
+            let result =
+                unsafe { libc::ioctl(fd.as_raw_fd(), 0xc040_ff0b_u32 as libc::c_ulong, &mut info) };
+            if result < 0 {
+                let error = io::Error::last_os_error();
+                if error.raw_os_error() == Some(libc::ENOTTY)
+                    || error.raw_os_error() == Some(libc::EINVAL)
+                {
+                    return None;
+                }
+                return None;
+            }
+            if info.mask & (1 << 3) != 0 {
+                return Some(info.exit_code);
+            }
+            if std::time::Instant::now() >= deadline {
+                return None;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(10));
+        }
+    }
+}
