+    }
+    pub fn kill(&self) -> std::io::Result<()> {
+        let out = super::spawn::runtime_call_bounded(&self.runtime.path, &["kill", &self.cid])
+            .ok_or_else(|| {
+                std::io::Error::new(std::io::ErrorKind::TimedOut, "runtime kill timed out")
+            })?;
+        if out.status.success() {
+            Ok(())
+        } else {
+            Err(std::io::Error::other("runtime kill failed"))
+        }
+    }
+    pub fn remove(&self) -> Result<(), String> {
+        let out = super::spawn::runtime_call_bounded(
+            &self.runtime.path,
+            &["rm", "--force", "--volumes", "--time=0", &self.cid],
+        )
+        .ok_or_else(|| "runtime rm timed out".to_owned())?;
+        if out.status.success() {
+            Ok(())
+        } else {
+            Err(String::from_utf8_lossy(&out.stderr).into_owned())
+        }
+    }
+}
 
