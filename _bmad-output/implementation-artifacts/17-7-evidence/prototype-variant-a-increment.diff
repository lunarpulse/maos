+use maos_domain::sandbox::{
+    ContainerObservationAvailability, ContainerPayloadWaitStatus, ContainerRuntimeKind,
+};
+use maos_kernel_core::security::sandbox::{
+    t3::{
+        argv::build_runtime_argv,
+        child::parse_container_state,
+        image_lock::VerifiedImageAttestation,
+        runtime_detect::ContainerRuntime,
+        spawn::{read_pidfile, valid_cid, validate_state_dir},
+    },
+    SandboxSpec,
+};
+use std::io::BufRead;
+use std::{
+    fs,
+    os::unix::fs::PermissionsExt,
+    path::PathBuf,
+    process::Command,
+    time::{Duration, Instant},
+};
+
+fn check(ok: bool, name: &str) {
+    assert!(ok, "{name}");
+    println!("PASS {name}");
+}
+
+fn main() {
+    let image =
+        VerifiedImageAttestation::for_probe("registry.example/probe:latest".into(), [7; 32]);
+    let runtime = ContainerRuntime {
+        kind: ContainerRuntimeKind::Podman,
+        path: PathBuf::from("/usr/bin/podman"),
+        version: "probe".into(),
+    };
+    let root = std::env::temp_dir().join(format!("maos-17-7-probe-{}", std::process::id()));
+    let _ = fs::remove_dir_all(&root);
+    fs::create_dir(&root).unwrap();
+    fs::set_permissions(&root, fs::Permissions::from_mode(0o700)).unwrap();
+    let state_dir = root.join("state");
+    fs::create_dir(&state_dir).unwrap();
+    fs::set_permissions(&state_dir, fs::Permissions::from_mode(0o700)).unwrap();
+    let spec = SandboxSpec::new_for_test(maos_domain::invariants::i9::SandboxTier::T3);
+    let argv = build_runtime_argv(
+        &runtime,
+        &image,
+        &spec,
+        PathBuf::from("/tmp/spirit").as_path(),
+        &["echo".into()],
+        "spirit",
+        1,
+        "name",
+        &state_dir.join("init.pid"),
+        None,
+        &[("PROBE_SECRET".into(), "secret-value".into())],
+    )
+    .unwrap();
+    check(
+        argv.iter().any(|s| s == "create") && !argv.iter().any(|s| s == "run" || s == "--rm"),
+        "create argv replaces run and rm",
+    );
+    check(
+        argv.iter().any(|s| s == "--restart=no"),
+        "create argv disables restart",
+    );
+    check(
+        argv.iter()
+            .any(|s| s == &format!("--pidfile={}", state_dir.join("init.pid").display())),
+        "pidfile argv path",
+    );
+    check(
+        argv.iter().any(|s| s == "--env=PROBE_SECRET")
+            && !argv.iter().any(|s| s.contains("secret-value")),
+        "env passes name only",
+    );
+    check(
+        valid_cid(&"a".repeat(64))
+            && !valid_cid(&"A".repeat(64))
+            && !valid_cid(&"a".repeat(63))
+            && !valid_cid(&format!("{}g", "a".repeat(63))),
+        "CID validation",
+    );
+
+    let pid = state_dir.join("init.pid");
+    check(read_pidfile(&pid).is_err(), "missing pidfile refused");
+    #[cfg(unix)]
+    std::os::unix::fs::symlink(root.join("nonexistent"), &pid).unwrap();
+    check(read_pidfile(&pid).is_err(), "symlink pidfile refused");
+    fs::remove_file(&pid).unwrap();
+    fs::create_dir(&pid).unwrap();
+    check(read_pidfile(&pid).is_err(), "non-regular pidfile refused");
+    fs::remove_dir(&pid).unwrap();
+    fs::write(&pid, "nope\n").unwrap();
+    check(read_pidfile(&pid).is_err(), "non-numeric pidfile refused");
+    fs::write(&pid, "0\n").unwrap();
+    check(read_pidfile(&pid).is_err(), "zero pidfile refused");
+    fs::remove_file(&pid).unwrap();
+    check(
+        validate_state_dir(&state_dir).is_ok(),
+        "fresh private state directory accepted",
+    );
+    fs::write(&pid, "123\n").unwrap();
+    check(
+        validate_state_dir(&state_dir).is_err(),
+        "stale pre-existing pidfile refused",
+    );
+    fs::remove_file(&pid).unwrap();
+    let wrong = root.join("wrong-mode");
+    fs::create_dir(&wrong).unwrap();
+    fs::set_permissions(&wrong, fs::Permissions::from_mode(0o755)).unwrap();
+    check(
+        validate_state_dir(&wrong).is_err(),
+        "wrong state directory mode refused",
+    );
+
+    let runtime_name = "podman";
+    for (ver, status, code, oom) in [
+        ("4.9", "exited", 0, false),
+        ("5.7", "exited", 137, false),
+        ("5.7", "exited", 137, true),
+    ] {
+        let data = serde_json::json!({"Status":status,"ExitCode":code,"OOMKilled":oom,"Error":"","StartedAt":"2026-10-13T00:00:00Z","FinishedAt":"2026-10-13T00:00:01Z","Pid":0});
+        let facts = parse_container_state(
+            data.to_string().as_bytes(),
+            runtime_name,
+            "a".repeat(64).as_str(),
+            123,
+        );
+        check(
+            facts.observation == ContainerObservationAvailability::Available
+                && facts.runtime_exit_code == Some(code)
+                && facts.oom_marker == Some(oom),
+            &format!("{ver} state exit={code} OOMKilled={oom}"),
+        );
+    }
+    let malformed = parse_container_state(b"{not-json", runtime_name, "cid", 123);
+    check(
+        malformed.observation == ContainerObservationAvailability::Unavailable,
+        "malformed inspect is unavailable",
+    );
+
+    let uname = Command::new("uname").arg("-r").output().unwrap();
+    assert!(uname.status.success());
+    println!("kernel {}", String::from_utf8(uname.stdout).unwrap().trim());
+    let mut exited = Command::new("sh")
+        .args(["-c", "(sleep 0.3; exit 137) & p=$!; echo $p; wait $p"])
+        .stdout(std::process::Stdio::piped())
+        .spawn()
+        .unwrap();
+    let mut line = String::new();
+    std::io::BufReader::new(exited.stdout.take().unwrap())
+        .read_line(&mut line)
+        .unwrap();
+    let exited_pid: u32 = line.trim().parse().unwrap();
+    let fd = maos_kernel_core::security::sandbox::linux::open_pidfd(exited_pid).unwrap();
+    let raw = maos_kernel_core::security::sandbox::linux::pidfd_exit_status(
+        &fd,
+        Instant::now() + Duration::from_secs(8),
+    )
+    .expect("exit info");
+    let _ = exited.wait().unwrap();
+    check(
+        raw & 0x7f == 0 && (raw >> 8) & 0xff == 137,
+        "non-child Exited(137) pidfd status",
+    );
+
+    let mut signaled = Command::new("sh")
+        .args(["-c", "sleep 30 & p=$!; echo $p; wait $p"])
+        .stdout(std::process::Stdio::piped())
+        .spawn()
+        .unwrap();
+    let mut line = String::new();
+    std::io::BufReader::new(signaled.stdout.take().unwrap())
+        .read_line(&mut line)
+        .unwrap();
+    let signal_pid: u32 = line.trim().parse().unwrap();
+    let signal_fd = maos_kernel_core::security::sandbox::linux::open_pidfd(signal_pid).unwrap();
+    let kill = Command::new("kill")
+        .args(["-KILL", &signal_pid.to_string()])
+        .status()
+        .unwrap();
+    assert!(kill.success());
+    let raw = maos_kernel_core::security::sandbox::linux::pidfd_exit_status(
+        &signal_fd,
+        Instant::now() + Duration::from_secs(8),
+    )
+    .expect("signal info");
+    let _ = signaled.wait().unwrap();
+    check(raw & 0x7f == 9, "non-child Signaled(9) pidfd status");
+
+    let already = Command::new("sh")
+        .args(["-c", "(exit 0) & p=$!; wait $p; echo $p"])
+        .output()
+        .unwrap();
+    let already_pid: u32 = String::from_utf8(already.stdout)
+        .unwrap()
+        .trim()
+        .parse()
+        .unwrap();
+    let unknown = maos_kernel_core::security::sandbox::linux::open_pidfd(already_pid).err();
+    check(
+        unknown
+            .as_ref()
+            .is_some_and(|e| e.raw_os_error() == Some(libc::ESRCH)),
+        "reaped process open returns ESRCH/Unknown",
+    );
+    assert_eq!(
+        ContainerPayloadWaitStatus::Unknown,
+        ContainerPayloadWaitStatus::Unknown
+    );
+    let _ = fs::remove_dir_all(root);
+}
