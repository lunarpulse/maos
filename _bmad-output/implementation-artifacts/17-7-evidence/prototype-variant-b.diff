+//! RAII guard for the runtime client and its persistent container.
 use super::runtime_detect::ContainerRuntime;
+pub use maos_domain::sandbox::ContainerTerminalFacts;
+use std::{
+    path::PathBuf,
+    process::Child,
+    sync::{Arc, OnceLock},
+};
+
+pub struct ContainerTerminal {
+    pub runtime: ContainerRuntime,
+    pub cid: String,
+    startup_pid: u32,
+    facts: OnceLock<ContainerTerminalFacts>,
+}
+#[doc(hidden)]
+pub fn parse_container_state(
+    bytes: &[u8],
+    runtime: &str,
+    cid: &str,
+    startup_pid: u32,
+) -> ContainerTerminalFacts {
+    let unavailable = || ContainerTerminalFacts {
+        observation: maos_domain::sandbox::ContainerObservationAvailability::Unavailable,
+        payload_wait_status: maos_domain::sandbox::ContainerPayloadWaitStatus::Unknown,
+        exit_code: None,
+        exit_signal: None,
+        runtime_status: String::new(),
+        runtime_exit_code: None,
+        oom_marker: None,
+        runtime_error: None,
+        started_at: None,
+        finished_at: None,
+        observed_pid: Some(startup_pid),
+        container_id: cid.into(),
+        runtime: runtime.into(),
+    };
+    let Ok(state) = serde_json::from_slice::<serde_json::Value>(bytes) else {
+        return unavailable();
+    };
+    let (Some(status), Some(exit_code), Some(oom_marker)) = (
+        state.get("Status").and_then(|v| v.as_str()),
+        state
+            .get("ExitCode")
+            .and_then(|v| v.as_i64())
+            .and_then(|v| i32::try_from(v).ok()),
+        state.get("OOMKilled").and_then(|v| v.as_bool()),
+    ) else {
+        return unavailable();
+    };
+    ContainerTerminalFacts {
+        observation: maos_domain::sandbox::ContainerObservationAvailability::Available,
+        payload_wait_status: maos_domain::sandbox::ContainerPayloadWaitStatus::Unknown,
+        exit_code: None,
+        exit_signal: None,
+        runtime_status: status.into(),
+        runtime_exit_code: Some(exit_code),
+        oom_marker: Some(oom_marker),
+        runtime_error: state
+            .get("Error")
+            .and_then(|v| v.as_str())
+            .filter(|s| !s.is_empty())
+            .map(str::to_owned),
+        started_at: state
+            .get("StartedAt")
+            .and_then(|v| v.as_str())
+            .map(str::to_owned),
+        finished_at: state
+            .get("FinishedAt")
+            .and_then(|v| v.as_str())
+            .map(str::to_owned),
+        observed_pid: state
+            .get("Pid")
+            .and_then(|v| v.as_u64())
+            .and_then(|v| u32::try_from(v).ok()),
+        container_id: cid.into(),
+        runtime: runtime.into(),
+    }
+}
+impl ContainerTerminal {
+    pub(crate) fn new(runtime: ContainerRuntime, cid: String, startup_pid: u32) -> Self {
+        Self {
+            runtime,
+            cid,
+            startup_pid,
+            facts: OnceLock::new(),
+        }
+    }
+    pub fn facts(&self) -> &ContainerTerminalFacts {
+        self.facts.get_or_init(|| {
+            let unavailable = || ContainerTerminalFacts {
+                observation: maos_domain::sandbox::ContainerObservationAvailability::Unavailable,
+                payload_wait_status: maos_domain::sandbox::ContainerPayloadWaitStatus::Unknown,
+                exit_code: None,
+                exit_signal: None,
+                runtime_status: String::new(),
+                runtime_exit_code: None,
+                oom_marker: None,
+                runtime_error: None,
+                started_at: None,
+                finished_at: None,
+                observed_pid: Some(self.startup_pid),
+                container_id: self.cid.clone(),
+                runtime: self.runtime.kind.as_str().to_owned(),
+            };
+            let out = match super::spawn::runtime_call_bounded_for(
+                &self.runtime.path,
+                &["inspect", "--format", "{{json .State}}", &self.cid],
+                std::time::Duration::from_secs(2),
+            ) {
+                Some(out) if out.status.success() => out,
+                _ => return unavailable(),
+            };
+            let Ok(state) = serde_json::from_slice::<serde_json::Value>(&out.stdout) else {
+                return unavailable();
+            };
+            let (status, runtime_code, oom, error, started, finished, pid) = match (
+                state.get("Status").and_then(|v| v.as_str()),
+                state
+                    .get("ExitCode")
+                    .and_then(|v| v.as_i64())
+                    .and_then(|v| i32::try_from(v).ok()),
+                state.get("OOMKilled").and_then(|v| v.as_bool()),
+                state.get("Error").and_then(|v| v.as_str()),
+                state.get("StartedAt").and_then(|v| v.as_str()),
+                state.get("FinishedAt").and_then(|v| v.as_str()),
+                state
+                    .get("Pid")
+                    .and_then(|v| v.as_u64())
+                    .and_then(|v| u32::try_from(v).ok()),
+            ) {
+                (Some(a), Some(b), Some(c), d, e, f, Some(g)) => (
+                    a.to_owned(),
+                    b,
+                    c,
+                    d.map(str::to_owned),
+                    e.map(str::to_owned),
+                    f.map(str::to_owned),
+                    g,
+                ),
+                _ => return unavailable(),
+            };
+            ContainerTerminalFacts {
+                observation: maos_domain::sandbox::ContainerObservationAvailability::Available,
+                payload_wait_status: maos_domain::sandbox::ContainerPayloadWaitStatus::Unknown,
+                exit_code: None,
+                exit_signal: None,
+                runtime_status: status,
+                runtime_exit_code: Some(runtime_code),
+                oom_marker: Some(oom),
+                runtime_error: error,
+                started_at: started,
+                finished_at: finished,
+                observed_pid: Some(pid),
+                container_id: self.cid.clone(),
+                runtime: self.runtime.kind.as_str().to_owned(),
+            }
+        })
+    }
+    pub fn kill(&self) -> std::io::Result<()> {
+        let out = super::spawn::runtime_call_bounded(&self.runtime.path, &["kill", &self.cid])
+            .ok_or_else(|| {
+                std::io::Error::new(std::io::ErrorKind::TimedOut, "runtime kill timed out")
+            })?;
+        if out.status.success() {
+            Ok(())
+        } else {
+            Err(std::io::Error::other("runtime kill failed"))
+        }
+    }
+    pub fn remove(&self) -> Result<(), String> {
+        let out = super::spawn::runtime_call_bounded(
+            &self.runtime.path,
+            &["rm", "--force", "--volumes", "--time=0", &self.cid],
+        )
+        .ok_or_else(|| "runtime rm timed out".to_owned())?;
+        if out.status.success() {
+            Ok(())
+        } else {
+            Err(String::from_utf8_lossy(&out.stderr).into_owned())
+        }
+    }
+}
 
