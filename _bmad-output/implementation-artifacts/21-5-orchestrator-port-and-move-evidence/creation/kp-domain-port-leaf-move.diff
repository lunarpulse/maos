-                tokio::spawn(async move {
-                    let secret_ref = arc_sub.auth_secret_ref();
-                    let _secret = match secrets.resolve(secret_ref).await {
-                        Ok(bytes) => bytes,
-                        Err(e) => {
-                            tl.write_lifecycle(
