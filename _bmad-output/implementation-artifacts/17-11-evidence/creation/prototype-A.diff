+//! Story 17-11 creation prototype — `Scope::entitles` vectors (removed after measurement).
+
+use maos_domain::invariants::i1::Scope;
+
+fn fs(s: &str) -> Scope {
+    Scope::FsRead { subtree: s.into() }
+}
+
+#[test]
+fn fs_subtree_containment() {
+    let d = fs("/data/project");
+    for ok in [
+        "/data/project",
+        "/data/project/",
+        "/data/project/a/b",
+        "/data//project/./a",
+    ] {
+        assert!(d.entitles(&fs(ok)), "{ok}");
+    }
+    for no in [
+        "/data/projectX",
+        "/data",
+        "/",
+        "/data/project/../secret",
+        "/data/project/a/../../x",
+        "data/project",
+        "/other",
+        "",
+    ] {
+        assert!(!d.entitles(&fs(no)), "{no}");
+    }
+    assert!(!fs("/data/../etc").entitles(&fs("/etc/passwd")));
+    assert!(fs("rel").entitles(&fs("rel/x")));
+    assert!(!fs("rel").entitles(&fs("/rel/x")));
+    assert!(!fs("/data").entitles(&Scope::FsWrite {
+        subtree: "/data".into()
+    }));
+}
+
+#[test]
+fn identifiers_are_exact() {
+    let m = |s: &str, t: &str| Scope::McpCall {
+        server: s.into(),
+        tool: t.into(),
+    };
+    assert!(m("fs", "read").entitles(&m("fs", "read")));
+    assert!(!m("fs", "read").entitles(&m("fs", "write")));
+    assert!(!m("fs", "read").entitles(&m("gh", "read")));
+    let n = |d: &str| Scope::NetHttps { domain: d.into() };
+    assert!(n("api.example.com").entitles(&n("api.example.com")));
+    assert!(!n("example.com").entitles(&n("api.example.com")));
+    assert!(!n("*.example.com").entitles(&n("api.example.com")));
+    let i = |p: &str| Scope::IacSend {
+        peer_class: p.into(),
+    };
+    assert!(!i("butler").entitles(&i("researcher")));
+    assert!(Scope::LoomRead.entitles(&Scope::LoomRead));
+    assert!(!Scope::LoomRead.entitles(&Scope::LoomWrite));
+    let c = |h: u8| Scope::CliSubprocessSpawn {
+        cli_binary_path: "/usr/bin/git".into(),
+        argv_prefix_hash: [h; 32],
+        output_shape_version: "1".into(),
+    };
+    assert!(c(1).entitles(&c(1)));
+    assert!(!c(1).entitles(&c(2)));
+}
