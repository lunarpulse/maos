+impl Scope {
+    /// Story 17-11 — `true` when this *declared* scope entitles `requested` at
+    /// issuance. `FsRead`/`FsWrite` admit the declared subtree or a path beneath
+    /// it by lexical comparison (a `..` component on either side or an
+    /// absolute/relative mismatch refuses; symlinks are never resolved here);
+    /// every other variant matches only an equal scope, selectors included.
+    pub fn entitles(&self, requested: &Scope) -> bool {
+        match (self, requested) {
+            (Scope::FsRead { subtree: d }, Scope::FsRead { subtree: r })
+            | (Scope::FsWrite { subtree: d }, Scope::FsWrite { subtree: r }) => {
+                subtree_contains(d, r)
+            }
+            _ => self == requested,
+        }
+    }
+}
+
+/// Lexical, allocation-free subtree containment (Story 17-11).
+fn subtree_contains(declared: &str, requested: &str) -> bool {
+    fn parts(p: &str) -> impl Iterator<Item = &str> {
+        p.split('/').filter(|c| !c.is_empty() && *c != ".")
+    }
+    if declared.starts_with('/') != requested.starts_with('/')
+        || parts(declared).chain(parts(requested)).any(|c| c == "..")
+    {
+        return false;
+    }
+    let mut r = parts(requested);
+    parts(declared).all(|d| r.next() == Some(d))
+}
