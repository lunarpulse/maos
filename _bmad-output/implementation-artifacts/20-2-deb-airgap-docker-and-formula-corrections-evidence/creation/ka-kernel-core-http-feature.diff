+/// Story 20-2 (D-20-2-01 B) — the air-gap build compiles HTTP out; every call
+/// is a typed transport refusal, never a silent success.
+#[cfg(not(feature = "http"))]
+fn compiled_out(method: &str, url: &str) -> IoError {
+    IoError::Transport(format!(
+        "{method} {url}: HTTP is compiled out of this build"
+    ))
