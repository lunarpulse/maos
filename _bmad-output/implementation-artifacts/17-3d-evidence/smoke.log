PROBE SOURCE (excluded from kernel physical and tokei instrumentation; committed only in isolated repository)
use std::io::{Read, Write};
use std::os::fd::{AsRawFd, FromRawFd};
use std::os::unix::net::UnixStream;
use std::os::unix::process::ExitStatusExt;
use std::process::{Command, Stdio};
use std::time::Duration;

use maos_domain::invariants::i9::SandboxTier;
use maos_kernel_core::security::sandbox::{spawn_sandboxed, SandboxSpec};

fn child(fd: i32) {
    // SAFETY: fcntl inspects the inherited descriptor without dereferencing memory.
    if unsafe { libc::fcntl(fd, libc::F_GETFD) } == -1 {
        eprintln!(
            "CHILD fd-check errno={:?}",
            std::io::Error::last_os_error().raw_os_error()
        );
        std::process::exit(9);
    }
    // SAFETY: only this process owns the inherited endpoint after exec.
    let mut stream = unsafe { UnixStream::from_raw_fd(fd) };
    let mut input = [0; 4];
    if let Err(e) = stream.read_exact(&mut input) {
        eprintln!("CHILD recv errno={:?} {e}", e.raw_os_error());
        std::process::exit(71);
    }
    assert_eq!(&input, b"ping");
    if let Err(e) = stream.write_all(b"pong") {
        eprintln!("CHILD send errno={:?} {e}", e.raw_os_error());
        std::process::exit(72);
    }
    eprintln!("CHILD roundtrip=ok");
}

fn main() {
    let args: Vec<_> = std::env::args().collect();
    if args.get(1).is_some_and(|arg| arg == "--child") {
        child(args[2].parse().unwrap());
        return;
    }
    let (mut service, runner) = UnixStream::pair().unwrap();
    service
        .set_read_timeout(Some(Duration::from_secs(2)))
        .unwrap();
    let fd = runner.as_raw_fd();
    let flags = unsafe { libc::fcntl(fd, libc::F_GETFD) };
    println!(
        "PARENT runner_fd={fd} CLOEXEC={}",
        flags & libc::FD_CLOEXEC != 0
    );
    let mut spec = SandboxSpec::new_for_test(SandboxTier::T2);
    spec.inherited_recall_fd = Some(fd);
    let mut command = Command::new(std::env::current_exe().unwrap());
    command
        .args(["--child", &fd.to_string()])
        .stdout(Stdio::piped())
        .stderr(Stdio::piped());
    match spawn_sandboxed(&spec, &mut command) {
        Ok(mut sandboxed) => {
            drop(runner);
            let write = service.write_all(b"ping");
            let mut response = [0; 4];
            let read = service.read_exact(&mut response);
            let status = sandboxed.wait().unwrap();
            let mut stderr = String::new();
            sandboxed
                .child_mut()
                .stderr
                .take()
                .unwrap()
                .read_to_string(&mut stderr)
                .unwrap();
            println!("RESULT status={status} code={:?} signal={:?} write={write:?} read={read:?} reply={response:?}", status.code(), status.signal());
            print!("{stderr}");
        }
        Err(error) => println!("REFUSED {error:?}: {error}"),
    }
}
