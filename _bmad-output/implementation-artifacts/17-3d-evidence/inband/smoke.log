--- /dev/null
+++ b/crates/maos-wasm-host/guests/recall-probe/src/lib.rs
@@ -0,0 +1,59 @@
+//! Throwaway guest exercising the in-band recall and fetch imports.
+
+wit_bindgen::generate!({
+    path: "../../../../wit/spirit.wit",
+    world: "spirit",
+});
+
+use maos::spirit::frames::{FrameKind, FramePayload, TaskCompleteBody};
+use maos::spirit::recall::{self, RecallError, RecallFilter};
+
+struct RecallProbe;
+
+fn error_code(error: RecallError) -> &'static str {
+    match error {
+        RecallError::ScopeViolation => "scope-violation",
+        RecallError::FrameNotFound => "frame-not-found",
+        RecallError::InvalidRequest(_) => "invalid-request",
+        RecallError::LimitExceeded(_) => "limit-exceeded",
+        RecallError::CapabilityDenied => "capability-denied",
+        RecallError::ConsentWithheld => "consent-withheld",
+        RecallError::ReplyTooLarge(_) => "reply-too-large",
+        RecallError::Unavailable => "unavailable",
+    }
+}
+
+impl Guest for RecallProbe {
+    fn handle_frame(mut frame: IacFrame) -> Result<Vec<IacFrame>, Halt> {
+        let recalled = recall::recall(&RecallFilter {
+            kind: None,
+            since_ns: None,
+            until_ns: None,
+            limit: 16,
+            cursor: None,
+            intent_filter: None,
+        });
+        let fetched = recall::fetch(&frame.frame_id);
+        let recall_status = match recalled {
+            Ok(page) => format!("ok:{}", page.entries.len()),
+            Err(error) => format!("err:{}", error_code(error)),
+        };
+        let fetch_status = match fetched {
+            Ok(_) => "ok".to_owned(),
+            Err(error) => format!("err:{}", error_code(error)),
+        };
+        frame.kind = FrameKind::TaskComplete;
+        frame.payload = FramePayload::TaskComplete(TaskCompleteBody {
+            result_text: format!("recall={recall_status};fetch={fetch_status}"),
+        });
+        Ok(vec![frame])
+    }
+
+    fn on_start() -> Result<(), Halt> {
+        Ok(())
+    }
+
+    fn on_shutdown() {}
+}
+
+export!(RecallProbe);
