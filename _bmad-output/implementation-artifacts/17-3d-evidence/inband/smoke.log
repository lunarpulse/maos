+            "frame-not-found" => E::FrameNotFound,
+            "invalid-request" => E::InvalidRequest(detail.unwrap_or_default()),
+            "limit-exceeded" => match detail.and_then(|s| s.parse().ok()) {
+                Some(value) => E::LimitExceeded(value),
+                None => self.desync(),
+            },
+            "capability-denied" => E::CapabilityDenied,
+            "consent-withheld" => E::ConsentWithheld,
+            "reply-too-large" => match detail.and_then(|s| s.parse().ok()) {
+                Some(value) => E::ReplyTooLarge(value),
+                None => self.desync(),
+            },
+            "unavailable" => E::Unavailable,
+            _ => self.desync(),
+        }
+    }
+
+    fn desync(&mut self) -> wit::RecallError {
+        self.recall_broken = true;
+        wit::RecallError::Unavailable
+    }
 }
 
