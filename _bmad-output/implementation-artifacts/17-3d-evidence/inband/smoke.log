+impl wit::Host for HostState {
+    fn recall(&mut self, filter: wit::RecallFilter) -> Result<wit::RecallPage, wit::RecallError> {
+        let request = Request::Recall { filter: wire::Filter {
+            kind: filter.kind, since_ns: filter.since_ns, until_ns: filter.until_ns,
+            limit: filter.limit, intent_filter: filter.intent_filter,
+            cursor: filter.cursor.map(|cursor| wire::Cursor {
+                last_timestamp_ns: cursor.last_timestamp_ns,
+                last_frame_id: Bytes(cursor.last_frame_id),
+            }),
+        }};
+        match self.exchange(request)? {
+            Reply::Page { entries, next_cursor } => Ok(wit::RecallPage {
+                entries: entries.into_iter().map(|entry| wit::RecallEntry {
+                    frame_id: entry.frame_id.0, timestamp_ns: entry.timestamp_ns,
+                    kind: entry.kind, intent: entry.intent, payload_available: entry.payload_available,
+                }).collect(),
+                next_cursor: next_cursor.map(|cursor| wit::RecallCursor {
+                    last_timestamp_ns: cursor.last_timestamp_ns,
+                    last_frame_id: cursor.last_frame_id.0,
+                }),
+            }),
+            Reply::Error { code, detail } => Err(self.remote_error(code, detail)),
+            _ => Err(self.desync()),
+        }
+    }
+
+    fn fetch(&mut self, frame_id: Vec<u8>) -> Result<wit::FetchResponse, wit::RecallError> {
+        match self.exchange(Request::Fetch { frame_id: Bytes(frame_id) })? {
+            Reply::Fetched { frame_id, timestamp_ns, kind, intent, payload, origin } => {
+                use crate::wit_guest::maos::spirit::frames::FrameOrigin;
+                let origin = match origin.as_str() {
+                    "human-authored" => FrameOrigin::HumanAuthored,
+                    "spirit-auto" => FrameOrigin::SpiritAuto,
+                    "spirit-drafted-human-approved" => FrameOrigin::SpiritDraftedHumanApproved,
+                    "kernel" => FrameOrigin::Kernel,
+                    _ => return Err(self.desync()),
+                };
+                Ok(wit::FetchResponse {
+                    frame_id: frame_id.0, timestamp_ns, kind, intent, payload: payload.0, origin,
+                })
+            }
+            Reply::Error { code, detail } => Err(self.remote_error(code, detail)),
+            _ => Err(self.desync()),
+        }
+    }
+}
