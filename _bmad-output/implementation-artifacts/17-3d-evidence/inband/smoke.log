+            Ok(None) => {
+                self.recall_closed = true;
+                Err(wit::RecallError::Unavailable)
+            }
+            Ok(Some(body)) => match wire::decode_reply(&body) {
+                Ok(reply) => Ok(reply),
+                Err(_) => {
