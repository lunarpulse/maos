@@ -1,4 +1,4 @@
-//! Wasmtime-generated host bindings for the `maos:spirit@2.0.0` world.
+//! Wasmtime-generated host bindings for the `maos:spirit@2.1.0` world.
 //!
 //! Real component-model call path (Story 11.1a AC3) — NOT a hand-rolled
 //! echo loop. The `bindgen!` macro reads `wit/spirit.wit` at compile time
diff --git a/crates/maos-wasm-host/tests/inband_recall_proto.rs b/crates/maos-wasm-host/tests/inband_recall_proto.rs
new file mode 100644
index 0000000..d904958
--- /dev/null
+++ b/crates/maos-wasm-host/tests/inband_recall_proto.rs
@@ -0,0 +1,316 @@
+//! Throwaway in-band recall feasibility evidence. Fixtures are prebuilt by the caller.
+#![cfg(target_os = "linux")]
+
+use std::path::PathBuf;
+use std::time::{Duration, Instant};
+
+use maos_domain::frame::{FrameAddress, FramePayload, IacFrame, TaskAssignPayload};
+use maos_domain::invariants::{i1::{IntentClass, Scope}, i3::FrameOrigin, i9::SandboxTier};
+use maos_kernel_core::lifecycle::cli_wrapper::{
+    argv_prefix_hash, spawn_and_bridge, Backpressure, BridgeError, BridgeSpawnSpec,
+    ExitCause, SpawnedBridge, SubStream,
+};
+use maos_kernel_core::lifecycle::cli_wrapper::runtime::BridgePoll;
+use maos_kernel_core::security::manifest::{CliWrapperControlChannel, CliWrapperStdioShape};
+use maos_kernel_core::security::sandbox::SandboxSpec;
+use maos_spirit_abi::identity::FrameKind;
+use maos_wasm_host::{codec, recall_wire::{self, Bytes, Cursor, Entry, Reply, Request}};
+
+const DEADLINE: Duration = Duration::from_secs(90);
+const OK: &str = "recall=ok:2;fetch=err:scope-violation";
+const UNAVAILABLE: &str = "recall=err:unavailable;fetch=err:unavailable";
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Scenario { Happy, Hostile, Eof, Compat }
+
+fn seed() -> IacFrame {
+    IacFrame {
+        frame_id: [7; 16], timestamp_ns: 123_456_789, logical_clock: 1,
+        from: FrameAddress { spirit_id: "test-spirit".into(), host_id: None, role: None },
+        to: smallvec::smallvec![FrameAddress {
+            spirit_id: "recall-probe".into(), host_id: None, role: None,
+        }],
+        kind: FrameKind::TaskAssign, intent: IntentClass::Standard,
+        payload: FramePayload::TaskAssign(TaskAssignPayload {
+            goal: "exercise in-band recall".into(), scope: vec![],
+            success_criteria: "return exact recall and fetch statuses".into(),
+            posture_preferences: Default::default(), prior_distillate_ref: None,
+        }),
+        auto_marker: FrameOrigin::Kernel, consent_envelope: None,
+        intent_lineage: Default::default(),
+    }
+}
+
+fn component(scenario: Scenario) -> PathBuf {
+    let path = if scenario == Scenario::Compat {
+        PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+            .join("../../tests/fixtures/wasm/echo_spirit_component.wasm")
+    } else {
+        std::env::var_os("MAOS_RECALL_PROBE_COMPONENT").map(PathBuf::from)
+            .unwrap_or_else(|| PathBuf::from(
+                "/mnt/build/cargo-17-3d-inband-guest/wasm32-wasip2/release/recall_probe.wasm"))
+    };
+    assert!(path.is_file(), "prebuilt component missing: {}", path.display());
+    path.canonicalize().expect("canonical component path")
+}
+
+fn entry(index: u64) -> Entry {
+    Entry {
+        frame_id: Bytes((index as u128).to_be_bytes().to_vec()),
+        timestamp_ns: 1_700_000_000_000_000_000 + index,
+        kind: "TaskComplete".into(), intent: "Standard".into(), payload_available: true,
+    }
+}
+
+fn run(name: &str, tier: SandboxTier, scenario: Scenario) {
+    let component = component(scenario);
+    let runner = std::env::var_os("MAOS_INBAND_RUNNER").map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from(env!("CARGO_BIN_EXE_maos-wasm-runner")));
+    assert!(runner.is_file(), "prebuilt runner missing: {}", runner.display());
+    let argv = vec!["--component".into(), component.to_string_lossy().into_owned(),
+        "--fuel".into(), "1000000000".into()];
+    let spawn = spawn_and_bridge(BridgeSpawnSpec {
+        program: runner.to_string_lossy().into_owned(),
+        sandbox: SandboxSpec {
+            tier, resolved_caps: Default::default(),
+            declared_scopes: vec![Scope::FsRead {
+                subtree: component.to_string_lossy().into_owned(),
+            }],
+            spirit_id: format!("inband-{name}"), output_shape_predicate: None,
+        },
+        expected_argv_prefix_hash: argv_prefix_hash(&argv), argv_prefix: argv,
+        task_args: vec![], from_spirit_id: format!("inband-{name}"),
+        stdio_shape: CliWrapperStdioShape::JsonRpcOverStdio,
+        control_channel: CliWrapperControlChannel::Signals, shutdown_signal: None,
+        channel_capacity: 8, backpressure: Backpressure::Block, env: vec![], t3: None,
+    });
+    let mut bridge = match spawn {
+        Ok(bridge) => bridge,
+        Err(BridgeError::SandboxRefused(reason)) if tier == SandboxTier::T2 => {
+            // The real bridge preserves the refusal as text, not SpawnError's io kind.
+            // Only permission refusals are environmental skips; other setup errors fail.
+            let permission = reason.contains("Permission denied")
+                || reason.contains("Operation not permitted");
+            if permission && std::env::var_os("CI").is_none()
+                && std::env::var_os("GITHUB_ACTIONS").is_none() {
+                eprintln!("SKIP {name}: T2 sandbox refused: {reason}");
+                return;
+            }
+            panic!("{name}: T2 sandbox refused: {reason}");
+        }
+        Err(error) => panic!("{name}: spawn failed: {error}"),
+    };
+    assert_ne!(bridge.child_pid(), std::process::id());
+    let until = Instant::now() + DEADLINE;
+    let mut stderr = String::new();
+    let ready = next_stdout(&mut bridge, until, &mut stderr).expect("Ready before EOF");
+    assert!(ready.is_empty(), "expected Ready, stderr={stderr}");
+    assert!(bridge.try_exit_cause().unwrap().is_none(), "runner must be alive at Ready");
+    if tier == SandboxTier::T2 {
+        let status = std::fs::read_to_string(format!("/proc/{}/status", bridge.child_pid()))
+            .expect("live sandbox proc status");
+        let seccomp = status.lines().find_map(|line| line.strip_prefix("Seccomp:"))
+            .expect("Seccomp field").trim();
+        assert_eq!(seccomp, "2", "T2 runner must have an active seccomp filter");
+        println!("{name}: Seccomp=2 alive=true");
+    }
+    let sent = seed();
+    let body = codec::encode_cbor(&sent).unwrap();
+    let mut writer = Some(bridge.take_frame_writer().unwrap());
+    writer.as_mut().unwrap().write_frame(&body).unwrap();
+    let mut requests = 0;
+    let mut fetches = 0;
+    let mut outputs = 0;
+    let mut complete = false;
+    while let Some(bytes) = next_stdout(&mut bridge, until, &mut stderr) {
+        if bytes.is_empty() {
+            assert!(!complete, "duplicate TurnComplete");
+            assert_eq!(outputs, 1, "guest output must precede TurnComplete");
+            complete = true;
+            // Hostile must exit without another stdin read: leave stdin OPEN.
+            if scenario != Scenario::Hostile { writer.take(); }
+        } else if recall_wire::is_tagged(&bytes) {
+            assert!(!complete, "request after TurnComplete");
+            requests += 1;
+            let request = recall_wire::decode_request(&bytes).expect("tagged request");
+            let reply = match request {
+                Request::Recall { filter } => {
+                    assert_eq!(requests, 1, "only one recall permitted");
+                    assert_eq!(filter.limit, 16, "probe recall limit");
+                    match scenario {
+                        Scenario::Hostile => {
+                            writer.as_mut().unwrap().write_frame(&body).unwrap();
+                            continue;
+                        }
+                        Scenario::Eof => { writer.take(); continue; }
+                        Scenario::Compat => panic!("@2.0.0 echo issued a recall request"),
+                        Scenario::Happy => Reply::Page {
+                            entries: vec![entry(1), entry(2)], next_cursor: None,
+                        },
+                    }
+                }
+                Request::Fetch { frame_id } => {
+                    fetches += 1;
+                    assert!(scenario == Scenario::Happy, "latched unavailable must not send fetch");
+                    assert_eq!(requests, 2);
+                    assert_eq!(frame_id.0, sent.frame_id, "fetch the seed frame id");
+                    Reply::Error { code: "scope-violation".into(), detail: None }
+                }
+            };
+            writer.as_mut().expect("reply stdin open")
+                .write_frame(&recall_wire::encode_reply(&reply).unwrap()).unwrap();
+        } else {
+            assert!(!complete, "output after TurnComplete");
+            outputs += 1;
+            let output: IacFrame = codec::decode_cbor(&bytes).expect("guest IAC output");
+            if scenario == Scenario::Compat {
+                assert_eq!(bytes, body, "committed @2.0.0 fixture byte-identical echo");
+                assert_eq!(output, sent);
+            } else {
+                assert_eq!(output.frame_id, sent.frame_id);
+                assert_eq!(output.kind, FrameKind::TaskComplete);
+                let FramePayload::TaskComplete(payload) = output.payload else {
+                    panic!("probe must emit TaskComplete");
+                };
+                let expected = if scenario == Scenario::Happy { OK } else { UNAVAILABLE };
+                assert_eq!(payload.result, expected);
+                println!("{name}: {}", payload.result);
+            }
+        }
+    }
+    assert!(complete, "missing TurnComplete; stderr={stderr}");
+    assert_eq!(outputs, 1);
+    let expected_requests = match scenario {
+        Scenario::Happy => 2, Scenario::Compat => 0, _ => 1,
+    };
+    assert_eq!(requests, expected_requests, "tagged request count");
+    assert_eq!(fetches, usize::from(scenario == Scenario::Happy));
+    let cause = loop {
+        assert!(Instant::now() < until, "{name}: exit deadline; stderr={stderr}");
+        if let Some(cause) = bridge.try_exit_cause().unwrap() { break cause; }
+        std::thread::sleep(Duration::from_millis(10));
+    };
+    if scenario == Scenario::Hostile {
+        assert!(matches!(cause, ExitCause::Exited { code } if code != 0),
+            "hostile reply must terminate with nonzero code, not signal: {cause:?}");
+        assert!(stderr.to_ascii_lowercase().contains("desync"),
+            "typed desync diagnostic missing: {stderr}");
+    } else {
+        assert_eq!(cause, ExitCause::Exited { code: 0 }, "stderr={stderr}");
+    }
+    if scenario == Scenario::Eof {
+        assert!(!stderr.to_ascii_lowercase().contains("trap"), "unexpected trap: {stderr}");
+    }
+    println!("{name}: status={cause:?}; tagged_requests={requests}; fetch_requests={fetches}; stderr={stderr:?}");
+    drop(writer);
+}
+
+fn next_stdout(bridge: &mut SpawnedBridge, until: Instant, stderr: &mut String) -> Option<Vec<u8>> {
+    loop {
+        assert!(Instant::now() < until, "frame deadline; stderr={stderr}");
+        match bridge.poll_frame(Duration::from_millis(20)).expect("poll framed bridge") {
+            BridgePoll::Idle => {},
+            BridgePoll::Closed => return None,
+            BridgePoll::Data(SubStream::Stderr, bytes) => {
+                stderr.push_str(&String::from_utf8_lossy(&bytes));
+                stderr.push('\n');
+            }
+            BridgePoll::Data(SubStream::Stdout, bytes) => return Some(bytes),
+        }
+    }
+}
+
+#[test]
+fn happy_path_t2() { run("happy_path_t2", SandboxTier::T2, Scenario::Happy); }
+
+#[test]
+fn happy_path_t0() { run("happy_path_t0", SandboxTier::T0, Scenario::Happy); }
+
+#[test]
+fn hostile_reply() { run("hostile_reply", SandboxTier::T2, Scenario::Hostile); }
+
+#[test]
+fn eof() { run("eof", SandboxTier::T2, Scenario::Eof); }
+
+#[test]
+fn compat_2_0_t2() { run("compat_2_0_t2", SandboxTier::T2, Scenario::Compat); }
+
+#[test]
+fn reply_budget() {
+    let fetched = Reply::Fetched {
+        frame_id: Bytes(vec![7; 16]), timestamp_ns: 123_456_789,
+        kind: "TaskComplete".into(), intent: "Standard".into(),
+        payload: Bytes(vec![0xff; 1024 * 1024]), origin: "kernel".into(),
+    };
+    let encoded = recall_wire::encode_reply(&fetched).expect("1MiB byte-string fetch fits");
+    assert!(encoded.len() < maos_frame_codec::MAX_FRAME_BYTES);
+    let Reply::Fetched { payload, .. } = recall_wire::decode_reply(&encoded).unwrap() else {
+        panic!("fetched reply must round-trip");
+    };
+    assert_eq!(payload.0, vec![0xff; 1024 * 1024]);
+    #[derive(serde::Serialize)]
+    struct PlainVec { payload: Vec<u8> }
+    let plain = PlainVec { payload: vec![0xff; 1024 * 1024] };
+    let error = codec::encode_cbor(&plain).expect_err("plain Vec expands beyond CBOR node budget");
+    assert!(error.contains("budget"), "expected expansion-budget failure: {error}");
+    println!("reply_budget: fetched_bytes={}; plain_vec_error={error}", encoded.len());
+
+    let entries: Vec<Entry> = (1..=1024).map(entry).collect();
+    let reply = recall_wire::fit_page(entries.clone(), None).expect("realistic1024 fit_page");
+    let bytes = recall_wire::encode_reply(&reply).expect("fitted page encodes");
+    let Reply::Page { entries: included, next_cursor } = &reply else {
+        panic!("fit_page must return a page");
+    };
+    assert!(!included.is_empty());
+    assert!(included.len() <= entries.len());
+    for (actual, expected) in included.iter().zip(&entries) {
+        assert_eq!(actual.frame_id.0, expected.frame_id.0);
+        assert_eq!(actual.timestamp_ns, expected.timestamp_ns);
+        assert_eq!(actual.kind, expected.kind);
+        assert_eq!(actual.intent, expected.intent);
+        assert_eq!(actual.payload_available, expected.payload_available);
+    }
+    if included.len() < entries.len() {
+        let last = included.last().unwrap();
+        let cursor = next_cursor.as_ref().expect("trimmed page has continuation");
+        assert_eq!(cursor.last_timestamp_ns, last.timestamp_ns);
+        assert_eq!(cursor.last_frame_id.0, last.frame_id.0);
+        // The first larger prefix must fail WITH its own necessary cursor overhead.
+        let larger = entries[..included.len() + 1].to_vec();
+        let last = larger.last().unwrap();
+        let continuation = (larger.len() < entries.len()).then(|| Cursor {
+            last_timestamp_ns: last.timestamp_ns,
+            last_frame_id: Bytes(last.frame_id.0.clone()),
+        });
+        assert!(recall_wire::encode_reply(&Reply::Page {
+            entries: larger, next_cursor: continuation,
+        }).is_err(), "fit_page must choose the maximal encodable prefix");
+    } else {
+        assert!(next_cursor.is_none());
+    }
+    println!("realistic1024: entries={}; bytes={}; trimmed={}",
+        included.len(), bytes.len(), included.len() < entries.len());
+
+    // Exercise trimming as well as the ordinary realistic page that may fit.
+    let mut oversized = entries.clone();
+    for entry in &mut oversized { entry.intent = "x".repeat(8192); }
+    let fitted = recall_wire::fit_page(oversized.clone(), None).expect("trim oversized page");
+    let fitted_bytes = recall_wire::encode_reply(&fitted).unwrap();
+    let Reply::Page { entries: prefix, next_cursor } = fitted else { unreachable!() };
+    assert!(!prefix.is_empty() && prefix.len() < oversized.len());
+    let last = prefix.last().unwrap();
+    let cursor = next_cursor.expect("trimmed continuation");
+    assert_eq!(cursor.last_frame_id.0, last.frame_id.0);
+    assert_eq!(cursor.last_timestamp_ns, last.timestamp_ns);
+    let larger = oversized[..prefix.len() + 1].to_vec();
+    let last = larger.last().unwrap();
+    let continuation = Some(Cursor {
+        last_timestamp_ns: last.timestamp_ns,
+        last_frame_id: last.frame_id.clone(),
+    });
+    assert!(recall_wire::encode_reply(&Reply::Page {
+        entries: larger, next_cursor: continuation,
+    }).is_err());
+    println!("oversized1024: entries={}; bytes={}; trimmed=true",
+        prefix.len(), fitted_bytes.len());
+}
