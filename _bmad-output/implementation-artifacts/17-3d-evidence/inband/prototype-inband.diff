new file mode 100644
index 0000000..36b5d4c
--- /dev/null
+++ b/crates/maos-wasm-host/src/recall_wire.rs
@@ -0,0 +1,127 @@
+//! Private in-band recall records. Each ADR-032 body is exactly one tagged item.
+use ciborium::tag::Required;
+use serde::{Deserialize, Serialize};
+
+/// Prototype request tag in RFC 8949's first-come-first-served range.
+/// Private to this transport; not a registered public interchange tag.
+const REQUEST_TAG: u64 = 60000;
+/// Prototype reply tag, distinct from requests and ordinary untagged IacFrames.
+const REPLY_TAG: u64 = 60001;
+
+/// CBOR byte string, not a node-per-byte serde sequence.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Bytes(pub Vec<u8>);
+impl Serialize for Bytes {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        serializer.serialize_bytes(&self.0)
+    }
+}
+impl<'de> Deserialize<'de> for Bytes {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct Visitor;
+        impl<'de> serde::de::Visitor<'de> for Visitor {
+            type Value = Bytes;
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                f.write_str("a CBOR byte string")
+            }
+            fn visit_bytes<E: serde::de::Error>(self, bytes: &[u8]) -> Result<Bytes, E> {
+                Ok(Bytes(bytes.to_vec()))
+            }
+            fn visit_byte_buf<E: serde::de::Error>(self, bytes: Vec<u8>) -> Result<Bytes, E> {
+                Ok(Bytes(bytes))
+            }
+        }
+        deserializer.deserialize_byte_buf(Visitor)
+    }
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Cursor {
+    pub last_timestamp_ns: u64,
+    pub last_frame_id: Bytes,
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Filter {
+    pub kind: Option<String>,
+    pub since_ns: Option<u64>,
+    pub until_ns: Option<u64>,
+    pub limit: u32,
+    pub cursor: Option<Cursor>,
+    pub intent_filter: Option<String>,
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Entry {
+    pub frame_id: Bytes,
+    pub timestamp_ns: u64,
+    pub kind: String,
+    pub intent: String,
+    pub payload_available: bool,
+}
+#[derive(Debug, Serialize, Deserialize)]
+pub enum Request {
+    Recall { filter: Filter },
+    Fetch { frame_id: Bytes },
+}
+#[derive(Debug, Serialize, Deserialize)]
+pub enum Reply {
+    Page { entries: Vec<Entry>, next_cursor: Option<Cursor> },
+    Fetched {
+        frame_id: Bytes,
+        timestamp_ns: u64,
+        kind: String,
+        intent: String,
+        payload: Bytes,
+        origin: String,
+    },
+    Error { code: String, detail: Option<String> },
+}
+
+pub fn is_tagged(body: &[u8]) -> bool {
+    body.first().is_some_and(|byte| byte >> 5 == 6)
+}
+pub fn encode_request(request: &Request) -> Result<Vec<u8>, String> {
+    crate::codec::encode_cbor(&Required::<_, REQUEST_TAG>(request))
+}
+pub fn decode_request(body: &[u8]) -> Result<Request, String> {
+    crate::codec::decode_cbor::<Required<Request, REQUEST_TAG>>(body).map(|value| value.0)
+}
+pub fn encode_reply(reply: &Reply) -> Result<Vec<u8>, String> {
+    crate::codec::encode_cbor(&Required::<_, REPLY_TAG>(reply))
+}
+pub fn decode_reply(body: &[u8]) -> Result<Reply, String> {
+    crate::codec::decode_cbor::<Required<Reply, REPLY_TAG>>(body).map(|value| value.0)
+}
+
+/// Preserve the longest encodable prefix under BOTH codec budgets. A truncated
+/// page resumes after its final included entry, never after omitted metadata.
+/// If even one entry cannot fit, refuse rather than return a non-progress cursor.
+pub fn fit_page(mut entries: Vec<Entry>, next_cursor: Option<Cursor>) -> Result<Reply, String> {
+    let original_len = entries.len();
+    let cursor_for = |slice: &[Entry]| {
+        slice.last().map(|entry| Cursor {
+            last_timestamp_ns: entry.timestamp_ns,
+            last_frame_id: entry.frame_id.clone(),
+        })
+    };
+    // Encoding borrows the entries: unsuccessful candidates do not copy payloads.
+    #[derive(Serialize)]
+    enum PageRef<'a> {
+        Page { entries: &'a [Entry], next_cursor: &'a Option<Cursor> },
+    }
+    let fits = |count: usize| {
+        let cursor = if count == original_len { next_cursor.clone() } else { cursor_for(&entries[..count]) };
+        crate::codec::encode_cbor(&Required::<_, REPLY_TAG>(PageRef::Page {
+            entries: &entries[..count], next_cursor: &cursor,
+        })).is_ok()
+    };
+    if fits(original_len) {
+        return Ok(Reply::Page { entries, next_cursor });
+    }
+    // Search from the end: cursor byte lengths are not necessarily monotonic,
+    // so binary-searching arbitrary wire metadata could miss a longer prefix.
+    let count = (1..original_len).rev().find(|count| fits(*count))
+        .ok_or_else(|| "recall page entry exceeds reply budget".to_string())?;
+    let next_cursor = cursor_for(&entries[..count]);
+    entries.truncate(count);
+    Ok(Reply::Page { entries, next_cursor })
+}
