package maos:spirit@2.0.0 {
  interface frames {
    record frame-address {
      spirit-id: string,
      host-id: option<string>,
      role: option<string>,
    }

    enum frame-kind {
      task-assign,
      task-complete,
      decision-dispatch,
      epistemic-halt,
      telemetry-event,
      consent-request,
      retract,
      capability-invocation,
      sandbox-block,
      inference-call,
      budget-warning,
      budget-exceeded,
      cli-subprocess-output,
      consent-rupture,
      rate-limited,
      gateway-inbound,
      gateway-outbound,
    }

    enum intent-class {
      high-privilege,
      standard,
      readonly,
    }

    record scope-mcp-call {
      server: string,
      tool: string,
    }

    record scope-cli-subprocess-spawn {
      cli-binary-path: string,
      argv-prefix-hash: list<u8>,
      output-shape-version: string,
    }

    record scope-gateway-send {
      gateway-id: string,
      recipient: string,
    }

    variant scope {
      fs-read(string),
      fs-write(string),
      net-https(string),
      proc-exec(string),
      sub-spirit-spawn(string),
      provider-infer(string),
      iac-send(string),
      mem-read(string),
      mem-write(string),
      self-telemetry-read,
      log-recall,
      log-fetch,
      distillate-write,
      mcp-call(scope-mcp-call),
      cli-subprocess-spawn(scope-cli-subprocess-spawn),
      gateway-send(scope-gateway-send),
      skill-author-self,
      loom-read,
      loom-write,
      loom-scan,
    }

    enum posture-hint {
      autonomous-with-halt,
      assistive,
      cautious,
    }

    record halt-policy-override {
      tag: string,
      recall-vs-precision: f32,
    }

    record posture-preferences {
      preferred-posture: option<posture-hint>,
      halt-policy-overrides: list<halt-policy-override>,
    }

    record prior-distillate-ref {
      digest-frame-id: list<u8>,
      distillation-depth: u32,
      intent-lineage: list<string>,
    }

    record task-assign-body {
      goal: string,
      scope: list<scope>,
      success-criteria: string,
      posture-preferences: posture-preferences,
      prior-distillate-ref: option<prior-distillate-ref>,
    }

    record task-complete-body {
      result-text: string,
    }

    record decision-dispatch-body {
      decision-id: u64,
      approved: bool,
      working-memory-digest-refs: list<string>,
    }

    record epistemic-halt-body {
      halt-id: string,
      tag: string,
      value: f32,
      threshold: option<f32>,
      policy-id: string,
      derived-from: string,
    }

    record telemetry-event-body {
      event-type: string,
      data: string,
    }

    record consent-request-body {
      capability: string,
    }

    record retract-body {
      original-frame-id: list<u8>,
      reason: string,
      original-kind: option<frame-kind>,
    }

    record budget-envelope {
      spirit-pid: u32,
      hook-name: string,
      wall-ns: u64,
      cap-seconds: u64,
    }

    enum rupture-reason {
      intent-allowlist-mismatch,
      posture-shifted-during-transmission,
      token-revoked,
      principal-revoked,
      recipient-unloaded,
    }

    record rupture-rejection {
      address: frame-address,
      reason: rupture-reason,
    }

    record consent-rupture-body {
      rupture-id: list<u8>,
      original-frame-id: list<u8>,
      original-kind: frame-kind,
      accepted: list<frame-address>,
      rejected: list<rupture-rejection>,
      ruptured-at-ns: u64,
    }

    record rate-limited-body {
      provider-id: string,
      credential-fingerprint-prefix-hex: string,
      retry-after-ms: u64,
      bucket-remaining: u32,
      bucket-capacity: u32,
      refill-per-sec: u32,
      schedule-id: option<string>,
    }

    variant frame-payload {
      task-assign(task-assign-body),
      task-complete(task-complete-body),
      decision-dispatch(decision-dispatch-body),
      epistemic-halt(epistemic-halt-body),
      telemetry-event(telemetry-event-body),
      consent-request(consent-request-body),
      retract(retract-body),
      budget-warning(budget-envelope),
      budget-exceeded(budget-envelope),
      consent-rupture(consent-rupture-body),
      rate-limited(rate-limited-body),
    }

    enum frame-origin {
      human-authored,
      spirit-auto,
      spirit-drafted-human-approved,
      kernel,
    }

    record consent-envelope {
      consent-id: list<u8>,
      granter: frame-address,
      timestamp-ns: u64,
      intent-class: option<string>,
      valid-until-ns: option<u64>,
    }

    record iac-frame {
      frame-id: list<u8>,
      timestamp-ns: u64,
      logical-clock: u64,
      frame-from: frame-address,
      to: list<frame-address>,
      kind: frame-kind,
      intent: intent-class,
      payload: frame-payload,
      auto-marker: frame-origin,
      consent-envelope: option<consent-envelope>,
      intent-lineage: list<string>,
    }

    variant halt {
      voluntary,
      fault(string),
    }
  }
}


package wasi:io@0.2.12 {
  interface poll {
    resource pollable {
      block: func();
    }

    poll: func(in: list<borrow<pollable>>) -> list<u32>;
  }
  interface error {
    resource error;
  }
  interface streams {
    use error.{error};
    use poll.{pollable};

    resource input-stream {
      read: func(len: u64) -> result<list<u8>, stream-error>;
      blocking-read: func(len: u64) -> result<list<u8>, stream-error>;
      subscribe: func() -> pollable;
    }

    resource output-stream {
      check-write: func() -> result<u64, stream-error>;
      write: func(contents: list<u8>) -> result<_, stream-error>;
      blocking-write-and-flush: func(contents: list<u8>) -> result<_, stream-error>;
      blocking-flush: func() -> result<_, stream-error>;
      subscribe: func() -> pollable;
    }

    variant stream-error {
      last-operation-failed(error),
      closed,
    }
  }
}


package wasi:clocks@0.2.12 {
  interface monotonic-clock {
    use wasi:io/poll@0.2.12.{pollable};

    type instant = u64;

    type duration = u64;

    now: func() -> instant;

