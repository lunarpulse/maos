    }

    variant scope {
      fs-read(string),
      fs-write(string),
      net-https(string),
      proc-exec(string),
      sub-spirit-spawn(string),
      provider-infer(string),
      iac-send(string),
      mem-read(string),
      mem-write(string),
      self-telemetry-read,
      log-recall,
      log-fetch,
      distillate-write,
      mcp-call(scope-mcp-call),
      cli-subprocess-spawn(scope-cli-subprocess-spawn),
