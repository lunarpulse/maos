+/// ADR-020 / FR11 — the predecessor is the most recently archived record of
+/// this id at another version; cross-major is hot-swap step 7's rule.
+fn refuse_without_migrator(root: &Path, gated: &GatedManifest) -> Result<(), AdmissionRefusal> {
+    let Ok(entries) = std::fs::read_dir(root.join(&gated.spirit_id)) else {
+        return Ok(());
+    };
+    let latest = entries
+        .flatten()
+        .filter(|entry| entry.file_name().to_string_lossy() != gated.class_section.version)
+        .filter_map(|entry| Some((entry.metadata().ok()?.modified().ok()?, entry)))
+        .max_by_key(|(modified, _)| *modified);
+    let Some((_, entry)) = latest else {
+        return Ok(());
+    };
+    let archived_version = entry.file_name().to_string_lossy().into_owned();
+    let archived =
+        std::fs::read_to_string(entry.path().join("manifest.toml")).map_err(|error| {
+            AdmissionRefusal::ManifestUnreadable {
+                detail: format!("archived predecessor {archived_version}: {error}"),
+            }
+        })?;
+    let schema = |hot_swap: Option<&toml::Value>| {
+        hot_swap
+            .and_then(|h| h.get("state_schema_version")?.as_integer())
+            .map_or(1, |v| v as u32)
+    };
+    let archived_root: toml::Value =
+        toml::from_str(&archived).map_err(|error| AdmissionRefusal::ManifestParse {
+            detail: format!("archived predecessor {archived_version}: {error}"),
+        })?;
+    let predecessor = schema(archived_root.get("hot_swap"));
+    let successor = gated
+        .hot_swap
+        .as_ref()
+        .map_or(1, |h| h.state_schema_version);
+    let cross = maos_kernel_core::hot_swap::state_codec::detect_compat(predecessor, successor)
+        == maos_kernel_core::hot_swap::SchemaCompat::CrossMajor;
+    let declared = gated.migrates_from.as_ref().is_some_and(|m| {
+        m.versions
+            .iter()
+            .any(|p| maos_kernel_core::hot_swap::matches_version_pattern(p, &archived_version))
+    });
+    if cross && !declared {
+        return Err(AdmissionRefusal::MigratorMissing {
+            archived_version,
+            successor_version: gated.class_section.version.clone(),
+        });
+    }
+    Ok(())
+}
+
+/// ADR-020 / FR11 — record the admitted version once (write-if-absent); the
+/// snapshot is empty: state lives in the Spirit's own stores, not here.
+fn archive_admitted(root: &Path, gated: &GatedManifest) {
+    let archive = maos_kernel_core::hot_swap::SpiritArchive::new(root.to_path_buf());
+    let version = &gated.class_section.version;
+    if !archive.exists(&gated.spirit_id, version) {
+        if let Err(error) = archive.write(&gated.spirit_id, version, &gated.manifest_toml, &[]) {
+            eprintln!(
+                "maos: WARNING — archive record for {} v{version}: {error}",
+                gated.spirit_id
+            );
+        }
+    }
+}
