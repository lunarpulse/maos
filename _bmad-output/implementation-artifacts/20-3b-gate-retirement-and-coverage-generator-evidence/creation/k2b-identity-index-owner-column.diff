+    /// Bind `spirit_pid` to a stable storage identity before its first write.
+    pub fn bind_storage_identity(
+        &self,
+        spirit_pid: u32,
+        identity: &str,
+    ) -> Result<(), MemoryError> {
+        Self::sanitize_key(identity)?;
+        self.owners
+            .write()
+            .expect("PrivateMemoryStore owners lock poisoned")
+            .insert(spirit_pid, identity.to_string());
+        Ok(())
+    }
+
+    pub(in crate::memory) fn owner_dirname(&self, spirit_pid: u32) -> String {
+        match self
+            .owners
+            .read()
+            .expect("PrivateMemoryStore owners lock poisoned")
+            .get(&spirit_pid)
+        {
+            Some(identity) => format!("id-{}", hex::encode(identity.as_bytes())),
+            None => spirit_pid.to_string(),
+        }
+    }
