+// ─────────────────────────────────────────────────────────────────────────
+// FR41 — Spirit name resolver (TL-scan)
+// ─────────────────────────────────────────────────────────────────────────
+
+/// Resolve a Spirit name to one or more `(boot_nonce, spirit_pid)` pairs by
+/// scanning the Transparency Log for `lifecycle.admit` / `lifecycle.load`
+/// intents with `{"spirit_id": "<name>"}` in `payload_redacted`.
+///
+/// Per Decision E: keyed on `(boot_nonce, spirit_pid)` to discriminate pid
+/// reuse across boots. Defaults to the LATEST boot (max `boot_nonce`).
+/// Set `all_boots = true` to union all incarnations.
+///
+/// Returns `Err` if no matching frames exist (unknown spirit name).
+pub fn resolve_spirit_name(
+    db_path: &Path,
+    name: &str,
+    all_boots: bool,
+) -> Result<Vec<(u64, u32)>, String> {
+    let conn = rusqlite::Connection::open_with_flags(
+        db_path,
+        OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_NO_MUTEX,
+    )
+    .map_err(|e| format!("failed to open TL: {e}"))?;
+
+    let sql = "SELECT boot_nonce, spirit_pid, payload_redacted
+               FROM transparency_log
+               WHERE intent IN ('lifecycle.admit', 'lifecycle.load')
+               ORDER BY timestamp_ns ASC";
+    let mut stmt = conn.prepare(sql).map_err(|e| format!("prepare failed: {e}"))?;
+    let rows = stmt
+        .query_map([], |row| {
+            let boot: i64 = row.get(0)?;
+            let pid: i64 = row.get(1)?;
+            let payload: Vec<u8> = row.get(2)?;
+            Ok((boot as u64, pid as u32, payload))
+        })
+        .map_err(|e| format!("query failed: {e}"))?;
+
+    let mut matches: Vec<(u64, u32)> = Vec::new();
+    for row in rows {
+        let (boot, pid, payload) = row.map_err(|e| format!("row error: {e}"))?;
+        // Parse payload_redacted JSON to extract spirit_id
+        if let Ok(val) = serde_json::from_slice::<serde_json::Value>(&payload) {
+            if val.get("spirit_id").and_then(|v| v.as_str()) == Some(name) {
+                matches.push((boot, pid));
+            }
+        }
+    }
+
+    if matches.is_empty() {
+        return Err(format!(
+            "unknown spirit '{name}' — no lifecycle.admit/lifecycle.load frame found in Transparency Log"
+        ));
+    }
+
+    if all_boots {
+        // Deduplicate by (boot_nonce, spirit_pid)
+        matches.sort();
+        matches.dedup();
+        Ok(matches)
+    } else {
+        // Default: latest boot (max boot_nonce)
+        let max_boot = matches.iter().map(|(b, _)| *b).max().unwrap();
+        let latest: Vec<(u64, u32)> = matches
+            .into_iter()
+            .filter(|(b, _)| *b == max_boot)
+            .collect();
+        Ok(latest)
+    }
+}
