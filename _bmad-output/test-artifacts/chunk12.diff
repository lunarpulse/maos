+/// Derive the Ed25519 public key from a seed.
+pub fn derive_pubkey(seed: &[u8; 32]) -> [u8; 32] {
+    let signing_key = SigningKey::from_bytes(seed);
+    signing_key.verifying_key().to_bytes()
+}
