+/// FR44 — generate an Ed25519 audit signing key.
+fn audit_keygen(output: &Option<PathBuf>) -> ExitCode {
+    match maos_domain::audit_key::generate_audit_key(output) {
+        Ok(fingerprint) => {
+            let path = output
