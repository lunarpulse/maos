+// ─────────────────────────────────────────────────────────────────────────
+// FR43 — Posture-delta classifier
+// ─────────────────────────────────────────────────────────────────────────
+
+/// Classification of a posture change event.
+///
+/// v0.5 limitation: consent dimension is rupture-only; allowlist config
+/// changes are not tracked until a future release.
+#[derive(Debug, Clone, serde::Serialize)]
+#[serde(tag = "change_class")]
+pub enum PostureChange {
+    CapabilityChange {
+        frame_kind: String,
+        intent: String,
+        capability_detail: Option<String>,
+    },
+    SandboxTierChange {
+        from_tier: Option<u8>,
+        to_tier: Option<u8>,
+        event: String,
+    },
+    ConsentRupture {
+        intent: String,
+    },
+}
+
+/// Attribution of an approval decision to a posture change event.
+#[derive(Debug, Clone, serde::Serialize)]
+pub struct ApprovalAttribution {
+    pub actor: String,
+    pub decision: bool,
+    pub reasoning: Option<String>,
+}
+
+/// A single posture-delta event with optional approval attribution.
+#[derive(Debug, Clone, serde::Serialize)]
+pub struct PostureDeltaEntry {
+    pub timestamp_ns: u64,
+    pub spirit_id: Option<String>,
+    pub change: PostureChange,
+    pub approval: Option<ApprovalAttribution>,
+}
+
+/// Summary counts for the posture-delta window.
+#[derive(Debug, Clone, serde::Serialize)]
+pub struct PostureSummary {
+    pub window_since_ns: u64,
+    pub window_until_ns: u64,
+    pub total_changes: usize,
+    pub capability_changes: usize,
+    pub sandbox_tier_changes: usize,
+    pub consent_ruptures: usize,
+}
+
+/// The full posture-delta report: summary header + event list.
+#[derive(Debug, Clone, serde::Serialize)]
+pub struct PostureDeltaReport {
+    pub summary: PostureSummary,
+    pub events: Vec<PostureDeltaEntry>,
+}
+
+/// Classify composed log entries into posture-change events within the
+/// given time range. Joins with Approval entries by proximity (same
+/// timestamp range) for approval attribution.
+///
+/// Classification rules:
+/// - `Frame` with `frame_kind` `capability.invocation` or `spirit.revoked`
+///   → `CapabilityChange`
+/// - `Lifecycle` with a `sandbox_tier` change → `SandboxTierChange`
+/// - `Frame` with `frame_kind` `consent.rupture` → `ConsentRupture`
+///
+/// v0.5 consent-dimension limitation: rupture-only, no allowlist config changes.
+pub fn posture_delta(
+    audit_db: &Path,
+    journal_path: &Path,
+    range: LogRange,
+    spirit_filter: Option<&str>,
+) -> Result<PostureDeltaReport, AuditError> {
+    let entries = ranged_recall(audit_db, journal_path, range, spirit_filter)?;
+
+    // Collect approval events for proximity-based attribution
+    let approvals: Vec<(u64, Option<String>, ApprovalAttribution)> = entries
+        .iter()
+        .filter_map(|e| match &e.payload {
+            ComposedPayload::Approval {
+                actor,
+                intent: _,
+                decision,
+                reasoning,
+                ..
+            } => Some((
+                e.timestamp_ns,
+                e.spirit_id.clone(),
+                ApprovalAttribution {
+                    actor: actor.clone(),
+                    decision: *decision,
+                    reasoning: reasoning.clone(),
+                },
+            )),
+            _ => None,
+        })
+        .collect();
+
+    let mut events: Vec<PostureDeltaEntry> = Vec::new();
+    let mut prev_tier: Option<u8> = None;
+    let mut cap_changes: usize = 0;
+    let mut tier_changes: usize = 0;
+    let mut ruptures: usize = 0;
+
+    for entry in &entries {
+        match &entry.payload {
+            ComposedPayload::Frame {
+                frame_kind,
+                intent,
+                payload_redacted: _,
+            } => {
+                if frame_kind == "capability.invocation" || frame_kind == "spirit.revoked" {
+                    // Find a nearby approval (within same timestamp, same spirit)
+                    let approval = find_nearby_approval(
+                        &approvals,
+                        entry.timestamp_ns,
+                        entry.spirit_id.as_deref(),
+                    );
+                    events.push(PostureDeltaEntry {
+                        timestamp_ns: entry.timestamp_ns,
+                        spirit_id: entry.spirit_id.clone(),
+                        change: PostureChange::CapabilityChange {
+                            frame_kind: frame_kind.clone(),
+                            intent: intent.clone(),
+                            capability_detail: None,
+                        },
+                        approval,
+                    });
+                    cap_changes += 1;
+                } else if frame_kind == "consent.rupture" {
+                    let approval = find_nearby_approval(
+                        &approvals,
+                        entry.timestamp_ns,
+                        entry.spirit_id.as_deref(),
+                    );
+                    events.push(PostureDeltaEntry {
+                        timestamp_ns: entry.timestamp_ns,
+                        spirit_id: entry.spirit_id.clone(),
+                        change: PostureChange::ConsentRupture {
+                            intent: intent.clone(),
+                        },
+                        approval,
+                    });
+                    ruptures += 1;
+                }
+            }
+            ComposedPayload::Lifecycle {
+                event: _,
+                sandbox_tier,
+            } => {
+                if let Some(current_tier) = sandbox_tier {
+                    if prev_tier != Some(*current_tier) {
+                        let approval = find_nearby_approval(
+                            &approvals,
+                            entry.timestamp_ns,
+                            entry.spirit_id.as_deref(),
+                        );
+                        events.push(PostureDeltaEntry {
+                            timestamp_ns: entry.timestamp_ns,
+                            spirit_id: entry.spirit_id.clone(),
+                            change: PostureChange::SandboxTierChange {
+                                from_tier: prev_tier,
+                                to_tier: Some(*current_tier),
+                                event: "sandbox_tier_change".to_string(),
+                            },
+                            approval,
+                        });
+                        tier_changes += 1;
+                        prev_tier = Some(*current_tier);
+                    }
+                }
+            }
+            ComposedPayload::Approval { .. } => {
+                // Approval events are used for attribution, not classified as posture changes
+            }
+        }
+    }
+
+    let total = events.len();
+    Ok(PostureDeltaReport {
+        summary: PostureSummary {
+            window_since_ns: range.since_ns,
+            window_until_ns: range.until_ns,
+            total_changes: total,
+            capability_changes: cap_changes,
+            sandbox_tier_changes: tier_changes,
+            consent_ruptures: ruptures,
+        },
+        events,
+    })
+}
+
+/// Find the nearest approval entry for a given timestamp and optional spirit.
+/// Proximity = exact timestamp match or closest within a small delta.
+fn find_nearby_approval(
+    approvals: &[(u64, Option<String>, ApprovalAttribution)],
+    ts: u64,
+    spirit_id: Option<&str>,
+) -> Option<ApprovalAttribution> {
+    // Exact match first, then closest within 1ms (1_000_000 ns)
+    let delta_ns = 1_000_000u64;
+    approvals
+        .iter()
+        .filter(|(_, sid, _)| spirit_id.is_none() || sid.as_deref() == spirit_id)
+        .filter(|(a_ts, _, _)| *a_ts >= ts.saturating_sub(delta_ns) && *a_ts <= ts.saturating_add(delta_ns))
+        .min_by_key(|(a_ts, _, _)| {
+            if *a_ts >= ts {
+                *a_ts - ts
+            } else {
+                ts - *a_ts
+            }
+        })
+        .map(|(_, _, attr)| attr.clone())
+}
