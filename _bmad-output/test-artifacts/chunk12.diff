+/// Hex-decode a hex string to a byte vector. Returns an error string if the
+/// input contains non-hex characters or has odd length.
+fn hex_decode(hex: &str) -> Result<Vec<u8>, Box<dyn std::error::Error + Send + Sync>> {
+    if hex.len() % 2 != 0 {
+        return Err(format!("hex string has odd length ({})", hex.len()).into());
+    }
+    let mut bytes = Vec::with_capacity(hex.len() / 2);
+    for chunk in hex.as_bytes().chunks(2) {
+        let hi = (chunk[0] as char).to_digit(16)
+            .ok_or_else(|| format!("invalid hex char '{}'", chunk[0] as char))?;
+        let lo = (chunk[1] as char).to_digit(16)
+            .ok_or_else(|| format!("invalid hex char '{}'", chunk[1] as char))?;
+        bytes.push((hi << 4 | lo) as u8);
+    }
+    Ok(bytes)
+}
